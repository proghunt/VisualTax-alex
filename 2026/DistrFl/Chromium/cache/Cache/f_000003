            }
            var floor_transform = new PerspectiveTransform(floor_div, width, 100, true);
            floor_transform.topLeft.x = left_width;
            floor_transform.topLeft.y = 0;
            floor_transform.topRight.x = width - right_width;
            floor_transform.topRight.y = 0;
            
            floor_transform.bottomLeft.x = 0;
            floor_transform.bottomLeft.y = 100;
            floor_transform.bottomRight.x = width;
            floor_transform.bottomRight.y = 100;
            
            floor_transform.update();     
            floor_div.style.visibility = 'visible';
        }
        
        var ceiling_div = document.getElementById('ceiling_div');
        var width = total_width;
        if (ceiling_div) {
            ceiling_div.style.top = "0px";            
            ceiling_div.style.width = width + "px";
            var ceiling_transform = new PerspectiveTransform(ceiling_div, width, 100, true);
            ceiling_transform.topLeft.x = 0;
            ceiling_transform.topLeft.y = 0;
            ceiling_transform.topRight.x = width;
            ceiling_transform.topRight.y = 0;
            
            ceiling_transform.bottomLeft.x = left_width;
            ceiling_transform.bottomLeft.y = 100;
            ceiling_transform.bottomRight.x = width - right_width;
            ceiling_transform.bottomRight.y = 100;
            
            ceiling_transform.update();     
            ceiling_div.style.visibility = 'visible';
        }
    }
};

