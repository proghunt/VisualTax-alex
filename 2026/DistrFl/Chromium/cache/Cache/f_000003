function perspective_transform() {
    var holderTable = document.getElementById('holder');
    if (holderTable) {
        //var height = getDocumentHeight();
        var height = total_height;        
        var left_width = left_column_width;
        var left_wall = document.getElementById('left_wall');
        if (left_wall) {
            left_wall.style.visibility = 'hidden';
            left_wall.style.height = height;
            left_wall.style.width = left_width;
            var left_transform = new PerspectiveTransform(left_wall, left_width, height, true);

            left_transform.topRight.x = left_width;
            left_transform.topRight.y = 100;
            left_transform.bottomRight.x = left_width;
            left_transform.bottomRight.y = height - 100;
            left_transform.update();   
            
            left_wall.style.visibility = 'visible';
        }
        
        var right_width = right_column_width;
        var right_wall = document.getElementById('right_wall');
        if (right_wall) {
            right_wall.style.height = height;
            right_wall.style.width = right_width;
            var right_transform = new PerspectiveTransform(right_wall, right_width, height, true);
            right_transform.topLeft.x = 0;
            right_transform.topLeft.y = 100;
            right_transform.bottomLeft.x = 0;
            right_transform.bottomLeft.y = height - 100;
            
            right_transform.topRight.x = right_width;
            right_transform.topRight.y = 0;
            right_transform.bottomRight.x = right_width;
            right_transform.bottomRight.y = height;
            
            right_transform.update();     
            right_wall.style.visibility = 'visible';
        }
        
        var floor_div = document.getElementById('floor_div');
        var monitor_stand_div = document.getElementById('monitor_stand_div');
