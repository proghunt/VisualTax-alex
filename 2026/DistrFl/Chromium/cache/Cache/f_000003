function draw_ceiling() {
    do_draw_ceiling = function (ctx) {
        const ceiling_height = 100;  
        const glass_height = 50;
        const glass_width_percent = 90;
        //const horz_margin = (total_width - total_width * glass_width_percent / 100) / 2;
        const horz_margin = 200;
        
        if (CEILING_MODE == 'P') {
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(0, ceiling_height);
            ctx.lineTo(total_width, ceiling_height);
            ctx.lineTo(total_width, 0);
            ctx.lineTo(total_width - horz_margin, 0);
            ctx.lineTo(total_width - horz_margin, ceiling_height - glass_height);
            ctx.lineTo(horz_margin, ceiling_height - glass_height);
            ctx.lineTo(horz_margin, 0);
            ctx.lineTo(0, 0);
            ctx.fill();
            ctx.stroke();
            ctx.closePath();
            
            ctx.beginPath();
            for (var i=0; i<=10; i++) {
                ctx.moveTo(((total_width - horz_margin * 2) / 10) * i + horz_margin, 0);
                ctx.lineTo(((total_width - horz_margin * 2) / 10) * i + horz_margin, glass_height);
            }
            ctx.stroke();
            ctx.closePath();
        } else if (CEILING_MODE == 'N') {
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(0, ceiling_height);
            ctx.lineTo(total_width, ceiling_height);
            ctx.lineTo(total_width, 0);
            ctx.lineTo(0, 0);
            ctx.fill();
            ctx.stroke();
            ctx.closePath();
        }
    }
    
    if (CEILING_MODE != 'N' && CEILING_MODE != 'P') {
        return;
    }
    var canvas = document.getElementById('ceiling_canvas');
    if (canvas) {
        canvas.width = 0;                
        canvas.width = total_width;                
        canvas.height = 100;
        if (canvas.getContext) {
            var ctx = canvas.getContext('2d');                           
            ctx.strokeStyle = BORDER_COLOR;
            if (CEILING_COLOR.startsWith('#')) {
                ctx.fillStyle = CEILING_COLOR;
                do_draw_ceiling(ctx);
            }
            else {
                var img = new Image();
                img.src = CEILING_COLOR;
                img.onload = function () {
                    var pat = ctx.createPattern(img,"repeat");
                    ctx.fillStyle = pat;
                    do_draw_ceiling(ctx);
                }
                
            }
        }
    }
};

  

function draw_left_wall() {
    do_draw_baseboard = function (canvas, cts) {        
        if (!LEFT_WALL_MODE.includes('B')) {
            return;
        }
        
        const wall_width = right_column_width;
        const board_height = 20;
        ctx.fillStyle = LEFT_BASEBOARD_COLOR;
        ctx.beginPath();
        ctx.moveTo(0, total_height - board_height);
        ctx.lineTo(0, total_height);
        ctx.lineTo(wall_width, total_height);
        ctx.lineTo(wall_width, total_height - board_height);
        ctx.lineTo(0, total_height - board_height);
        ctx.fill();
        ctx.stroke();
        ctx.closePath();
        ctx.beginPath();
        ctx.moveTo(0, total_height - 15);
        ctx.lineTo(wall_width, total_height - 15);
        ctx.fill();
        ctx.stroke();
        ctx.closePath();
    }
    do_draw_crown = function (canvas, cts) {        
        if (!LEFT_WALL_MODE.includes('C')) {
            return;
        }
        
        const wall_width = right_column_width;
        const board_height = 20;
        ctx.fillStyle = LEFT_CROWN_COLOR;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(0, board_height);
        ctx.lineTo(wall_width, board_height);
        ctx.lineTo(wall_width, 0);
        ctx.lineTo(0, 0);
        ctx.fill();
        ctx.stroke();
        ctx.closePath();
        
        ctx.beginPath();
        ctx.moveTo(0, 15);
        ctx.lineTo(wall_width, 15);
        ctx.stroke();
        ctx.closePath();
    }
    do_draw_left_wall = function (canvas, ctx) {
        const wall_width = left_column_width;
        const glass_height = 50;
        const glass_width_percent = 90;
        //const horz_margin = (total_width - total_width * glass_width_percent / 100) / 2;
        const left_horz_margin = 30;
        const right_horz_margin = 60;
        panel_visible = false;
        panel = document.getElementById('left_menu_panel');
        if (panel) {
            panel_visible = panel.style.visibility != 'hidden';
        }
        wall_top = 0;
        if (LEFT_WALL_MODE.includes('C')) {
            wall_top = 20;            
        } 
        wall_height = canvas.height;
        if (LEFT_WALL_MODE.includes('B')) {
            wall_height = wall_height - 20;            
        }    
        
        if (LEFT_WALL_MODE.includes('W') && panel_visible) {
            ctx.beginPath();
            ctx.moveTo(0, wall_top);
            ctx.lineTo(0, wall_height);
            ctx.lineTo(wall_width, wall_height);
            ctx.lineTo(wall_width, wall_top);
            ctx.lineTo(wall_width - right_horz_margin, wall_top);
            ctx.lineTo(wall_width - right_horz_margin, glass_height);
            ctx.lineTo(left_horz_margin, glass_height);
            ctx.lineTo(left_horz_margin, wall_top);
            ctx.lineTo(0, wall_top);
            ctx.fill();
            ctx.stroke();
            ctx.closePath();
            
            ctx.beginPath();
            for (var i=0; i<=3; i++) {
                ctx.moveTo(((wall_width - left_horz_margin - right_horz_margin) / 3) * i + left_horz_margin, wall_top);
                ctx.lineTo(((wall_width - left_horz_margin - right_horz_margin) / 3) * i + left_horz_margin, glass_height);
            }
            ctx.moveTo(left_horz_margin, wall_top);
            ctx.lineTo(wall_width - right_horz_margin, wall_top);
            ctx.stroke();
            ctx.closePath();
        } else {
            ctx.beginPath();
            ctx.moveTo(0, wall_top);
            ctx.lineTo(0, wall_height);
            ctx.lineTo(wall_width, wall_height);
            ctx.lineTo(wall_width, wall_top);
            ctx.lineTo(0, wall_top);
            ctx.fill();
            ctx.stroke();
            ctx.closePath();
        }
    }
    
    var canvas = document.getElementById('left_wall_canvas');
    if (canvas) {
        canvas.width = 0;                
        canvas.height = 0;
        canvas.width = left_column_width;                
        canvas.height = total_height;
        if (canvas.getContext) {
            var ctx = canvas.getContext('2d');                           
            ctx.strokeStyle = BORDER_COLOR;
            do_draw_crown(canvas, ctx);
            do_draw_baseboard(canvas, ctx);
            if (LEFT_PANEL_COLOR.startsWith('#')) {                
                ctx.fillStyle = LEFT_PANEL_COLOR;                
                do_draw_left_wall(canvas, ctx);
            }
            else {
                var img = new Image();
                img.src = LEFT_PANEL_COLOR;
                img.onload = function () {
                    var pat = ctx.createPattern(img,"repeat");
                    ctx.fillStyle = pat;
                    do_draw_left_wall(canvas, ctx);
                }
                
            }
        }
    }
}; 

