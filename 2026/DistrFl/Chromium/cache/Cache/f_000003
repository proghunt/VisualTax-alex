    jQuery("html *").each(function() {
      if (jQuery(this).outerHeight() > highestHeight) {    
        highest = jQuery(this);
        highestHeight = jQuery(this).outerHeight();
      }
    });
    jQuery("html *").each(function() {
      var $this = $(this);
      if (jQuery.contains(highest[0], $this[0]) && jQuery(this).outerHeight() >= highestHeight) {
        highest = $this;
        highestHeight = jQuery(this).outerHeight();
      }
    });
    //console.log(highestHeight);
    //console.log(highest[0]);
    return highestHeight;
};

