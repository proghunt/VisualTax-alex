<xsd:schema
    xmlns:cbchdr="http://www.cra-arc.gc.ca/xmlns/cbchdr/1-0-0"
    xmlns:hdr="http://www.cra-arc.gc.ca/xmlns/hdr/1-0-0"
    xmlns:cbc="http://www.cra-arc.gc.ca/xmlns/cbc/2019/1-0-0"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:iso="urn:oecd:ties:isocbctypes:v1"
    xmlns:ccms="http://www.cra-arc.gc.ca/xmlns/ccms/1-1-0"
    xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
    targetNamespace="http://www.cra-arc.gc.ca/xmlns/cbchdr/1-0-0"
    elementFormDefault="qualified" attributeFormDefault="unqualified" version="cbchdr/1-0-0">
    <xsd:import namespace="urn:oecd:ties:isocbctypes:v1" schemaLocation="isocbctypes_v1.1.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/ccms/1-1-0" schemaLocation="cracommonstructures.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/cbc/2019/1-0-0" schemaLocation="CountryByCountryReport2019.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/hdr/1-0-0" schemaLocation="CDCMessageHeader.xsd"/>

    <xsd:element name="CbcHeader" type="cbchdr:CbcHeaderType"/>
    <xsd:complexType name="CbcHeaderType">
        <xsd:sequence>
            <xsd:element ref="hdr:CDCMessageHeader"/>
            <xsd:element ref="cbc:CountryByCountryReport"/>
        </xsd:sequence>
    </xsd:complexType>

</xsd:schema>


