<?xml version="1.0" encoding="ISO-8859-1"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://www.cra-arc.gc.ca/xmlns/hdr/1-0-0"
        xmlns:hdr="http://www.cra-arc.gc.ca/xmlns/hdr/1-0-0"
        elementFormDefault="qualified">

    <element name="CDCMessageHeader" type="hdr:CDCMessageHeaderType"/>

    <complexType name="CDCMessageHeaderType">
        <sequence>
            <element name="FilingMethodCode">
                <annotation>
                    <documentation>The method through which the XML document was received. (eg. EFILE)</documentation>
                </annotation>
                <simpleType>
                    <restriction base="string">
                        <maxLength value="20"/>
                        <whiteSpace value="collapse"/>
                    </restriction>
                </simpleType>
            </element>
            <element name="FormTypeCode">
                <annotation>
                    <documentation>The type of form this XML document represents. (eg. RC312, T1135...)</documentation>
                </annotation>
                <simpleType>
                    <restriction base="string">
                        <maxLength value="255"/>
                        <whiteSpace value="collapse"/>
                    </restriction>
                </simpleType>
            </element>
            <element name="FormVersionNumber">
                <annotation>
                    <documentation>The vesrion of this specific form or schema. (eg. 2012, 2016 )</documentation>
                </annotation>
                <simpleType>
                    <restriction base="string">
                        <maxLength value="255"/>
                    </restriction>
                </simpleType>
            </element>
            <element name="ReceivedDatetime" type="dateTime">
                <annotation>
                    <documentation>The date and time the XML document was received.</documentation>
                </annotation>
            </element>
            <element name="ConfirmationNumber" maxOccurs="1" minOccurs="0">
                <annotation>
                    <documentation>Confirmation number sent to the sender to verify that the XML document was received.</documentation>
                </annotation>
                <simpleType>
                    <restriction base="string">
                        <maxLength value="100"/>
                        <whiteSpace value="collapse"/>
                    </restriction>
                </simpleType>
            </element>
            <element name="SoftwareVendorCode" maxOccurs="1" minOccurs="0">
                <annotation>
                    <documentation>The code idenifying the software vendor responsible for the software used to submitt this XML document.</documentation>
                </annotation>
                <simpleType>
                    <restriction base="string">
                        <maxLength value="100"/>
                        <whiteSpace value="collapse"/>
                    </restriction>
                </simpleType>
            </element>
        </sequence>
    </complexType>
</schema>