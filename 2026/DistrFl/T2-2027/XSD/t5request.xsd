<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
Description: CRA Frrms Web Services - T5 forms
Type (Request or Response): Request
Version: 1-0-0
Date created:
Contact:
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:t5rq="http://www.cra-arc.gc.ca/xmlns/t5rq/t5request/1-0-0"
    xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
    xmlns:t1135="http://www.cra-arc.gc.ca/xmlns/t1135/2021/1-0-0"
    xmlns:t1134="http://www.cra-arc.gc.ca/xmlns/t1134/2021/1-0-0"
    xmlns:t106="http://www.cra-arc.gc.ca/xmlns/t106/2025/1-0-0"
    xmlns:ef="http://www.cra-arc.gc.ca/xmlns/ef/2025/1-0-0"
    targetNamespace="http://www.cra-arc.gc.ca/xmlns/t5rq/t5request/1-0-0"
    elementFormDefault="qualified" attributeFormDefault="unqualified" version="t5rq/1-0-0">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/ef/2025/1-0-0" schemaLocation="efilecommon.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t1135/2021/1-0-0" schemaLocation="ForeignIncomeVerificationStatement.xsd"/>    
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t1134/2021/1-0-0" schemaLocation="ControlledAndNotControlledForeignAffiliateReturn2021.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t106/2025/1-0-0" schemaLocation="NonArmsLengthTransactionWithNonResidentInformationReturn.xsd"/>

     <xsd:element name="T5ReturnRequest" type="t5rq:t5ReturnRequestType"/>
    <xsd:complexType name="t5ReturnRequestType">
        <xsd:sequence>
            <xsd:element ref="t5rq:PartnershipNumber"/>
            <xsd:choice> 	
	            <xsd:element ref="t5rq:IndividualData"/>	
	            <xsd:element ref="t5rq:TaxProfessionalData"/>	
            </xsd:choice> 
            <xsd:element ref="t5rq:TaxYear"/>
            <xsd:element ref="t5rq:SoftwareID"/>
            <xsd:element ref="t5rq:SoftwareRevisionDate"/>
            <xsd:element ref="t5rq:TaxForm"/>
        </xsd:sequence>
    </xsd:complexType>
	
	<xsd:element name="PartnershipNumber" type="t5rq:PartnershipNumberType" />
    <xsd:simpleType name="PartnershipNumberType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="[0-9]{9}RZ[0-9]{4}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="TaxForm" type="t5rq:TaxFormType"/>
    <xsd:complexType name="TaxFormType">
        <xsd:choice> 
            <xsd:element ref="t1134:ControlledAndNotControlledForeignAffiliateReturn"/>
            <xsd:element ref="t106:NonArmsLengthTransactionWithNonResidentInformationReturn"/>            
            <xsd:element ref="t1135:ForeignIncomeVerificationStatement"/>
        </xsd:choice>
    </xsd:complexType>
	
	<xsd:element name="TaxProfessionalData" type="t5rq:TaxProfessionalDataType"/>
	<xsd:complexType name="TaxProfessionalDataType">
		<xsd:sequence>
			<xsd:element ref="ef:TransmitterEfilerNumber" />
            <xsd:element ref="ef:PasswordID"/>
			<xsd:element ref="ef:RepresentativeID" minOccurs="0"/>			
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:element name="IndividualData" type="t5rq:IndividualDataType"/>
	<xsd:complexType name="IndividualDataType">
		<xsd:sequence>
			<xsd:element ref="t5rq:AgreementIndicator" />
            <xsd:element ref="t5rq:PartnershipEffectiveDate"/>		
			<xsd:element ref="t5rq:PartnershipPostalCode" />
		</xsd:sequence>
	</xsd:complexType>

    <xsd:element name="TaxYear" type="sdt:YearType"/>
    <xsd:element name="AgreementIndicator"> 
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Values are 1 for "Yes", 2 for "No", and 0 for "Question not answered"</xsd:documentation>
            <xsd:documentation xml:lang="fr">Les valeurs sont 1 pour "Oui", 2 pour "Non", et 0 pour "questions non répondue"</xsd:documentation>
        </xsd:annotation>
		<xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:enumeration value="0"/>
                <xsd:enumeration value="1"/>
                <xsd:enumeration value="2"/>
            </xsd:restriction>
    	</xsd:simpleType>
	</xsd:element>
	
    <xsd:element name="PartnershipEffectiveDate" type="sdt:DateType"/> 
    
    <xsd:element name="PartnershipPostalCode" type="t5rq:CanadianPostalCodeType"/> 
    <xsd:simpleType name="CanadianPostalCodeType">
        <xsd:restriction base="sdt:CodeType">
            <xsd:length value="6"/>
            <xsd:pattern value="([A-Za-z][0-9]){3}"/>
        </xsd:restriction>
    </xsd:simpleType>
  
    <xsd:element name="SoftwareID">
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
                <xsd:length value="4"/>
                <xsd:pattern value="[A-Za-z]{1}[0-9]{3}"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>	 
    
    <xsd:element name="SoftwareRevisionDate" type="sdt:DateType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Format is YYYY-MM-DD</xsd:documentation>
            <xsd:documentation xml:lang="fr">Le format est AAAA-MM-JJ</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    
    <xsd:element name="TermsAndConditionsRequest" type="t5rq:TermsAndConditionsRequestType"/>
    <xsd:simpleType name="TermsAndConditionsRequestType">
        <xsd:restriction base="sdt:SimpleTextType"/>
    </xsd:simpleType>

</xsd:schema>
