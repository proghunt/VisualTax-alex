    <xsd:element name="NonResidentTrustInterestTotalIncomeReceivedAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentTrustInterestTotalCapitalReceivedAmount" type="t1135:HundredTrillionAmountType"/>
