<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
Description: Foreign Income Verification Statement (CRA Form T1135)
Contact: CRA, ITB, Solutions, IRBD, Assessment Processing Division, Electronic Filing
Date created: Sept. 2015
Updates:
Users of this schema: T1 Efile, T1 Netfile
-->   

<xsd:schema xmlns:t1135="http://www.cra-arc.gc.ca/xmlns/t1135/2021/1-0-0" 
            xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" 
            xmlns:ccms="http://www.cra-arc.gc.ca/xmlns/ccms/1-1-0" 
            xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
            targetNamespace="http://www.cra-arc.gc.ca/xmlns/t1135/2021/1-0-0" 
            elementFormDefault="qualified" attributeFormDefault="unqualified" version="t1135/2021/1-1-0">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/ccms/1-1-0" schemaLocation="cracommonstructures.xsd"/> 
    <xsd:annotation>
        <xsd:documentation xml:lang="en">Schema for T1135 Foreign Income Verification Statement</xsd:documentation>
        <xsd:documentation xml:lang="fr">Schéma pour T1135 Bilan de vérification du revenu étranger</xsd:documentation>
    </xsd:annotation>
    <xsd:element name="ForeignIncomeVerificationStatement" type="t1135:ForeignIncomeVerificationStatementType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">There can be only one T1135 return in a file</xsd:documentation>
            <xsd:documentation xml:lang="fr">Il ne peut y avoir qu’un formulaire T1135 dans un fichier</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="ForeignIncomeVerificationStatementType">
        <xsd:sequence>
            <xsd:element ref="t1135:SoftwareID" minOccurs="0"/>
            <xsd:element ref="t1135:SoftwareRevisionDate" minOccurs="0"/>

            <!-- IDENTIFICATION -->
            <xsd:element ref="t1135:FunctionalCurrencyCode" minOccurs="0"/>
            <xsd:element ref="t1135:AmendedReturnIndicator" minOccurs="0"/>
            <xsd:element ref="t1135:TaxpayerIdentification"/>
            <xsd:element ref="t1135:TaxpayerAddress" minOccurs="0"/>
            <xsd:element ref="t1135:TaxationYearData"/>

            <xsd:element ref="t1135:ForeignPropertyIdentification"/>

            <!-- CERTIFICATION -->
            <xsd:element ref="t1135:CertificationDetail" minOccurs="0"/>

        </xsd:sequence>
    </xsd:complexType>

    <!-- ******************************************************************************** -->
    <xsd:element name="ForeignPropertyIdentification" type="t1135:ForeignPropertyIdentificationType"/>

    <xsd:complexType name="ForeignPropertyIdentificationType">
        <xsd:choice>
            <xsd:element name="ForeignPropertyCostCategoryOne" type="t1135:ForeignPropertyCostCategoryOneType"/>
            <xsd:element name="ForeignPropertyCostCategoryTwo" type="t1135:ForeignPropertyCostCategoryTwoType"/>
        </xsd:choice>
    </xsd:complexType>

    <!-- CATEGORY ONE - 100,000-249,999 -->
    <xsd:complexType name="ForeignPropertyCostCategoryOneType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Total cost of all specified foreign property held at any time during the year exceeds $100,000 but was less than $250,000 - complete either Part A or Part B.</xsd:documentation>
            <xsd:documentation xml:lang="fr"></xsd:documentation>
        </xsd:annotation>
        <xsd:choice>
            <xsd:element name="ForeignPropertySimplifiedData" type="t1135:ForeignPropertySimplifiedDataType"/>
            <xsd:element name="ForeignPropertyDetailedData"   type="t1135:ForeignPropertyDetailedDataType"/>
        </xsd:choice>
    </xsd:complexType>

    <!-- CATEGORY TWO - 250,000 OR GREATER -->
    <xsd:complexType name="ForeignPropertyCostCategoryTwoType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Total cost of all specified foreign property held at any time during the year was $250,000 or more - complete Part B.</xsd:documentation>
            <xsd:documentation xml:lang="fr"></xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="ForeignPropertyDetailedData"   type="t1135:ForeignPropertyDetailedDataType"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- SIMPLIFIED SECTION - INDICATOR TO REPRESENT EACH TYPE OF PROPERTY -->
    <xsd:complexType name="ForeignPropertySimplifiedDataType">
        <xsd:sequence>
            <xsd:element ref="t1135:ForeignPropertyIndicator" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignPropertyCountryCodes" minOccurs="0"/>
            <xsd:element ref="t1135:AllForeignPropertyIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:AllForeignPropertyDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ForeignPropertyIndicator" type="t1135:ForeignPropertyIndicatorType"/>
    <xsd:complexType name="ForeignPropertyIndicatorType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Indicator for the type(s) of property that are applicable - Value "1" or "true" (Yes); Value "0" or "false" (No)</xsd:documentation>
            <xsd:documentation xml:lang="fr"></xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:ForeignFundsIndicator" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationShareIndicator" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtednessIndicator" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestIndicator" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealPropertyIndicator" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignPropertyIndicator" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyIndicator" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ForeignFundsIndicator">
        <xsd:simpleType><xsd:restriction base="sdt:IndicatorType"/></xsd:simpleType>
    </xsd:element>
    <xsd:element name="NonResidentCorporationShareIndicator">
        <xsd:simpleType><xsd:restriction base="sdt:IndicatorType"/></xsd:simpleType>
    </xsd:element>
    <xsd:element name="NonResidentIndebtednessIndicator">
        <xsd:simpleType><xsd:restriction base="sdt:IndicatorType"/></xsd:simpleType>
    </xsd:element>
    <xsd:element name="NonResidentTrustInterestIndicator">
        <xsd:simpleType><xsd:restriction base="sdt:IndicatorType"/></xsd:simpleType>
    </xsd:element>
    <xsd:element name="ForeignRealPropertyIndicator">
        <xsd:simpleType><xsd:restriction base="sdt:IndicatorType"/></xsd:simpleType>
    </xsd:element>
    <xsd:element name="OtherForeignPropertyIndicator">
        <xsd:simpleType><xsd:restriction base="sdt:IndicatorType"/></xsd:simpleType>
    </xsd:element>
    <xsd:element name="CanadianHeldForeignPropertyIndicator">
        <xsd:simpleType><xsd:restriction base="sdt:IndicatorType"/></xsd:simpleType>
    </xsd:element>


    <xsd:element name="ForeignPropertyCountryCodes" type="t1135:ForeignPropertyCountryCodesType"/>
    <xsd:complexType name="ForeignPropertyCountryCodesType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Top three countries based on the maximum cost amount of specified foreign property held during the year.</xsd:documentation>
            <xsd:documentation xml:lang="fr"></xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:MaximumCostForeignCountryCode" minOccurs="0" maxOccurs="3"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="MaximumCostForeignCountryCode" type="ccms:CountryCodeType"/>

    <xsd:element name="AllForeignPropertyIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="AllForeignPropertyDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>


    <!-- DETAILED SECTION - SEVEN TABLES -->
    <xsd:complexType name="ForeignPropertyDetailedDataType">
        <xsd:sequence>
            <!-- TABLES -->
            <xsd:element ref="t1135:ForeignFunds" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationShare" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtedness" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterest" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealProperty" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignProperty" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignProperty" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <!-- ******************************************************************************** -->

    <!-- IDENTIFICATION SECTION -->
    <xsd:element name="FunctionalCurrencyCode">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Acceptable currency codes include the following: USD-U.S. dollar; AUD-Australian dollar; GBP-U.K. dollar; EUR-the Euro; JPY-Japanese Yen; OR leave blank.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Codes des monnaies acceptables sont les suivants: USD-dollar américain; AUD-dollar australien; GBP-pour la livre sterling du Royaume-Uni; EUR-pour l'euro; JPY-Yen japonais OU laisser en blanc</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:length value="3"/>
                <xsd:enumeration value="USD"/>
                <xsd:enumeration value="usd"/>
                <xsd:enumeration value="AUD"/>
                <xsd:enumeration value="aud"/>
                <xsd:enumeration value="GBP"/>
                <xsd:enumeration value="gbp"/>
                <xsd:enumeration value="EUR"/>
                <xsd:enumeration value="eur"/>
				<xsd:enumeration value="JPY"/>
                <xsd:enumeration value="jpy"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <xsd:element name="AmendedReturnIndicator">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Indication that the T1135 is for an amended form - Value "1" (Yes); Value "0" (No)</xsd:documentation>
            <xsd:documentation xml:lang="fr">Indication que le T1135 est une déclaration modifiée - Valeur "1" (Oui); Valeur "0" (Non)</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IndicatorType"/>
        </xsd:simpleType>
    </xsd:element>

    <xsd:element name="TaxpayerIdentification" type="t1135:TaxpayerIdentificationType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">A T1135 form can be transmitted for Individual, Corporation, Trust, or Partnership taxpayers.  For tax year 2014, only IndividualTaxpayer forms will be accepted.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Un formulaire T1135 peut être transmis pour Particulier, Société, Fiducie, ou Société de personnes. Pour l'année fiscale 2014, seulement les formulaires d’un Particulier contribuable seront acceptés.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="TaxpayerIdentificationType">
        <xsd:choice>
            <xsd:element name="IndividualTaxpayer" type="t1135:IndividualTaxpayerType"/>
            <xsd:element name="CorporationTaxpayer" type="t1135:CorporationTaxpayerType"/>
            <xsd:element name="TrustTaxpayer" type="t1135:TrustTaxpayerType"/>
            <xsd:element name="PartnershipTaxpayer" type="t1135:PartnershipTaxpayerType"/>
        </xsd:choice>
    </xsd:complexType>

    <!-- INDIVIDUAL -->
    <xsd:complexType name="IndividualTaxpayerType">
        <xsd:sequence>
            <xsd:element ref="t1135:TaxpayerName" minOccurs="0"/>
            <xsd:element ref="ccms:SocialInsuranceNumber" minOccurs="0"/>
            <xsd:element ref="t1135:IndividualSelfEmploymentCode" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="IndividualSelfEmploymentCode">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Valid Codes are 1 or 2. 1=self-employed or spouse of a self-employed individual. 2=not self-employed</xsd:documentation>
            <xsd:documentation xml:lang="fr">Les codes valides sont 1 ou 2. 1=revenu d’un travail indépendant ou conjoint d’un particulier ayant un revenu de travail indépendant. 2= pas revenu d’un travail indépendant</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:enumeration value="1"/>
                <xsd:enumeration value="2"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <!-- CORPORATION -->
    <xsd:complexType name="CorporationTaxpayerType">
        <xsd:sequence>
            <xsd:element ref="t1135:CorporationName" minOccurs="0"/>
            <xsd:element ref="t1135:BusinessNumber" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="CorporationName" type="t1135:NameDescription"/>

    <xsd:element name="BusinessNumber" type="t1135:BNRCType" />
    <xsd:simpleType name="BNRCType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([0-9]{9}RC[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- TRUST -->
    <xsd:complexType name="TrustTaxpayerType">
        <xsd:sequence>
            <xsd:element ref="t1135:TrustName" minOccurs="0"/>
            <xsd:element ref="ccms:TrustNumber" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="TrustName" type="t1135:NameDescription"/>

    <!-- PARTNERSHIP -->
    <xsd:complexType name="PartnershipTaxpayerType">
        <xsd:sequence>
            <xsd:element ref="t1135:PartnershipName" minOccurs="0"/>
            <xsd:element ref="t1135:PartnershipNumber" minOccurs="0"/>
            <xsd:element ref="t1135:PartnershipCode" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="PartnershipName" type="t1135:NameDescription"/>

    <xsd:element name="PartnershipNumber" type="t1135:BNRZType" />
    <xsd:simpleType name="BNRZType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([0-9]{9}RZ[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="PartnershipCode">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Valid codes are 1, 2 or 3.  1=Individuals or Trusts. 2=Corporations. 3=Combination of Individuals, Trusts or Corporations</xsd:documentation>
            <xsd:documentation xml:lang="fr">Les codes valides sont 1, 2 ou 3. 1=Particuliers ou Fiducies. 2=Sociétés. 3=Combinaison de Particuliers, Fiducies ou Sociétés</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:enumeration value="1"/>
                <xsd:enumeration value="2"/>
                <xsd:enumeration value="3"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>


    <!-- TAXPAYER ADDRESS -->
    <xsd:element name="TaxpayerAddress" type="t1135:TaxpayerAddressType"/>
    <xsd:complexType name="TaxpayerAddressType">
        <xsd:sequence>
            <xsd:element ref="t1135:AddressStreetText" minOccurs="0"/>
            <xsd:element ref="t1135:AddressMunicipalityName" minOccurs="0"/>
            <xsd:element ref="t1135:GlobalProvinceTerritoryStateCode" minOccurs="0"/>
            <xsd:element ref="t1135:GlobalPostalZipCode" minOccurs="0"/>
            <xsd:element ref="t1135:CountryCode" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="TaxationYearData" type="t1135:TaxationYearDataType"/>
    <xsd:complexType name="TaxationYearDataType">
        <xsd:sequence>
            <xsd:element ref="t1135:TaxationYearStartDate"/>
            <xsd:element ref="t1135:TaxationYearEndDate"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="TaxationYearStartDate" type="sdt:DateType"/>
    <xsd:element name="TaxationYearEndDate" type="sdt:DateType"/>


    <!-- TABLES -->

    <!-- TABLE 1 -->
    <xsd:element name="ForeignFunds" type="t1135:ForeignFundsType"/>
    <xsd:complexType name="ForeignFundsType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">TABLE 1 - Funds Held Outside Canada</xsd:documentation>
            <xsd:documentation xml:lang="fr">TABLEAU 1 - Fonds détenus à l’étranger</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:ForeignFundsRecord" minOccurs="0" maxOccurs="100"/>
            <xsd:element ref="t1135:ForeignFundsTotalHeldYearEndAmount" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignFundsTotalIncomeAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ForeignFundsRecord" type="t1135:ForeignFundsRecordType"/>
    <xsd:complexType name="ForeignFundsRecordType">
        <xsd:sequence>
            <xsd:element ref="t1135:ForeignFundsBankEntityName" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignFundsCountryCode" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignFundsMaximumYearlyHeldAmount" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignFundsHeldYearEndAmount" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignFundsIncomeAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ForeignFundsBankEntityName" type="t1135:NameDescription"/>
    <xsd:element name="ForeignFundsCountryCode" type="ccms:CountryCodeType"/>
    <xsd:element name="ForeignFundsMaximumYearlyHeldAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignFundsHeldYearEndAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignFundsIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignFundsTotalHeldYearEndAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignFundsTotalIncomeAmount" type="t1135:HundredTrillionAmountType"/>


    <!-- TABLE 2 -->
    <xsd:element name="NonResidentCorporationShare" type="t1135:NonResidentCorporationShareType"/>
    <xsd:complexType name="NonResidentCorporationShareType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">TABLE 2 - Shares of non-resident corporations (other than foreign affiliates)</xsd:documentation>
            <xsd:documentation xml:lang="fr">TABLEAU 2 - Actions de sociétés non-résidentes (autres que celles de sociétés étrangères affiliées)</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:NonResidentCorporationShareRecord" minOccurs="0" maxOccurs="100"/>
            <xsd:element ref="t1135:NonResidentCorporationShareTotalYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationShareTotalIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationShareTotalDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="NonResidentCorporationShareRecord" type="t1135:NonResidentCorporationShareRecordType"/>
    <xsd:complexType name="NonResidentCorporationShareRecordType">
        <xsd:sequence>
            <xsd:element ref="t1135:NonResidentCorporationName" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationCountryCode" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationShareMaximumYearlyCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationShareYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationShareIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentCorporationShareDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="NonResidentCorporationName" type="t1135:NameDescription"/>
    <xsd:element name="NonResidentCorporationCountryCode" type="ccms:CountryCodeType"/>
    <xsd:element name="NonResidentCorporationShareMaximumYearlyCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentCorporationShareYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentCorporationShareIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentCorporationShareDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentCorporationShareTotalYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentCorporationShareTotalIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentCorporationShareTotalDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>


    <!-- TABLE 3 -->
    <xsd:element name="NonResidentIndebtedness" type="t1135:NonResidentIndebtednessType"/>
    <xsd:complexType name="NonResidentIndebtednessType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">TABLE 3 - Indebtedness owed by non-resident</xsd:documentation>
            <xsd:documentation xml:lang="fr">TABLEAU 3 - Dettes d'un non-résident</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:NonResidentIndebtednessRecord" minOccurs="0" maxOccurs="100"/>
            <xsd:element ref="t1135:NonResidentIndebtednessTotalYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtednessTotalIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtednessTotalDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="NonResidentIndebtednessRecord" type="t1135:NonResidentIndebtednessRecordType"/>
    <xsd:complexType name="NonResidentIndebtednessRecordType">
        <xsd:sequence>
            <xsd:element ref="t1135:NonResidentIndebtednessDescription" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtednessCountryCode" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtednessMaximumYearlyCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtednessYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtednessIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentIndebtednessDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="NonResidentIndebtednessDescription" type="t1135:NameDescription"/>
    <xsd:element name="NonResidentIndebtednessCountryCode" type="ccms:CountryCodeType"/>
    <xsd:element name="NonResidentIndebtednessMaximumYearlyCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentIndebtednessYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentIndebtednessIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentIndebtednessDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentIndebtednessTotalYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentIndebtednessTotalIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentIndebtednessTotalDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>


    <!-- TABLE 4 -->
    <xsd:element name="NonResidentTrustInterest" type="t1135:NonResidentTrustInterestType"/>
    <xsd:complexType name="NonResidentTrustInterestType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">TABLE 4 - Interests in non-resident trusts</xsd:documentation>
            <xsd:documentation xml:lang="fr">TABLEAU 4 - Participations dans une fiducie non-résidente</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:NonResidentTrustInterestRecord" minOccurs="0" maxOccurs="100"/>
            <xsd:element ref="t1135:NonResidentTrustInterestTotalYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestTotalIncomeReceivedAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestTotalCapitalReceivedAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestTotalDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="NonResidentTrustInterestRecord" type="t1135:NonResidentTrustInterestRecordType"/>
    <xsd:complexType name="NonResidentTrustInterestRecordType">
        <xsd:sequence>
            <xsd:element ref="t1135:NonResidentTrustInterestName" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestCountryCode" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestMaximumYearlyCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestIncomeReceivedAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestCapitalReceivedAmount" minOccurs="0"/>
            <xsd:element ref="t1135:NonResidentTrustInterestDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="NonResidentTrustInterestName" type="t1135:NameDescription"/>
    <xsd:element name="NonResidentTrustInterestCountryCode" type="ccms:CountryCodeType"/>
    <xsd:element name="NonResidentTrustInterestMaximumYearlyCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentTrustInterestYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentTrustInterestIncomeReceivedAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentTrustInterestCapitalReceivedAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="NonResidentTrustInterestDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>
