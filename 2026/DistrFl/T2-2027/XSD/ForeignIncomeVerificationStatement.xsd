    <!-- TABLE 5 -->
    <xsd:element name="ForeignRealProperty" type="t1135:ForeignRealPropertyType"/>
    <xsd:complexType name="ForeignRealPropertyType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">TABLE 5 - Real property outside Canada (other than personal use and real estate used in an active business)</xsd:documentation>
            <xsd:documentation xml:lang="fr">TABLEAU 5 - Biens immeubles à l'étranger (autres que les biens à usage personnel et les biens immeubles utilisés dans une entreprise exploitée activement)</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:ForeignRealPropertyRecord" minOccurs="0" maxOccurs="100"/>
            <xsd:element ref="t1135:ForeignRealPropertyTotalYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealPropertyTotalIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealPropertyTotalDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ForeignRealPropertyRecord" type="t1135:ForeignRealPropertyRecordType"/>
    <xsd:complexType name="ForeignRealPropertyRecordType">
        <xsd:sequence>
            <xsd:element ref="t1135:ForeignRealPropertyDescription" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealPropertyCountryCode" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealPropertyMaximumYearlyCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealPropertyYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealPropertyIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:ForeignRealPropertyDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ForeignRealPropertyDescription" type="t1135:NameDescription"/>
    <xsd:element name="ForeignRealPropertyCountryCode" type="ccms:CountryCodeType"/>
    <xsd:element name="ForeignRealPropertyMaximumYearlyCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignRealPropertyYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignRealPropertyIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignRealPropertyDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignRealPropertyTotalYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignRealPropertyTotalIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="ForeignRealPropertyTotalDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>



    <!-- TABLE 6 -->
    <xsd:element name="OtherForeignProperty" type="t1135:OtherForeignPropertyType"/>
    <xsd:complexType name="OtherForeignPropertyType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">TABLE 6 - Other property outside Canada</xsd:documentation>
            <xsd:documentation xml:lang="fr">TABLEAU 6 - Autres biens à l'étranger</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:OtherForeignPropertyRecord" minOccurs="0" maxOccurs="100"/>
            <xsd:element ref="t1135:OtherForeignPropertyTotalYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignPropertyTotalIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignPropertyTotalDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="OtherForeignPropertyRecord" type="t1135:OtherForeignPropertyRecordType"/>
    <xsd:complexType name="OtherForeignPropertyRecordType">
        <xsd:sequence>
            <xsd:element ref="t1135:OtherForeignPropertyDescription" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignPropertyCountryCode" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignPropertyMaximumYearlyCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignPropertyYearEndCostAmount" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignPropertyIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:OtherForeignPropertyDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="OtherForeignPropertyDescription" type="t1135:NameDescription"/>
    <xsd:element name="OtherForeignPropertyCountryCode" type="ccms:CountryCodeType"/>
    <xsd:element name="OtherForeignPropertyMaximumYearlyCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="OtherForeignPropertyYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="OtherForeignPropertyIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="OtherForeignPropertyDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="OtherForeignPropertyTotalYearEndCostAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="OtherForeignPropertyTotalIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="OtherForeignPropertyTotalDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>


    <!-- TABLE 7 -->
    <xsd:element name="CanadianHeldForeignProperty" type="t1135:CanadianHeldForeignPropertyType"/>
    <xsd:complexType name="CanadianHeldForeignPropertyType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">TABLE 7 - Property held in an account with a Canadian registered securities dealer or a Canadian trust company</xsd:documentation>
            <xsd:documentation xml:lang="fr">TABLEAU 7 - Biens détenus dans un compte auprès d’un courtier en valeurs mobilières inscrit canadien ou d'une société de fiducie canadienne</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyRecord" minOccurs="0" maxOccurs="100"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyTotalYearEndFairMarketValueAmount" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyTotalIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyTotalDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="CanadianHeldForeignPropertyRecord" type="t1135:CanadianHeldForeignPropertyRecordType"/>
    <xsd:complexType name="CanadianHeldForeignPropertyRecordType">
        <xsd:sequence>
            <xsd:element ref="t1135:CanadianHeldForeignPropertySecurityDealerTrustCompanyName" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyCountryCode" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyMaximumYearlyFairMarketValueAmount" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyYearEndFairMarketValueAmount" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyIncomeAmount" minOccurs="0"/>
            <xsd:element ref="t1135:CanadianHeldForeignPropertyDispositionGainLossAmount" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="CanadianHeldForeignPropertySecurityDealerTrustCompanyName" type="t1135:NameDescription"/>
    <xsd:element name="CanadianHeldForeignPropertyCountryCode" type="ccms:CountryCodeType"/>
    <xsd:element name="CanadianHeldForeignPropertyMaximumYearlyFairMarketValueAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="CanadianHeldForeignPropertyYearEndFairMarketValueAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="CanadianHeldForeignPropertyIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="CanadianHeldForeignPropertyDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="CanadianHeldForeignPropertyTotalYearEndFairMarketValueAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="CanadianHeldForeignPropertyTotalIncomeAmount" type="t1135:HundredTrillionAmountType"/>
    <xsd:element name="CanadianHeldForeignPropertyTotalDispositionGainLossAmount" type="t1135:HundredTrillionAmountType"/>


    <!-- CERTIFICATION SECTION -->
    <xsd:element name="CertificationDetail" type="t1135:CertificationDetailType"/>
    <xsd:complexType name="CertificationDetailType">
        <xsd:sequence>
            <xsd:element ref="t1135:CertifierName" minOccurs="0"/>
            <xsd:element ref="t1135:CertifierPositionTitle" minOccurs="0"/>
            <xsd:element ref="t1135:CertifierPhoneNumber" minOccurs="0"/>
            <xsd:element ref="t1135:CertificationDate" minOccurs="0"/>
            <xsd:element ref="t1135:PreparerName" minOccurs="0"/>
            <xsd:element ref="t1135:PreparerAddress" minOccurs="0"/>
            <xsd:element ref="t1135:PreparerPhoneNumber" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="CertifierName" type="t1135:CertifierNameType"/>
    <xsd:complexType name="CertifierNameType">
        <xsd:sequence>
            <xsd:element ref="t1135:TaxpayerName" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="CertifierPositionTitle" type="t1135:NameDescription"/>
    <xsd:element name="CertifierPhoneNumber" type="t1135:PhoneNumberType"/>
    <xsd:element name="CertificationDate" type="sdt:DateType"/>
    <xsd:element name="PreparerName" type="t1135:NameDescription"/>
    <xsd:element name="PreparerAddress" type="t1135:PreparerAddressType"/>
    <xsd:complexType name="PreparerAddressType">
        <xsd:sequence>
            <xsd:element ref="t1135:GlobalAddress" minOccurs="0"/>
            <xsd:element ref="t1135:GlobalPostalZipCode" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="PreparerPhoneNumber" type="t1135:PhoneNumberType"/>


    <!-- COMMON TYPES USED IN THIS SCHEMA FILE -->

    <xsd:element name="GlobalProvinceTerritoryStateCode">
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="100"/>
                <xsd:pattern value="([A-Za-z])*"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <xsd:element name="CountryCode" type="ccms:CountryCodeType"/>

    <xsd:element name="GlobalAddress" type="t1135:NameDescription"/>

    <xsd:element name="GlobalPostalZipCode">
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="20"/>
                <xsd:pattern value="([A-Za-z0-9\-])*"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    
    <xsd:complexType name="NameDescription">
        <xsd:simpleContent>
            <xsd:restriction base="sdt:NameType">
                <xsd:maxLength value="255"/>
            </xsd:restriction>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:simpleType name="HundredTrillionAmountType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">The field is used to capture the dollar amount (no decimals).  The dollar value cannot exceed +/- $99,999,999,999,999. </xsd:documentation>
            <xsd:documentation xml:lang="fr">Le champ est utilisé pour capturer le montant en dollar (pas de décimales). La valeur en dollar ne peut pas dépasser +/- 99.999.999.999.999 $.</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:AmountDollarsOnlyType">
            <xsd:totalDigits value="14"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="PhoneNumberType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">To capture any North American or International phone number with (possible) extension.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Pour capturer tout numéro de téléphone nord-américain ou international avec (possible) l'extension.</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:token">
            <xsd:pattern value="([0-9xX\(\)\-\.])*"/>
            <xsd:maxLength value="20"/>
        </xsd:restriction>
    </xsd:simpleType>
	
	<xsd:element name="SoftwareID">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Ends with "F"/"f" for T1 Efile; "G"/"g" for T1 Netfile; "K"/"k" for T1135 via Efile; "M"/"m" for T1135 via Netfile</xsd:documentation>
            <xsd:documentation xml:lang="fr">Se termine avec un (F) ou (f) pour TED T1; avec un (G) ou (g) pour Impôtnet; (K) ou (k) pour T1135 via TED; (M) ou (m) pour T1135 via Impôtnet.</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
                <xsd:minLength value="4"/>
				<xsd:maxLength value="5"/>
	            <xsd:pattern value="[0-9]{3}[A-Za-z]|[0-9]{3}[A-Za-z]{2}"/>
			</xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
	
	<xsd:element name="SoftwareRevisionDate" type="sdt:DateType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Format is YYYY-MM-DD</xsd:documentation>
            <xsd:documentation xml:lang="fr">Le format est AAAA-MM-JJ</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
	
	<xsd:element name="TaxpayerName" type="t1135:CompleteIndividualNameType"/>
    <xsd:complexType name="CompleteIndividualNameType">
        <xsd:sequence>
            <xsd:element ref="t1135:GivenName"/>
            <xsd:element ref="t1135:FamilyName"/>
        </xsd:sequence>
    </xsd:complexType>
	
	<xsd:element name="GivenName">
        <xsd:complexType>
            <xsd:simpleContent>
				<xsd:restriction base="sdt:NameType">
					<xsd:maxLength value="30"/>
				</xsd:restriction>
			</xsd:simpleContent>
        </xsd:complexType>
    </xsd:element>
	
	<xsd:element name="FamilyName">
        <xsd:complexType>
            <xsd:simpleContent>
				<xsd:restriction base="sdt:NameType">
					<xsd:maxLength value="30"/>
				</xsd:restriction>
			</xsd:simpleContent>
        </xsd:complexType>
    </xsd:element>
    
	<xsd:element name="AddressStreetText">
        <xsd:annotation>
            <xsd:documentation xml:lang="en"> Valid characters include Alpha/numeric, space*, hyphen, apostrophe, slash, ampersand, diacritic, pound symbol (#), brackets ( ) and period*.  A period or space is a valid character at any position except at the first position. The bracket can be in the last position.  It must not contain "A/S: ", "C/O: ", "A/S ", "C/O ", "A/S:", "C/O:", "A/S", "C/O".  The following characters are not allowed in the first or last position:  hyphen, apostrophe, slash, ampersand, brackets, pound symbol.</xsd:documentation>
            <xsd:documentation xml:lang="fr"> Les caractères valides comprennent Alphabétique/numérique, espace *, trait d'union, apostrophe, barre oblique, esperluette, signe accentué, symbole dièse (#), parenthèses () et le point *. Un point ou espace est un caractère valide à n'importe quelle position sauf au niveau de la première position. La parenthèse peut être à la dernière position. Il ne doit pas contenir «A / S: », «C / O: », «A / S », «C / O », «A / S:», «C / O:», «A / S», «C / O». Les caractères suivants ne sont pas autorisés dans la première ou dernière position: trait d'union, apostrophe, barre oblique, esperluette, parenthèses, symbole dièse.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
            <xsd:simpleContent>
                <xsd:restriction base="sdt:TextType">
                    <xsd:maxLength value="60"/>
                </xsd:restriction>
            </xsd:simpleContent>
        </xsd:complexType>
    </xsd:element>
	
	<xsd:element name="AddressMunicipalityName">
        <xsd:complexType>
            <xsd:simpleContent>
                <xsd:restriction base="sdt:NameType">
                    <xsd:maxLength value="50"/>
                </xsd:restriction>
            </xsd:simpleContent>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>
