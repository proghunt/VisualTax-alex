function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo,
  MemoComponentsInfo, MemoGroupInfo, MemoTasksInfo: String): String;
var
  S: String;
begin
  { Fill the 'Ready Memo' with the normal settings and the custom settings }
  S := MemoDirInfo{ + NewLine;
  S := S + 'Install T1-2026 Demo database' + NewLine;
  if T1DemoChecked() then
    S := S + Space + 'Yes (Location: ' + DemoDataDir('') + '\T1-2026)'+ NewLine
  else
    S := S + Space + 'No' + NewLine;

  S := S + 'Install T2-2027 Demo database' + NewLine;
  if T2DemoChecked() then
    S := S + Space + 'Yes (Location: ' + DemoDataDir('') + '\T2-2027)'+ NewLine
  else
    S := S + Space + 'No' + NewLine;

  S := S + NewLine + NewLine};
  
  Result := S;
end;

function InitializeSetup(): Boolean;
begin
  Result := FindWindowByClassName('TVisualTax2017') = 0;
  if not result then
  Begin
    MsgBox('vt2017 is running. Setup will now exit!',  mbError, MB_OK);
  end;
end;

Procedure IncludeValue(const FileName, TagName: string);
var
  I: Integer;
  Line: string;
  TagPos: Integer;
  FileLines: TStringList;
  ExistsLine: Boolean;
begin
  ExistsLine := False;
  FileLines := TStringList.Create;
  try
    FileLines.LoadFromFile(FileName);
    for I := 0 to FileLines.Count - 1 do
    begin
      Line := FileLines[I];
      TagPos := Pos(TagName, Line);
      if TagPos > 0 then
      begin
        ExistsLine := True;
        Break;
      end;
    end;
    if not ExistsLine then
    Begin
      FileLines.Add(TagName);
      FileLines.SaveToFile(FileName);
    end;
  finally
    FileLines.Free;
  end;
end;

Procedure WriteAppsIncluded(AppName: String);
var
  FileName: String;
Begin
  FileName := ExpandConstant('{app}')+'\AppsIncluded.d';
  IncludeValue(FileName,AppName);
end;

// 20160819 Igor
function NextButtonClick(CurPageID: Integer): Boolean;
Begin
  Result := True;
  CASE CurPageID of
    wpSelectDir:
      Begin
        if FileExists(WizardDirValue+'\vtchkupd.exe') then
        begin
          if FileExists(WizardDirValue+'\vtchkupd.exe.ubak') then
          begin
            if not DeleteFile(WizardDirValue+'\vtchkupd.exe.ubak') then
            begin
              Result := False;
              MsgBox('Can not delete temp file vtchkupd.exe.ubak',  mbError, MB_OK);
            end;
          end;
          if result and not RenameFile(WizardDirValue+'\vtchkupd.exe', WizardDirValue+'\vtchkupd.exe.ubak') then
          begin
            Result := False;
            MsgBox('Can not create a backup file vtchkupd.exe',  mbError, MB_OK);
          end;
        end;
      end;
  end;
end;
