; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "VT-2026"
#define MyAppVersion "2.0"
#define MyAppPublisher "VisualTax"
#define MyAppURL "http://visualtax.com"
#define MyAppExeName "VT2026.exe"
#define data "C:\VT"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{D21AD360-3DB8-48FF-8E27-796177AF79EA}
UsePreviousAppDir=no
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName=C:\VT-2026
DefaultGroupName={#MyAppPublisher}
DisableProgramGroupPage=no
AllowNoIcons=yes
OutputDir=..\ReadyForWeb
OutputBaseFilename=VT2026utilitiesupdate
Compression=lzma
SolidCompression=yes
AppendDefaultDirName=no
UninstallDisplayIcon={app}\{#MyAppExeName}
PrivilegesRequired=admin 
SignTool=MsSign $f

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
; VT20XX : Third party  DLLS
Source: "..\DistrFl\ChilkatDelphiXE.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZCurl.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\Eztwain3.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZDcx.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZGif.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZJpeg.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZOcr.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZPdf.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZPng.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZSymbol.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\EZTiff.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\libeay32.dll"; DestDir: "{app}"; Flags: onlyifdoesntexist
Source: "..\DistrFl\ssleay32.dll"; DestDir: "{app}"; Flags: onlyifdoesntexist
Source: "..\DistrFl\vtPDF.dll"; DestDir: "{app}"; Flags: ignoreversion

Source: "..\DistrFl\rtl180.bpl"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\sqlite3.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\vcl180.bpl"; DestDir: "{app}"; Flags: ignoreversion

Source: "..\DistrFl\vtUpdateUtilities.ini"; DestDir: "{app}"; Flags: ignoreversion


; Certificate
Source: "Certificate\VisualTax.cer"; DestDir: "{app}"; Flags: ignoreversion;

; Chromium
Source: "..\DistrFl\CEF4Delphi.bpl"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\DistrFl\Chromium\*.*"; DestDir: "{app}\Chromium"; Flags: ignoreversion;
Source: "..\DistrFl\Chromium\locales\*.*"; DestDir: "{app}\Chromium\locales"; Flags: ignoreversion;
Source: "..\DistrFl\Chromium\swiftshader\*.*"; DestDir: "{app}\Chromium\swiftshader"; Flags: ignoreversion;

; DropBox dll
Source: "..\DistrFl\vtDropBoxHelper.dll"; DestDir: "{app}"; Flags: ignoreversion;
Source: "..\DistrFl\borlndmm.dll"; DestDir: "{app}"; Flags: ignoreversion;

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VisualTax Out"" program=""{app}\{#MyAppExeName}"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VisualTax (TR-2026) Out"" program=""{app}\TR2019.exe"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VisualTax (TDDGetData) Out"" program=""{app}\TDDGetData.exe"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VisualTax (vtchkupd) Out"" program=""{app}\vtchkupd.exe"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "certutil.exe"; Parameters: "-addstore -f Root {app}\VisualTax.cer"; StatusMsg: "Adding trusted publisher..."; 


[Code]

#expr Exec(AddBackslash(SourcePath) + "Certificate\_SignAll.bat")

