[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VisualTax Out"" program=""{app}\{#MyAppExeName}"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VisualTax (TR-2026) Out"" program=""{app}\TR2019.exe"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VisualTax (TDDGetData) Out"" program=""{app}\TDDGetData.exe"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VisualTax (vtchkupd) Out"" program=""{app}\vtchkupd.exe"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "certutil.exe"; Parameters: "-addstore -f Root {app}\VisualTax.cer"; StatusMsg: "Adding trusted publisher..."; 

