  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    Fintf:= punk as IProfileClient;
  end;
end;

procedure TT2010FXClient.ConnectTo(svrIntf: IProfileClient);
begin
  Disconnect;
  FIntf := svrIntf;
