  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    Fintf:= punk as IProfileModule;
  end;
end;

procedure TT2015T2Module.ConnectTo(svrIntf: IProfileModule);
begin
  Disconnect;
  FIntf := svrIntf;
end;

