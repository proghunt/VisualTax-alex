procedure TT2016T2File.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    Fintf:= punk as IProfileFile;
  end;
end;

procedure TT2016T2File.ConnectTo(svrIntf: IProfileFile);
begin
  Disconnect;
  FIntf := svrIntf;
