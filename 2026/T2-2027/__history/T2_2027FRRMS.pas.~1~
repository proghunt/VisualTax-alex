function GetInternetTime: string;
var
  i: integer;
  tempDate: TDateTime;
  s: string;
begin
  with TIdSNTP.Create(nil) do
  try
    Host := 'ntp2.cs.wisc.edu';
    ReceiveTimeout := 5000;

    for i := 0 to 10 do
    begin
      tempDate := DateTime;
      tempDate := TTimeZone.Local.ToUniversalTime(tempDate);

      s := FormatDateTime('yyyy-mm-dd"T"hh:nn:ss.zzz"Z"', tempDate);
      if Pos('1899', s) = 0 then
        break;
    end;
    result := s;
  finally
    Free;
  end;
end;

function GenerateNonce: string;
var
  randomInt: integer;
  randomstring: ansistring;
begin
  randomInt := Random(1000000);
  randomstring := Format('%.*d', [7, randomInt]) +
    FormatDateTime('dddddhh:nn:ss.zzz', Now());
  result := randomstring;
end;

function GenerateCID: string;
var
  randomInt: integer;
  randomstring: string;
begin
  randomInt := Random(1000000);
  randomstring := Format('%.*d', [7, randomInt]) +
    FormatDateTime('dddddhhnnsszzz', Now());
  result := 'part' + randomstring.Replace('/', '') + '@tdd.awsc.gc.ca';
end;

function GetBytes(const AText: ansistring): TBytes;
begin
  SetLength(result, Length(AText));
  if Length(AText) > 0 then
    Move(AText[1], result[0], Length(AText));
end;

function Get_Password_Digest(ANonce, ACreated, APassword: ansistring)
  : ansistring;
var
  crypt: TTXPCrypto;
  bytesToHash, nonceBytes, CreatedBytes, passwordBytes: TBytes;

  function Concat(const AParam1, AParam2, AParam3: TBytes): TBytes;
  var
    Idx: integer;
  begin
    SetLength(result, Length(AParam1) + Length(AParam2) + Length(AParam3));
    Idx := 0;
    Move(AParam1[0], result[Idx], Length(AParam1));
    Inc(Idx, Length(AParam1));
    Move(AParam2[0], result[Idx], Length(AParam2));
    Inc(Idx, Length(AParam2));
    Move(AParam3[0], result[Idx], Length(AParam3));
  end;

begin
  crypt := TTXPCrypto.Create;
  try
    nonceBytes := GetBytes(ANonce);
    CreatedBytes := GetBytes(ACreated);
    passwordBytes := GetBytes(APassword);
    bytesToHash := Concat(nonceBytes, CreatedBytes, passwordBytes);
    result := crypt.base64Encode(crypt.SHA1Hash(bytesToHash))
  finally
    crypt.free;
  end;
end;

function HexStringToBase64(const HexStr: string): string;
var
  md5bytes: TIdBytes;
begin
  SetLength(md5Bytes, Length(HexStr) div 2);
  HexToBin(PChar(HexStr), Pointer(md5Bytes), Length(md5Bytes));
  Result := TIdEncoderMIME.EncodeBytes(md5Bytes);
end;

function GetFileHash(AFileName: string): string;
var
  FS: TFileStream;
  SHA: TIdHashSHA256;
begin
  LoadOpenSSLLibrary;
  if TIdHashSHA256.IsAvailable then
  begin
    FS := TFileStream.Create(AFileName, fmOpenRead);
    try
      SHA := TIdHashSHA256.Create;
      try
        Result := HexStringToBase64(SHA.HashStreamAsHex(FS));
      finally
        SHA.Free;
      end;
    finally
      FS.Free;
    end;
  end;
end;

function GetFileBase64(AFileName: string): string;
var
  Encoder: TIdEncoderMIME;
  Base64String: String;
  FStream: TFileStream;
begin
  Encoder := TIdEncoderMIME.Create;
  FStream := TFileStream.Create(AFilename, fmOpenRead);
  try
    Result := Encoder.Encode(FStream);
  finally
    FreeAndNil(Encoder);
    FreeAndNil(FStream);
  end;
end;

function GetFileSize(FileName: string): TLargeInteger;
var
  SearchRec: TSearchRec;
begin
  if FindFirst(FileName, faAnyFile, SearchRec) = 0 then
  begin
    Result := SearchRec.Size;
    FindClose(SearchRec);
  end
  else
    Result := -1;
end;

function TFRRMST2_2027.AddFile(ASequence, ADocumentType: integer;
  AFileName, AFormName: string): boolean; //20230109 Igor
var nSize: int64;
    F: TFileRecord;
    I: integer;
begin
  Result := false;
  if not FileExists(AFileName) then
  begin
    ShowMessage('File '+ QuotedStr(AFileName) + ' does not exists');
    Exit;
  end;
  nSize := GetFileSize(AFileName);
  if nSize > RemainingSize then
  begin
    ShowMessage('Total file size with new file will be '+
                Format('%.2f', [(nSize + TotalSize) / 1024 / 1024])+' Mb. '+
                'File cannot be attached');
    Exit;
  end;
  for I := 0 to Files.Count - 1 do
    if SameText(ExtractFileName(Files[I].FileName), ExtractFileName(AFileName)) then
    begin
      ShowMessage('You have already added file with the same name');
      Exit;
    end;
  F.FileName := AFileName;
  F.Sequence := ASequence;
  F.DocType := ADocumentType;
  F.FileSize := nSize;
  F.cid := GenerateCID;
  F.Hash := GetFileHash(AFileName);
  F.FormName := AFormName; //20230109 Igor
  Files.Add(F);
  RebuildGrid;
  Result := true;
end;

