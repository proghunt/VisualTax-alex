  end;
end;

procedure TFRRMST2_2027.SendSoapMessage;
var
  Boundary: string;
  ContentID: string;
  SoapAction: string;
  MStrm: TMemoryStream;
  FStrm: TFileStream;
  ResponseXML: string;
  objHttp: IXMLHTTPRequest;
  Buf: TArray<Byte>;
  I: integer;

  procedure WriteStringToStream(AStream: TMemoryStream; AText: String);
  var cText: AnsiString;
  begin
    cText := AText;
    AStream.Write(cText[1], Length(cText));
  end;

begin
  Boundary := '----PART637009425006238352';
  ContentID := '<rootpart2ddaae2c62b4f00075ff9c55f1818800@tdd.awsc.gc.ca>';
  SoapAction := 'http://www.cra-arc.gc.ca/xmlns/tdd/edoc/request';

  MStrm := TMemoryStream.Create;
  try
    WriteStringToStream(MStrm, '--' + Boundary + EOL);
    WriteStringToStream(MStrm, 'Content-Type: application/xop+xml; charset=UTF-8; type="text/xml"' + EOL);
    WriteStringToStream(MStrm, 'Content-Transfer-Encoding: 8bit' + EOL);
    WriteStringToStream(MStrm, 'Content-ID: ' + ContentID + EOL);

    WriteStringToStream(MStrm, EOL + EOL);

    WriteStringToStream(MStrm, BuildSoapMessage + EOL);

    for I := 0 to Files.Count - 1 do
    begin
      WriteStringToStream(MStrm, EOL + '--' + Boundary + EOL);
      WriteStringToStream(MStrm, 'Content-Id: <' + Files[I].cid + '>' + EOL);
      WriteStringToStream(MStrm, 'Content-Type: application/octet-stream' + EOL);
      WriteStringToStream(MStrm, 'Content-Transfer-Encoding: binary' + EOL);

      WriteStringToStream(MStrm, EOL);

      // in specification it is written that files less 1 mb should be encoded in Base64,
      // but it does not work

      {if Files[I].FileSize <= 1024 * 1024 then
        WriteStringToStream(MStrm, GetFileBase64(Files[I].FileName))
      else}
      begin
        FStrm := TFileStream.Create(Files[I].FileName, fmOpenRead);
        try
          SetLength(Buf, FStrm.Size);
          FStrm.Position := 0;
          FStrm.ReadBuffer(Buf, FStrm.Size);
          MStrm.WriteBuffer(Buf, Length(Buf));
        finally
          FStrm.Free;
        end;
      end;
    end;

    WriteStringToStream(MStrm, EOL + '--' + Boundary + '--' + EOL);
    WriteStringToStream(MStrm, EOL);

    MStrm.SaveToFile(GetSubmittedFileName);

    edSubmittedFile.Text := GetSubmittedFileName;

    objHttp := CreateOleObject('MSXML2.XMLHTTP.3.0') as IXMLHTTPRequest;

    objHttp.open('POST', URLForWebServices.Text, False, '', ''); //20230821 Igor
    objHttp.setRequestHeader('Content-Type', 'multipart/related; type="application/xop+xml"; start="'+ ContentID +'"; start-info="text/xml"; boundary="'+ Boundary +'"');

    SetLength(Buf, Mstrm.Size);
    MStrm.Position := 0;
    Mstrm.ReadBuffer(Buf, Mstrm.Size);

    objHttp.send(Buf);
    ResponseXML := objHttp.ResponseText;

    SaveToFile(ResponseXML, GetReceivedFileName);

    edReceivedFile.Text := GetReceivedFileName;

    Response := ParseResponse(ResponseXML);
    ShowHTML(Response);
    if FileExists(GetReceivedHTMLFileName) then
      edReceivedHTMLFile.Text := GetReceivedHTMLFileName;
  finally
    MStrm.Free;
  end;
end;

procedure TFRRMST2_2027.ShowHTML(AResponse: TResponse);
var L: TStringList;
    A: TArray<string>;
    I: integer;
    cColor, cBody: string;
    cCaption: string;
begin
  if AResponse.Success then
  begin
    cColor := 'green';
    cCaption := 'Confirmation';
  end
  else
  begin
    cColor := 'red';
    cCaption := 'Error';
  end;
  L := TStringList.Create;
  try
    L.Add('<HTML><HEAD>');
    L.Add('<META CHARSET="UTF-8">');
    L.Add('<TITLE>T2 EFile Service</TITLE>');
    L.Add('</HEAD>');
    L.Add('<BODY>');
    L.Add('<DIV id="contentheader">');
    L.Add('<H1><FONT size=5><STRONG>FRRMS Results</STRONG></FONT></H1>');
    L.Add('<P>Business Number: <STRONG>'+ HTMLEscape(edNumber.Text) +'</STRONG></P>');
    L.Add('<P>Form Type: <STRONG>'+ HTMLEscape(edFormType.Text) +'</STRONG></P>');
    L.Add('<P>EFile Reference Number: <STRONG>'+ HTMLEscape(edEFileNumber.Text) +'</STRONG></P>');
    L.Add('<P>Start Date: <STRONG>'+ HTMLEscape(edStartDate.Text) +'</STRONG></P>');
    L.Add('<P>End Date: <STRONG>'+ HTMLEscape(edEndDate.Text) +'</STRONG></P>');

    L.Add('<H2><FONT color='+ cColor +' size=5><STRONG>'+ cCaption +'</STRONG></FONT></H2>');
    if AResponse.Success then
    begin
      L.Add('<P><FONT size=3>'+ 'Result Code: ' + inttostr(AResponse.ReturnCode) + ' - ' + AResponse.Description  +'</FONT></P>');
      L.Add('<P><FONT size=3>'+ AResponse.Text +'</FONT></P>');
    end
    else
    begin
      if AResponse.ReturnCode <> -1 then
        L.Add('<P><FONT size=3><strong>Result Code:</strong> '+ IntToStr(AResponse.ReturnCode) +' - '+ AResponse.Description +'</FONT></P>');

      //L.Add('<P><FONT size=3>'+ HTMLEscape(AResponse.Text) +'</FONT></P>'); //20230725 //JZ //messes up HTML formating
      L.Add('<P><FONT size=3>'+ AResponse.Text +'</FONT></P>');

      if not AResponse.ErrorReason.IsEmpty then
        if AResponse.ErrorReasonDescription.IsEmpty then
          L.Add('<P><FONT size=3><strong>Error Reason:</strong> '+ AResponse.ErrorReason +'</FONT></P>')
        else
          L.Add('<P><FONT size=3><strong>Error Reason:</strong> '+ AResponse.ErrorReason +' - '+ AResponse.ErrorReasonDescription +'</FONT></P>');
      if not AResponse.ErrorReasonText.IsEmpty then
        L.Add('<P><FONT size=3>'+ HTMLEscape(AResponse.ErrorReasonText) +'</FONT></P>');
    end;
    L.Add('<HR>');
    L.Add('<P>Received: '+ DateTimeToStr(Now) +'</P>');
    L.Add('</DIV></BODY></HTML>');
    L.SaveToFile(GetReceivedHTMLFileName, TEncoding.UTF8);
    ShowMessageHTML(L.Text, 600);
  finally
    L.Free;
  end;
end;

