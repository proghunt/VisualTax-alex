function TFRRMST2_2027.ParseResponse(AResponse: string): TResponse;
var X: XML.XMLDoc.TXMLDocument;
    Node, NodeReturnCode, NodeConfirmationNumber, NodeTimeStamp, NodeErrorReason: IXMLNode;
    ACode, ACaption, AMessage, ALines: string;
    I: integer;
    RetNo : integer;

        function GetNodeValue(ANode: IXMLNode; ANodeName: string; ACaption: string = ''): string;
        var TNode: IXMLNode;
        begin
          Result := '';
          TNode := ANode.ChildNodes.FindNode(ANodeName);
          if Assigned(TNode) then
          begin
            if not SameText(ACaption, '') then
              Result := ACaption + ': ';
            Result := Result + TNode.NodeValue;
          end;
        end;

        procedure ParseErrorReason(AErrorReason: string); //20230109 Igor
        const DELIM = '¦';
        var A: TArray<string>;
            I: integer;
        begin
          AErrorReason := ReplaceStr(AErrorReason, '] [', DELIM);
          AErrorReason := ReplaceStr(AErrorReason, '[', '');
          AErrorReason := ReplaceStr(AErrorReason, ']', '');
          A := AErrorReason.Split([DELIM], ExcludeEmpty);
          if Length(A) = 0 then Exit;
          Result.ErrorReason := A[0];
          if SameText(Result.ErrorReason, '0001') then
          begin
            Result.ErrorReasonDescription := 'MALFORMED_XML';
            Result.ErrorReasonText := 'XML malformed/invalid';
          end
          else if SameText(Result.ErrorReason, '0002') then
          begin
            Result.ErrorReasonDescription := 'MANDATORY_PARAMETER';
            Result.ErrorReasonText := 'Mandatory parameter missing - {0}';
          end
          else if SameText(Result.ErrorReason, '0003') then
          begin
            Result.ErrorReasonDescription := 'INVALID_PARAMETER_VALUE';
            Result.ErrorReasonText := 'Invalid value {0} for parameter name {1}';
          end
          else if SameText(Result.ErrorReason, '0004') then
          begin
            Result.ErrorReasonDescription := 'MAX_FILE_SIZE_EXCEEDED';
            Result.ErrorReasonText := 'File(s) exceeded maximum';
          end
          else if SameText(Result.ErrorReason, '0005') then
          begin
            Result.ErrorReasonDescription := 'DUPLICATE_FILE';
            Result.ErrorReasonText := 'Duplicate Files';
          end
          else if SameText(Result.ErrorReason, '0006') then
          begin
            Result.ErrorReasonDescription := 'NO_FILE_ATTACHMENTS';
            Result.ErrorReasonText := 'Empty File Attachment Bundle';
          end
          else if SameText(Result.ErrorReason, '0007') then
          begin
            Result.ErrorReasonDescription := '';
            Result.ErrorReasonText := 'Business Number Status {0}';
          end
          else if SameText(Result.ErrorReason, '0008') then
          begin
            Result.ErrorReasonDescription := '';
            Result.ErrorReasonText := 'Confirmation Row Data';
          end;
          for I := 1 to Length(A) - 1 do
            Result.ErrorReasonText := ReplaceStr(Result.ErrorReasonText, '{'+ IntToStr(I-1) +'}', A[I]);
        end;

begin
  Result.Success := false;
  Result.ReturnCode := -1;
  Result.Description := '';
  Result.Text := '';
  Result.ErrorReason := '';
  Result.ErrorReasonDescription := '';
  Result.ErrorReasonText := '';

  X := XML.XMLDoc.TXMLDocument.Create(Application);
  try
    try
      X.XML.Clear;
      X.XML.Add(ClearXML(AResponse));
      if not(X.Active) then
        X.Active := true;
      Node := X.DocumentElement;
      while True do
      begin
        if Node = nil then
          raise Exception.Create('Bad Response XML structure: ' + AResponse)
        else if Node.NodeName = 'Envelope' then
        begin
          Node := Node.ChildNodes.FindNode('Body');
          continue;
        end
        else if Node.NodeName = 'Body' then
        begin
          Node := Node.ChildNodes.FindNode('EDocResponse');
          continue;
        end
        else
          break;
      end;

      if Node.NodeName = 'EDocResponse' then
      begin
        NodeReturnCode := Node.ChildNodes.FindNode('ReturnCode');
        Result.ReturnCode := StrToIntDef(NodeReturnCode.NodeValue, -1);
        if Result.ReturnCode = 0 then
        begin
          NodeConfirmationNumber := Node.ChildNodes.FindNode('ConfirmationNumber');
          NodeTimeStamp := Node.ChildNodes.FindNode('Timestamp');

          Result.Success := true;
          Result.Description := 'REQUEST_ACCEPTED';
          Result.Text :=
            'Confirmation number: &lt<b>'+ NodeConfirmationNumber.NodeValue +'</b>&gt<br>'+
            'Timestamp: &lt<b>'+ NodeTimeStamp.NodeValue +'</b>&gt<br>' +
            'Keep your confirmation number for future reference. You may want to print this page.<br>'+
            'Your document has been successfully submitted.<br><br>'+

            'Keep all your receipts and supporting documents in case we ask to see them.';
        end
        else if Result.ReturnCode = 201 then
        begin
          Result.Description := 'INVALID_REQUEST';
          Result.Text := 'The request is not structured properly';
        end
        else if Result.ReturnCode = 202 then
        begin
          Result.Description := 'INVALID_SP_ID';
          Result.Text := 'The SPID provided is invalid';
        end
        else if Result.ReturnCode = 206 then
        begin
          Result.Description := 'INVALID_BN';
          Result.Text := 'The provided BN format is invalid. The format must conform to 999999999RC9999 (Nine digits, RC, 4 digits) or 999999999RZ9999 (Nine digits, RZ, 4 digits). '+
                         'BN is a mandatory input';
        end
        else if Result.ReturnCode = 207 then
        begin
          Result.Description := 'UNSUPPORTED_RELEASE_ID';
          Result.Text := 'The release is no longer supported.  Please update to the most current supported release';
        end
        else if Result.ReturnCode = 301 then
        begin
          Result.Description := 'NOT_AUTHORIZED';
          Result.Text := 'The SPID does not have access to the edoc service';
        end
        else if Result.ReturnCode = 302 then
        begin
          Result.Description := 'INVALID_USERNAME_PASSWORD';
          Result.Text :=
            'Please carefully complete both identification fields and try again.<br>'+
            'Note: Your access will be locked after five unsuccessful attempts.<br>'+
            'For assistance, contact your <a href="https://www.canada.ca/en/revenue-agency/services/e-services/e-services-businesses/efile-electronic-filers/efile-helpdesk-support-t1-returns.html">EFILE Helpdesk</a>.';
        end
        else if Result.ReturnCode = 303 then
        begin
          Result.Description := 'USER_ACCOUNT_BLOCKED';
          Result.Text :=
            'Your access is locked. Please contact your <a href="https://www.canada.ca/en/revenue-agency/services/e-services/e-services-businesses/efile-electronic-filers/efile-helpdesk-support-t1-returns.html">EFILE Helpdesk</a>.'
        end
        else if Result.ReturnCode = 501 then
        begin
          Result.Description := 'SERVICE_UNAVAILABLE';
          Result.Text := 'The system is currently unavailable. Please refer to times of operation';
        end
        else if Result.ReturnCode = 502 then
        begin
          Result.Description := 'SYSTEM_BUSY';
          Result.Text := 'The system is too busy. Please retry later';
        end
        else if Result.ReturnCode = 503 then
        begin
          Result.Description := 'SYSTEM_ERROR';
          Result.Text := 'A system error occurred. This could be a temporary condition. A retry may be successful';
        end
        else if Result.ReturnCode = -1 then
          Result.Text := AResponse;

        //20230109 Igor >>>
        NodeErrorReason := Node.ChildNodes.FindNode('ErrorReason');
        if NodeErrorReason <> nil then
          ParseErrorReason(VarToStr(NodeErrorReason.NodeValue));
        //20230109 Igor <<<
      end
      else
      begin
        Result.Text := AResponse;
      end;
    except on E: Exception do
      begin
        ShowMessage('Error occured while processing CRA SOAP response: '+ #13 + E.Message + #13#13 + 'Response: '+ AResponse);
      end;
    end;
  finally
    X.Free;
  end;
end;

