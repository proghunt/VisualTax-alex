function TFRRMST2_2027.BuildSoapHeader: string;
var Nonce, Created, PasswordDigest: string;
begin
  Nonce := GenerateNonce;
  Created := GetInternetTime;
  PasswordDigest := Get_Password_Digest(Nonce, Created, GetKey);
  Result :=
    '    <S:Header> '+ EOL +
    '        <wsse:Security xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd" S:mustUnderstand="1"> '+ EOL +
    '        <wsse:UsernameToken xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"> '+ EOL +
    '            <wsse:Username>'+ c_SoftwareId +'</wsse:Username> '+ EOL +
    '            <wsse:Password Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordDigest">'+ Trim(PasswordDigest) +'</wsse:Password> '+ EOL +
    '            <wsse:Nonce EncodingType="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-soap-message-security-1.0#Base64Binary">'+ encodeString(Nonce) +'</wsse:Nonce> '+ EOL +
    '            <wsu:Created>'+ Created +'</wsu:Created>'+ EOL +
    '        </wsse:UsernameToken> '+ EOL +
    '        </wsse:Security> '+ EOL +
    '    </S:Header>';
end;

function TFRRMST2_2027.BuildSoapMessage: string;
begin
