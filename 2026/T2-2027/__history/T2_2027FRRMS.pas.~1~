procedure TFRRMST2_2027.RebuildGrid;
var F: TFileRecord;
    I, J, Row: integer;
begin
  for I := 0 to grFiles.ColCount - 1 do
    for J := 1 to grFiles.RowCount - 1 do
      grFiles.Cells[I, J] := '';

  grFiles.RowCount := Files.Count + 1;
  if grFiles.RowCount = 1 then
  begin
    grFiles.RowCount := 2;
    grFiles.FixedRows := 1;
  end;
  grFiles.Cells[0, 0] := 'Slip/Seq/Supp Number';
  grFiles.Cells[1, 0] := 'Document Type';
  grFiles.Cells[2, 0] := 'File Name';
  grFiles.Cells[3, 0] := 'File Size';
  Row := 1;
  TotalSize := 0;
  for F in Files do
  begin
    grFiles.Cells[0, Row] := Format('%.*d',[2, F.Sequence]) + ' - ' + F.FormName; //20230109 Igor
    grFiles.Cells[1, Row] := DocumentTypesFull[F.DocType];
    grFiles.Cells[2, Row] := ExtractFileName(F.FileName);
    grFiles.Cells[3, Row] := Format('%.2f', [F.FileSize / 1024 / 1024])+' Mb';
    TotalSize := TotalSize + F.FileSize;
    inc(Row);
  end;
  RemainingSize := MaxTotalSize - TotalSize;
  lbTotal.Caption := Format('%.2f', [TotalSize / 1024 / 1024])+' Mb';
  lbRemaining.Caption := Format('%.2f', [RemainingSize / 1024 / 1024])+' Mb';
  lbRemainingNumber.Caption := IntToStr(MaxFiles - Files.Count);
  btnAttach.Enabled := Files.Count < MaxFiles;
  btnDetach.Enabled := Files.Count > 0;
end;

