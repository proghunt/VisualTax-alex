  object Label3: TLabel
    Left = 21
    Top = 84
    Width = 704
    Height = 48
    Caption = 
      'I may file a corporation income tax return using Corporation Int' +
      'ernet Filing only for the corporation to which a Web Access Code' +
      ' has been assigned or for my client if I am a registered tax pro' +
      'fessional with a valid EFILE On-Line number and password.'
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -13
    Font.Name = 'Arial'
    Font.Style = []
    ParentFont = False
    WordWrap = True
  end
  object Label13: TLabel
    Left = 21
    Top = 147
    Width = 697
    Height = 32
    Caption = 
      'I may only file an initial or amended, eligible, 2002 or subsequ' +
      'ent year corporation income tax return through Corporation Inter' +
      'net Filing.'
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -13
    Font.Name = 'Arial'
    Font.Style = []
    ParentFont = False
    WordWrap = True
  end
  object Label14: TLabel
    Left = 21
    Top = 189
    Width = 699
    Height = 32
    Caption = 
      'I understand that I will not be able to use the Corporation Inte' +
      'rnet Filing service to file an initial or amended return for yea' +
      'r prior to the 2002 tax year.'
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -13
    Font.Name = 'Arial'
    Font.Style = []
    ParentFont = False
    WordWrap = True
  end
  object Label15: TLabel
    Left = 21
    Top = 232
    Width = 709
    Height = 32
    Caption = 
      'I understand and agree that I cannot change the corporation'#39's na' +
      'me, and head office or mailing addresses with a tax return filed' +
      ' through Corporation Internet Filing.'
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -13
    Font.Name = 'Arial'
    Font.Style = []
    ParentFont = False
    WordWrap = True
  end
  object Label16: TLabel
    Left = 21
    Top = 280
    Width = 709
    Height = 16
    Caption = 
      'I understand that I cannot add or change direct deposit informat' +
      'ion with a tax return filed through Corporation Internet Filing.'
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -13
    Font.Name = 'Arial'
    Font.Style = []
    ParentFont = False
    WordWrap = True
  end
  object Label17: TLabel
    Left = 21
    Top = 315
    Width = 675
    Height = 32
    Caption = 
      'I will not attempt to disrupt the Corporation Internet Filing se' +
      'rvice by uploading files other than the eligible corporation inc' +
      'ome tax return. If I do, the Canada Revenue Agency (CRA) will de' +
      'ny me access to electronic services.'
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -13
    Font.Name = 'Arial'
    Font.Style = []
    ParentFont = False
    WordWrap = True
  end
