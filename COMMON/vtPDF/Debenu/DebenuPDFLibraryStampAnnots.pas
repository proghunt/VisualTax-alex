function GetStampStream(const StampName: AnsiString): AnsiString;
var
  X: Integer;
  SH: AnsiString;
begin
  Result := '';

  if (StampName = 'Approved') then Result := GetStamp1;
  if (StampName = 'Experimental') then Result := GetStamp2;
  if (StampName = 'NotApproved') then Result := GetStamp3;
  if (StampName = 'AsIs') then Result := GetStamp4;
  if (StampName = 'Expired') then Result := GetStamp5;
  if (StampName = 'NotForPublicRelease') then Result := GetStamp6;
  if (StampName = 'Confidential') then Result := GetStamp7;
  if (StampName = 'Final') then Result := GetStamp8;
  if (StampName = 'Sold') then Result := GetStamp9;
  if (StampName = 'Departmental') then Result := GetStamp10;
  if (StampName = 'ForComment') then Result := GetStamp11;
  if (StampName = 'TopSecret') then Result := GetStamp12;
  if (StampName = 'Draft') then Result := GetStamp13;
  if (StampName = 'ForPublicRelease') then Result := GetStamp14;
  if (Result = '') then
  begin
    Result := GetStamp13;
  end;

  SH := '';
  for X := 1 to Length(Result) div 2 do
  begin
    SH := SH + AnsiChar(QPLStrToInt('$' + Copy(Result, X * 2 - 1, 2)));
  end;
  Result := InflateStr(SH);
end;

end.
