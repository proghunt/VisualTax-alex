procedure GetCharsetNames(Vector: TPDFEncodingVector;
  var Charset: TPDFCharsetNames);
var
  X: Integer;
  Map: TPDFCharsetValues;
  V: Integer;
begin
  for X := 0 to 255 do
    Map[X] := 0;
  if Vector = peMacExpertEncoding then
  begin
    for X := 1 to 93 do
    begin
      V := MacExpertEncodingVector[X];
      if (V >= 0) and (V <= 255) then
        Map[V] := X;
    end;
  end else
  if Vector = peSymbol then
  begin
    for X := 0 to 255 do
    begin
      Charset[X] := '';
    end;
    for X := 1 to 189 do
    begin
      V := SymbolEncodingVector[X];
      if (V >= 0) and (V <= 255) then
      begin
        Charset[V] := SymbolCharNames[X];
      end;
    end;
  end else
  begin
    for X := 1 to 229 do
    begin
      V := -1;
      case Vector of
        peStandard: V := StandardEncodingVector[X];
        peMacRoman: V := MacRomanEncodingVector[X];
        peWinAnsi: V := WinAnsiEncodingVector[X];
        pePDFDoc: V := PDFDocEncodingVector[X];
      end;
      if (V >= 0) and (V <= 255) then
        Map[V] := X;
    end;
  end;

  if (Vector <> peSymbol) then
  begin
    for X := 0 to 255 do
    begin
      if Map[X] = 0 then
      begin
        if Vector = peWinAnsi then
        begin
          case X of
            0..32: Charset[X] := '.notdef';
            160: Charset[X] := 'space';
            173: Charset[X] := 'hyphen';
          else
            Charset[X] := 'bullet';
          end;
        end else
        if (Vector = peMacRoman) and (X = 202) then
        begin
          Charset[X] := 'space';
        end else
          Charset[X] := '.notdef';
      end else
        Charset[X] := CharNames[Map[X]];
    end;
  end;
end;

procedure GetUnicodeNames(Vector: TPDFEncodingVector;
  var Charset: TPDFCharsetNames);
var
  X: Integer;
  CharCode: Integer;
begin
  for X := 0 to 255 do
  begin
    Charset[X] := '';
  end;
  if (Vector = peSymbol) then
  begin
    for X := 1 to 189 do
    begin
      CharCode := SymbolEncodingVector[X];
      if (CharCode >= 0) then
      begin
        Charset[CharCode] := 'U+' + QPLIntToHex(SymbolUnicodeValues[X], 4);
      end;
    end;
  end;
end;

procedure GetPostscriptNames(Vector: TPDFEncodingVector;
  var Charset: TPDFCharsetNames);
var
  X: Integer;
  CharCode: Integer;
begin
  for X := 0 to 255 do
  begin
    Charset[X] := '';
  end;
  if (Vector = peSymbol) then
  begin
    for X := 1 to 189 do
    begin
      CharCode := SymbolEncodingVector[X];
      if (CharCode >= 0) then
      begin
        Charset[CharCode] := 'PS:' + SymbolCharNames[X];
      end;
    end;
  end;
end;

procedure GetMapping(VectorFrom, VectorTo: TPDFEncodingVector;
  MissingChar: Byte; var Charset: TPDFCharsetValues);
var
  CSFrom: TPDFCharsetNames;
  CSTo: TPDFCharsetNames;
begin
  GetCharsetNames(VectorFrom, CSFrom);
  GetCharsetNames(VectorTo, CSTo);
  GetMapping(CSFrom, CSTo, MissingChar, Charset);
end;

procedure GetMapping(CSFrom, CSTo: TPDFCharsetNames;
  MissingChar: Byte; var Charset: TPDFCharsetValues);
var
  SL: TQuickPDFCaseSensitiveStringList;
  X: Integer;
  SI: Integer;
begin
  SL := TQuickPDFCaseSensitiveStringList.Create;
  try
    for X := 0 to 255 do
      SL.Add(CSTo[X]);
    for X := 0 to 255 do
    begin
      SI := SL.IndexOf(CSFrom[X]);
      if SI >= 0 then
        Charset[X] := SI
      else
        Charset[X] := MissingChar;
    end;
  finally
    SL.Free;
  end;
end;

// Uses the Shell Sort algorithm to sort a list of 255 AnsiStrings.
// The actual list isn't changed - but an array of array index values
// is returned containing the sorted order
function SortCharsetNames(CSList: TPDFCharsetNames): TPDFCharsetValues;
var
  I, J, K: Integer;
  Temp: Byte;
begin
  for I := 0 to 255 do
    Result[I] := I;
  K := 127;
  while K > 0 do
  begin
    for I := 0 to 255 - K do
    begin
      J := I;
      while (J >= 0) and (CSList[Result[J]] > CSList[Result[J + K]]) do
      begin
        Temp := Result[J];
        Result[J] := Result[J + K];
        Result[J + K] := Temp;
        if J > K then
        begin
          Dec(J, K);
        end else
        begin
          J := 0;
        end;
      end;
    end;
    K := K shr 1;
  end;
end;

procedure GetWinAnsiDisplay(CSFrom: TPDFCharsetNames;
  var Charset: TPDFCharsetDisplay);
var
  Item: AnsiString;
  I: Integer;
begin
  for I := 0 to 255 do
  begin
    CharSet[I] := GetWinAnsiFromUnicode(GetGlyphUnicode(CSFrom[I]));
    if (CharSet[I] = #0) then
    begin
      if QPLCopy(CSFrom[I], 1, 4) = 'CID:' then
      begin
        Item := QPLCopy(CSFrom[I], 5, Length(CSFrom[I]) - 4);
        CharSet[I] := GetWinAnsiFromUnicode(QPLStrToInt(Item));
      end;
    end;
  end;
end;

procedure GetUnicode(CSFrom: TPDFCharsetNames;
  var Charset: TPDFCharsetWide);
var
  I: Integer;
begin
  for I := 0 to 255 do
  begin
    CharSet[I] := WideChar(GetGlyphUnicode(CSFrom[I]));
  end;
end;

procedure ApplyDifferencesArray(var CS: TPDFCharsetNames; Differences: TPDFArray);
var
  X: Integer;
  Obj: TPDFObject;
  Offset: Integer;
begin
  Offset := 0;
  for X := 0 to Differences.Count - 1 do
  begin
    Obj := Differences.Item[X];
    if Obj is TPDFNumeric then
      Offset := TPDFNumeric(Obj).AsInteger;
    if Obj is TPDFName then
    begin
      if (Offset >= Low(CS)) and (Offset <= High(CS)) then
        CS[Offset] := TPDFName(Obj).Name;
      Inc(Offset);
    end;
  end;
end;

procedure GetAFMWidths(FontID: Integer; Names: TPDFCharsetNames; var Widths: TPDFCharsetWidths);
var
  SL: TQuickPDFCaseSensitiveStringList;
  X: Integer;
  I: Integer;
begin
  SL := TQuickPDFCaseSensitiveStringList.Create;
  try
    if (FontID >= 1) and (FontID <= 12) then
    begin
      for X := 1 to 229 do
        SL.Add(CharNames[X]);
      for X := 0 to 255 do
      begin
        I := SL.IndexOf(Names[X]) + 1;
        if I > 0 then
        begin
          Widths[X] := AFMFontWidths[FontID, I];
        end else
          Widths[X] := 750;
      end;
    end else
    if (FontID = 13) then
    begin
      for X := 1 to 189 do
        SL.Add(SymbolCharNames[X]);
      for X := 0 to 255 do
      begin
        I := SL.IndexOf(Names[X]) + 1;
        if I > 0 then
        begin
          Widths[X] := SymbolWidths[I];
        end else
          Widths[X] := 750;
      end;
    end else
    if (FontID = 14) then
    begin
      for X := 32 to 254 do
        Widths[X] := ZapfDingbatsWidths[X];
    end;
  finally
    SL.Free;
  end;
end;

procedure GetGlyphUnicodeValues(List: TQuickPDFCaseSensitiveStringList);
var
  X: Integer;
begin
  List.Clear;
  for X := 1 to 229 do
    List.AddObject(CharNames[X], TObject(UnicodeValues[X]));
  List.Sort;
end;

function GetCharID(const CharName: AnsiString):  Integer;
begin
  Result := SLCharNames.IndexOf(CharName) + 1;
end;

function GetWinAnsiFromPDFDoc(const PDFDocStr: AnsiString): AnsiString;
var
  X: Integer;
  WC: WideChar;
  WS: WideString;
begin
  Result := PDFDocStr;
  if QPLCopy(Result, 1, 2) = #$FE#$FF then
  begin
    WS := '';
    for X := 1 to (Length(Result) - 2) div 2 do
    begin
      WC := WideChar((Ord(Result[X * 2 + 1]) shl 8) + Ord(Result[X * 2 + 2]));
      WS := WS + WC;
    end;
    Result := QPLWideStringToAnsiString(WS);
  end else
  begin
    for X := 1 to Length(Result) do
      Result[X] := AnsiChar(PDFDocToWinAnsi[Ord(Result[X])]);
  end;
end;

function GetWideStringFromPDFDoc(const PDFDocStr: AnsiString): WideString;
var
  X: Integer;
  WC: WideChar;
  WS: WideString;
begin
  Result := '';
  if QPLCopy(PDFDocStr, 1, 2) = #$FE#$FF then
  begin
    SetLength(WS, (Length(PDFDocStr) - 2) div 2);
    for X := 1 to Length(WS) do
    begin
      WC := WideChar((Ord(PDFDocStr[X * 2 + 1]) shl 8) + Ord(PDFDocStr[X * 2 + 2]));
      WS[X] := WC;
    end;
    if (Length(WS) * 2 + 2) < Length(PDFDocStr) then
    begin
      // There is an extra byte at the end
      SetLength(WS, Length(WS) + 1);
      WS[Length(WS)] := WideChar((Ord(PDFDocStr[Length(PDFDocStr)]) shl 8));
    end;
  end else
  begin
    SetLength(WS, Length(PDFDocStr));
    for X := 1 to Length(WS) do
      WS[X] := PDFDocUnicode[Ord(PDFDocStr[X])];
  end;
  Result := WS;
end;

function GetUTF8FromPDFDoc(const PDFDocStr: AnsiString): AnsiString;
begin
  Result := QPLUTF8Encode(GetWideStringFromPDFDoc(PDFDocStr));
end;

function GetPDFDocFromWinAnsi(const WinAnsiStr: AnsiString): AnsiString;
var
  X: Integer;
begin
  Result := WinAnsiStr;
  if QPLCopy(Result, 1, 2) <> #$FE#$FF then
  begin
    for X := 1 to Length(Result) do
      Result[X] := AnsiChar(WinAnsiToPDFDoc[Ord(Result[X])]);
  end;
end;

function GetPDFDocFromWideString(const WS: WideString): AnsiString;
var
  X: Integer;
  PU: Integer;
  Match: Boolean;
  OutputLength: Integer;
begin
  OutputLength := 0;
  SetLength(Result, Length(WS));
  for X := 1 to Length(WS) do
  begin
    Match := False;
    PU := 0;
    while (PU <= 255) and (not Match) do
    begin
      if PDFDocUnicode[PU] = WS[X] then
      begin
        Match := True;
        Inc(OutputLength);
        Result[OutputLength] := AnsiChar(PU);
      end;
      Inc(PU);
    end;
  end;
  SetLength(Result, OutputLength);
end;

{$IFNDEF QPL_OS_WINDOWS}
function ScreenFonts(Charset: Integer = DEFAULT_CHARSET; Flags: Integer = 0): TQuickPDFStringList;
begin
  if (Length(LocalScreenFonts) = 0) then
  begin
    SetLength(LocalScreenFonts, 1);
    LocalScreenFonts[0] := TQuickPDFStringList.Create;
  end;
  Result := LocalScreenFonts[0];
end;
{$ELSE}
function EnumFontsProc(var LogFont: TEnumLogFontExA; var TextMetric: TTextMetric;
  FontType: Integer; Data: Pointer): Integer; stdcall;
var
  S: TQuickPDFStringList;
  Temp: AnsiString;
begin
  S := TQuickPDFStringList(Data);
  Temp := LogFont.elfLogFont.lfFaceName;
  if ((S.Count = 0) or (QPLAnsiCompareText(S[S.Count - 1], Temp) <> 0)) and (Temp[1] <> '@') then
    S.Add(Temp);
  Result := 1;
end;

function ScreenFonts(Charset: Integer; Flags: Integer): TQuickPDFStringList;
var
  DC: HDC;
  LFont: TEnumLogFontA;
  X: Integer;
  Index: Integer;
begin

  Index := -1;
  X := 0;
  while ((Index < 0) and (X < Length(LocalScreenFontsCharset))) do
  begin
    if (LocalScreenFontsCharset[X] = Charset) then
    begin
      Index := X;
    end else
    begin
      Inc(X);
    end;
  end;

  if Index < 0 then
  begin
    Index := Length(LocalScreenFontsCharset);
    SetLength(LocalScreenFontsCharset, Index + 1);
    SetLength(LocalScreenFonts, Index + 1);
    LocalScreenFontsCharset[Index] := Charset;
    LocalScreenFonts[Index] := TQuickPDFStringList.Create;
    DC := GetDC(0);
    try
      FillChar(LFont, SizeOf(LFont), 0);
      LFont.elfLogFont.lfCharSet := Charset;
      EnumFontFamiliesExA(DC, LFont.elfLogFont, @EnumFontsProc, TQPLIntPtr(LocalScreenFonts[Index]), 0);
      LocalScreenFonts[Index].Sorted := True;
    finally
      ReleaseDC(0, DC);
    end;
  end;

  Result := LocalScreenFonts[Index];

end;
{$ENDIF}

function GetGlyphUnicode(const GlyphName: AnsiString): Word;
var
  TGN: AnsiString;
  SearchStart: Integer;
  C: AnsiChar;
  GL: Integer;
  Found: Boolean;
  GlyphNameLength: Integer;
begin
  Result := 0;
  Found := False;

  GL := Length(GlyphList);

  GlyphNameLength := Length(GlyphName);
  if (GlyphNameLength > 0) then
  begin
    C := GlyphName[1];
    if (C >= 'A') then
    begin
      SearchStart := (Ord(C) - 65) * 3 + 1;
      SearchStart := Ord(GlyphList[SearchStart]) +
        Ord(GlyphList[SearchStart + 1]) shl 8 +
        Ord(GlyphList[SearchStart + 2]) shl 16;
      TGN := GlyphName;
      while ((Result = 0) and (TGN[1] = GlyphName[1]) and (SearchStart < GL)) do
      begin
        if (Ord(GlyphList[SearchStart]) = GlyphNameLength) then
        begin
          TGN := QPLCopy(GlyphList, SearchStart + 1, Ord(GlyphList[SearchStart]));
          Inc(SearchStart, Ord(GlyphList[SearchStart]) + 1);
          if TGN = GlyphName then
            Result := Ord(GlyphList[SearchStart]) + Ord(GlyphList[SearchStart + 1]) shl 8;
          Inc(SearchStart, 2);
        end else
        begin
          Inc(SearchStart, Ord(GlyphList[SearchStart]) + 3);
        end;
      end;
    end;

    if (not Found) then
    begin
      if (Length(GlyphName) >= 2) and (GlyphName[1] = 'C') then
      begin
        TGN := QPLCopy(GlyphName, 2, MaxInt);
        for GL := 1 to Length(TGN) do
          if (TGN[GL] < '0') or (TGN[GL] > '9') then
            Found := True;

        if not Found then
          Result := QPLStrToInt(TGN);
      end;
    end;
  end;
end;

function GetDingbats: AnsiString;
var
  ResourceStream: TResourceStream;
begin
  if Length(Dingbats) = 0 then
  begin
{$IFNDEF QPL_CPP}
    ResourceStream := TResourceStream.CreateFromID(HInstance, 15903, RT_RCDATA);
    try
      SetLength(Dingbats, ResourceStream.Size);
      ResourceStream.Read(Dingbats[1], Length(Dingbats));
      Result := InflateStr(Dingbats);
    finally
      ResourceStream.Free;
    end;
{$ENDIF}
  end else
    Result := InflateStr(Dingbats);
end;

function GetUnicodeGlyph(const C: WideChar): AnsiString;
var
  Found: Boolean;
  FontIndex: Integer;
begin
  // Search the standard PostScript names
  Found := False;
  FontIndex := 0;
  while ((not Found) and (FontIndex < 229)) do
  begin
    Inc(FontIndex);
    if (UnicodeValues[FontIndex] = Ord(C)) then
    begin
      Result := CharNames[FontIndex];
      Found := True;
    end;
  end;

  if (not Found) then
  begin
    // Search the Symbol names
    FontIndex := 0;
    while ((not Found) and (FontIndex < 189)) do
    begin
      Inc(FontIndex);
      if (SymbolUnicodeValues[FontIndex] = Ord(C)) then
      begin
        Result := SymbolCharNames[FontIndex];
        Found := True;
      end;
    end;
  end;
end;

