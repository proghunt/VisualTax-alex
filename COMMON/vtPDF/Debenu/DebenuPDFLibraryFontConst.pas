function GetWinAnsiFromUnicode(UnicodeChar: Word): AnsiChar;
var
  X: Integer;
  Found: Boolean;
begin
  Result := #0;
  X := 0;
  Found := False;
  repeat
    Inc(X);
    if (UnicodeValues[X] = UnicodeChar) then
    begin
      Result := AnsiChar(WinAnsiEncodingVector[X]);
      Found := True;
    end;
  until (Found or (X >= 229));
end;

initialization
  SLCharNames := TQuickPDFCaseSensitiveStringList.Create;
  while SLCharNames.Count < 229 do
    SLCharNames.Add(CharNames[SLCharNames.Count + 1]);
  SetLength(LocalScreenFonts, 0);
  SetLength(LocalScreenFontsCharset, 0);
{$IFNDEF QPL_CPP}
  with TResourceStream.CreateFromID(HInstance, 15902, RT_RCDATA) do
  begin
    SetLength(GlyphList, Size);
    Read(GlyphList[1], Length(GlyphList));
    GlyphList := InflateStr(GlyphList);
    Free;
  end;
{$ENDIF}
  InitPDFDocUnicode;
finalization
  while Length(LocalScreenFonts) > 0 do
  begin
    LocalScreenFonts[Length(LocalScreenFonts) - 1].Free;
    SetLength(LocalScreenFonts, Length(LocalScreenFonts) - 1);
  end;
  SLCharNames.Free;
end.
