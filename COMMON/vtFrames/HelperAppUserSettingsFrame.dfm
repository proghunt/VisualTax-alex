object frameHelperAppUserSettings: TframeHelperAppUserSettings
  Left = 0
  Top = 0
  Width = 451
  Height = 333
  Align = alClient
  TabOrder = 0
  OnResize = FrameResize
  ExplicitHeight = 304
  object lbl1: TLabel
    Left = 0
    Top = 29
    Width = 451
    Height = 78
    Align = alTop
    Caption = 
      '  The path to the storage directory is relative to the applicati' +
      'on directory. For example, if you specify the path "%APPID%" and' +
      ' use application "vtCloud" from Microsophic Inc., the full path ' +
      'to the cloud will be "https://www.dropbox.com/home/apps/vtCloud/' +
      '%APPID%".'#13#10'  You can use subfolders to separate destination dire' +
      'ctory between users. For example, for the user "ADMIN" directory' +
      ' will be "%APPID%/ADMIN", and for user "John" - "%APPID%/JOHN".'
    Color = clInfoBk
    ParentColor = False
    Transparent = False
    WordWrap = True
    ExplicitTop = 63
  end
  object lbl2: TLabel
    Left = 0
    Top = 130
    Width = 451
    Height = 39
    Align = alTop
    Caption = 
      '  You can automatically save all returns on cloud storage. This ' +
      'will happen whenever you save a return to the hard disk. '#13#10'  If ' +
      'this option is enabled, then in the window "Save As ..." is auto' +
      'matically set flag in the field with the name of the cloud helpe' +
      'r in the "Storage" section.'#13#10'  You can also enable or disable th' +
      'e one-time saving return to the cloud storage.'
    Color = clInfoBk
    ParentColor = False
    Transparent = False
    WordWrap = True
    ExplicitTop = 132
    ExplicitWidth = 733
  end
  object chbSaveReturnToCloud: TCheckBox
    Left = 0
    Top = 107
    Width = 451
    Height = 23
    Align = alTop
    Caption = #1040'utomatically save returns on the cloud'
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -11
    Font.Name = 'Tahoma'
    Font.Style = [fsBold]
    ParentFont = False
    TabOrder = 0
    OnClick = chbSaveReturnToCloudClick
  end
  object grpAdvanced: TGroupBox
    Left = 0
    Top = 169
    Width = 451
    Height = 248
    Align = alTop
    Caption = 'Advanced'
    TabOrder = 1
    Visible = False
    object lblClientIDHelp: TLabel
      Left = 2
      Top = 41
      Width = 447
      Height = 52
      Align = alTop
      Caption = 
        'This string is similar to the "ZiitdmqTrEAAAAAAAAAA1qK6GpiGD6Pv-' +
        '5S747sHYxTL95dfVDmKGt7QH_fDF", which is generated by the server ' +
        'to login to the site using the API.'#13#10'This field can be left blan' +
        'k. In this case, to access cloud storage every time the resoluti' +
        'on will need to confirm.'#13#10'If you are using your own application ' +
        'for working with cloud storage, you can generate the string on t' +
        'he website and copy it into this field. To do this, go to "https' +
        '://www.dropbox.com/developers/apps", select your application and' +
        ' click "Generated access token" button.'
      Color = clInfoBk
      ParentColor = False
      Transparent = False
      WordWrap = True
      ExplicitWidth = 824
    end
    object lbl3: TLabel
      Left = 2
      Top = 116
      Width = 447
      Height = 26
      Align = alTop
      Caption = 
        'If this option is enabled, then after the first confirmation of ' +
        'permission to access cloud storage "Access token" will be saved ' +
        'in the box above. All subsequent calls to the site will use this' +
        ' "Access Tine". No need to re-enter your login / password and co' +
        'nfirm the access permission.'
      Color = clInfoBk
      ParentColor = False
      Transparent = False
      WordWrap = True
      ExplicitTop = 110
      ExplicitWidth = 867
    end
    object chbSaveConnectionSettings: TCheckBox
      Left = 2
      Top = 93
      Width = 447
      Height = 23
      Align = alTop
      Caption = 'Save connection settings'
      Font.Charset = DEFAULT_CHARSET
      Font.Color = clWindowText
      Font.Height = -11
      Font.Name = 'Tahoma'
      Font.Style = [fsBold]
      ParentFont = False
      TabOrder = 0
      OnClick = chbSaveConnectionSettingsClick
    end
    object pnl2: TPanel
      Left = 2
      Top = 15
      Width = 447
      Height = 26
      Align = alTop
      BevelOuter = bvNone
      TabOrder = 1
      DesignSize = (
        447
        26)
      object Label1: TLabel
        Left = 8
        Top = 4
        Width = 98
        Height = 13
        Caption = 'Access Key (Token):'
      end
      object edtToken: TEdit
        Left = 136
        Top = 1
        Width = 303
        Height = 21
        Anchors = [akLeft, akTop, akRight]
        PasswordChar = '*'
        TabOrder = 0
        OnChange = edtTokenChange
      end
    end
  end
