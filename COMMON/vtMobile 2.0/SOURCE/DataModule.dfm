  object qryClients: TFDQuery
    Connection = conMain
    SQL.Strings = (
      
        'Select Cl.ID, Cl.LAST_NAME||'#39' '#39'||Cl.FIRST_NAME AS Name, '#39'SIN: '#39'|' +
        '|CAST(Cl.SIN as VARCHAR(20))||'#39'; Doc count: '#39'||CAST(COUNT(D.ID) ' +
        'as VARCHAR(3)) as Detail'
      'from Clients Cl'
      '  Left Outer Join Documents D ON Cl.ID = D.ClientID'
      'Group By'
      '  Cl.ID, Cl.LAST_NAME, Cl.FIRST_NAME, Cl.SIN'
      'Order By 2')
    Left = 72
    Top = 104
    object qryClientsID: TFDAutoIncField
      FieldName = 'ID'
      Origin = 'ID'
      ProviderFlags = [pfInWhere, pfInKey]
      ReadOnly = True
    end
    object qryClientsName: TWideStringField
      AutoGenerateValue = arDefault
      FieldName = 'Name'
      Origin = 'Name'
      ProviderFlags = []
      ReadOnly = True
      Size = 32767
    end
    object qryClientsDetail: TWideStringField
      AutoGenerateValue = arDefault
      FieldName = 'Detail'
      Origin = 'Detail'
      ProviderFlags = []
      ReadOnly = True
      Size = 32767
    end
  end
  object qryDocuments: TFDQuery
    BeforeOpen = qryDocumentsBeforeOpen
    Connection = conMain
    SQL.Strings = (
      'Select D.ID, D.ClientID, D.DocumentName, DT.DocumentType'
      'from Documents as D'
      
        '  Left Outer Join DocumentTypes as DT ON  D.DocumentTypeID = DT.' +
        'ID'
      'WHERE'
      '  D.ClientID = :ClientID'
      'Order By DT.DocumentType,'
      '  D.DocumentName')
    Left = 128
    Top = 104
    ParamData = <
      item
        Name = 'CLIENTID'
        ParamType = ptInput
      end>
    object qryDocumentsID: TFDAutoIncField
      FieldName = 'ID'
      Origin = 'ID'
      ProviderFlags = [pfInWhere, pfInKey]
      ReadOnly = True
    end
    object qryDocumentsClientID: TIntegerField
      FieldName = 'ClientID'
      Origin = 'ClientID'
      Required = True
    end
    object qryDocumentsDocumentName: TStringField
      FieldName = 'DocumentName'
      Origin = 'DocumentName'
      Required = True
      Size = 400
    end
    object qryDocumentsDocumentType: TStringField
      AutoGenerateValue = arDefault
      FieldName = 'DocumentType'
      Origin = 'DocumentType'
      ProviderFlags = []
      ReadOnly = True
      Size = 255
    end
  end
  object qryDoc: TFDQuery
    BeforeOpen = qryDocBeforeOpen
    Connection = conMain
    SQL.Strings = (
      'Select '
      '  D.DocumentName, DF.FileExtension, D.DocumentData'
      'from Documents D'
      
        '  LEFT OUTER JOIN DocumentFormat DF ON D.DocumentFormatID = DF.I' +
        'D'
      'Where D.ID = :ID')
    Left = 176
    Top = 104
    ParamData = <
      item
        Name = 'ID'
        DataType = ftInteger
        FDDataType = dtInt32
        ParamType = ptInput
      end>
    object qryDocDocumentName: TStringField
      FieldName = 'DocumentName'
      Origin = 'DocumentName'
      Required = True
      Size = 400
    end
    object qryDocFileExtension: TStringField
      AutoGenerateValue = arDefault
      FieldName = 'FileExtension'
      Origin = 'FileExtension'
      ProviderFlags = []
      ReadOnly = True
      Size = 255
    end
    object qryDocDocumentData: TBlobField
      FieldName = 'DocumentData'
      Origin = 'DocumentData'
    end
  end
