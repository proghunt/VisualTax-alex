<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{9A5C8982-FE50-43BB-A6FE-A3D5AB823F89}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="vtMobileAndr.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="vtFillDB.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="vtMobileAndr">
        <MSBuild Projects="vtMobileAndr.dproj"/>
    </Target>
    <Target Name="vtMobileAndr:Clean">
        <MSBuild Projects="vtMobileAndr.dproj" Targets="Clean"/>
    </Target>
    <Target Name="vtMobileAndr:Make">
        <MSBuild Projects="vtMobileAndr.dproj" Targets="Make"/>
    </Target>
    <Target Name="vtFillDB">
        <MSBuild Projects="vtFillDB.dproj"/>
    </Target>
    <Target Name="vtFillDB:Clean">
        <MSBuild Projects="vtFillDB.dproj" Targets="Clean"/>
    </Target>
    <Target Name="vtFillDB:Make">
        <MSBuild Projects="vtFillDB.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="vtMobileAndr;vtFillDB"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="vtMobileAndr:Clean;vtFillDB:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="vtMobileAndr:Make;vtFillDB:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
