  object ClientsQuery: TFDQuery
    Connection = vtMobileConnection
    SQL.Strings = (
      'select'
      '  C.ID,'
      '  (C.FIRST_NAME|| '#39' '#39' || C.LAST_NAME) as Name'
      'from'
      '  Users U'
      '  LEFT Outer Join ClientUsers CU ON U.Id = CU.UserId'
      '  Inner Join Clients C ON CU.ClientId = C.Id OR U.IsAdmin = 1'
      'WHERE'
      '  U.Id = :UserId')
    Left = 80
    Top = 120
    ParamData = <
      item
        Name = 'USERID'
        DataType = ftInteger
        FDDataType = dtInt32
        ParamType = ptInput
      end>
  end
