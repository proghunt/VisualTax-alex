  object DocumentsQuery: TFDQuery
    IndexFieldNames = 'ClientID'
    MasterSource = ClientsDS
    MasterFields = 'ID'
    Connection = vtMobileConnection
    SQL.Strings = (
      
        'select Documents.ID, Documents.DocumentName, Documents.DocumentD' +
        'ata, DocumentFormat.FileExtension, DocumentFormat.Picture, Docum' +
        'ents.ClientID from Documents join DocumentFormat on DocumentForm' +
        'at.ID = Documents.DocumentFormatID')
    Left = 160
    Top = 120
  end
