package AnyDAC_Comp_D5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'da-soft AnyDAC Components Package for Delphi 5'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  vcldb50,
  vclx50,
{$IFDEF AnyDAC_SynEdit}
  SynEdit_R5,
{$ENDIF}  
  AnyDAC_ComI_D5,
  AnyDAC_Phys_D5,
  AnyDAC_PhysSQLite_D5;

contains
  uADCompDataMove,
  uADCompDataSet,
  uADCompClient,
  uADCompScript,
  uADCompGUIx,  
  uADCompScriptCommands,
  uADCompADOUDLImport,
  uADPhysSQLiteVDataSet,
  uADGUIxManager,
  uADGUIxFormsWait,  
  uADGUIxFormsfAsync,
  uADGUIxFormsfError,
  uADGUIxFormsfFetchOptions,
  uADGUIxFormsfFormatOptions,
  uADGUIxFormsfLogin,
  uADGUIxFormsfOptsBase,
  uADGUIxFormsfUpdateOptions,
  uADGUIxFormsfConnEdit,
  uADGUIxFormsfQEdit,
  uADGUIxFormsfUSEdit,
  uADGUIxFormsfResourceOptions,
  uADGUIxFormsControls,
  uADGUIxFormsfScript,
  uADGUIxFormsMemo,
  uADGUIxFormsfDesignTimeOptions,
  uADGUIxFormsfFields,
  uADGUIxConsoleWait,
  uADGUIxConsoleScript;

end.
