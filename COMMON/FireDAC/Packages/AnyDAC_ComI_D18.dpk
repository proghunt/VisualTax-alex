package AnyDAC_ComI_D18;

{$IFDEF MSWINDOWS}
  {$R *.res}
{$ENDIF}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'da-soft AnyDAC ComI Package for Delphi XE4'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

{$I uAD.inc}

requires
  rtl,
  dbrtl,
  xmlrtl;

contains
  uADStanIntf,
  uADGUIxIntf,
  uADPhysIntf,
  uADDAptIntf,
  uADStanFactory,
  uADStanError,
  uADStanConst,
  uADStanOption,
  uADStanParam,
  uADStanUtil,
  uADStanCipher,
  uADDatSManager,
  uADDAptColumn,
  uADStanResStrs,
  uADStanAsync,
  uADStanDef,
  uADStanExpr,
  uADStanExprFuncs,
  uADStanPool,
  uADStanStorage,
  uADStanSQLTimeInt;

end.
