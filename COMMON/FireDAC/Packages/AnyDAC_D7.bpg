#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = AnyDAC_ComI_D7.bpl AnyDAC_Phys_D7.bpl AnyDAC_PhysODBC_D7.bpl AnyDAC_PhysMSAcc_D7.bpl \
  AnyDAC_PhysMSSQL_D7.bpl AnyDAC_PhysDb2_D7.bpl AnyDAC_PhysASA_D7.bpl AnyDAC_PhysADS_D7.bpl \
  AnyDAC_PhysMySQL_D7.bpl AnyDAC_PhysOracle_D7.bpl AnyDAC_PhysIB_D7.bpl AnyDAC_PhysDBExp_D7.bpl \
  AnyDAC_PhysPG_D7.bpl AnyDAC_PhysSQLite_D7.bpl AnyDAC_Comp_D7.bpl AnyDAC_GUIxForms_D7.bpl \
  AnyDAC_Dcl_D7.bpl
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

AnyDAC_GUIxForms_D7.bpl: AnyDAC_GUIxForms_D7.dpk
  $(DCC)

AnyDAC_Phys_D7.bpl: AnyDAC_Phys_D7.dpk
  $(DCC)

