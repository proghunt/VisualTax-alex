package AnyDAC_PhysTDBX_D15;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'da-soft AnyDAC Phys TDBX Package for Delphi XE'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

{$I uAD.inc}

requires
  rtl,
  dbrtl,
  dbexpress,
  dsnap,
  AnyDAC_ComI_D15,
  AnyDAC_Phys_D15,
{$IFNDEF AnyDAC_ProSKU}
  DBXSybaseASADriver,
  DBXSybaseASEDriver,
  DBXOracleDriver,
  DBXMSSQLDriver,
  DBXInformixDriver,
  DBXDb2Driver,
  DBXFirebirdDriver,
{$ENDIF}
  DbxClientDriver,
  DBXInterBaseDriver,
  DBXMySQLDriver;

contains
  uADPhysTDBX,
  uADPhysTDBXMeta,
  uADPhysTDBXBase;

end.
