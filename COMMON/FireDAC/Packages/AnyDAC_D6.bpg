AnyDAC_PhysPG_D6.bpl: AnyDAC_PhysPG_D6.dpk
  $(DCC)

AnyDAC_PhysSQLite_D6.bpl: AnyDAC_PhysSQLite_D6.dpk
  $(DCC)

AnyDAC_PhysDb2_D6.bpl: AnyDAC_PhysDb2_D6.dpk
  $(DCC)

AnyDAC_PhysODBC_D6.bpl: AnyDAC_PhysODBC_D6.dpk
  $(DCC)

AnyDAC_PhysASA_D6.bpl: AnyDAC_PhysASA_D6.dpk
