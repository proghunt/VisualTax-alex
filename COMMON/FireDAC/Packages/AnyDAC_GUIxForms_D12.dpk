package AnyDAC_GUIxForms_D12;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'da-soft AnyDAC GUIx Forms Package for Delphi 2009'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

{$I uAD.inc}

requires
  rtl,
  vcl,
  dbrtl,
  vclx,
  vcldb,
{$IFDEF AnyDAC_SynEdit}
  SynEdit_R2009,
{$ENDIF}
  AnyDAC_ComI_D12,
  AnyDAC_Comp_D12;

contains
  uADGUIxManager,
  uADGUIxFormsfAbout,
  uADGUIxFormsfAsync,
  uADGUIxFormsfError,
  uADGUIxFormsfFetchOptions,
  uADGUIxFormsfFormatOptions,
  uADGUIxFormsfLogin,
  uADGUIxFormsfOptsBase,
  uADGUIxFormsfUpdateOptions,
  uADGUIxFormsfConnEdit,
  uADGUIxFormsfQEdit,
  uADGUIxFormsfUSEdit,
  uADGUIxFormsfResourceOptions,
  uADGUIxFormsControls,
  uADGUIxFormsfScript,
  uADGUIxFormsMemo,
  uADGUIxFormsfDesignTimeOptions,
  uADGUIxFormsfFields,
  uADGUIxFormsWait,
  uADGUIxConsoleWait,
  uADGUIxConsoleScript;

end.

