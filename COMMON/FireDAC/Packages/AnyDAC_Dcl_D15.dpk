package AnyDAC_Dcl_D15;
{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Embarcadero FireDAC Components'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

{$I uAD.inc}

requires
  designide,
  rtl,
  vcl,
  dbrtl,
  vclactnband,
  vclx,
  dcldb,
  vcldesigner,
  dclstd,
  vcldb,
  AnyDAC_Comp_D15,
  AnyDAC_ComI_D15,
  AnyDAC_GUIxForms_D15,
  AnyDAC_Phys_D15,
  AnyDAC_PhysODBC_D15,
  AnyDAC_PhysMSAcc_D15,
  AnyDAC_PhysMSSQL_D15,
  AnyDAC_PhysDB2_D15,
  AnyDAC_PhysMySQL_D15,
  AnyDAC_PhysOracle_D15,
  AnyDAC_PhysASA_D15,
  AnyDAC_PhysADS_D15,
{$IFDEF AnyDAC_DBX}
  AnyDAC_PhysTDBX_D15,
{$ENDIF}
  AnyDAC_PhysIB_D15,
  AnyDAC_PhysPG_D15,
  AnyDAC_PhysSQLite_D15;

contains
  uADCompReg;

end.
