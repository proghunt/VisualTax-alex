package AnyDAC_PhysTDBX_D18;

{$IFDEF MSWINDOWS}
  {$R *.res}
{$ENDIF}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'da-soft AnyDAC Phys TDBX Package for Delphi XE4'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

{$I uAD.inc}

requires
  rtl,
  dbrtl,
  dbexpress,
  dsnap,
  AnyDAC_ComI_D18,
  AnyDAC_Phys_D18,
{$IFNDEF AnyDAC_ProSKU}
  {$IFNDEF AnyDAC_Mobile}
  DBXSybaseASADriver,
  DBXOracleDriver,
  DBXInformixDriver,
  DBXFirebirdDriver,
    {$IFDEF MSWINDOWS}
  DBXSybaseASEDriver,
  DBXMSSQLDriver,
  DBXDb2Driver,
  DBXODBCDriver,
    {$ENDIF}
  DataSnapCommon,
  DataSnapServer,
  {$ENDIF}
  DataSnapClient,
{$ENDIF}
  DbxClientDriver,
{$IFNDEF AnyDAC_Mobile}
  DBXMySQLDriver,
{$ENDIF}
  DBXInterbaseDriver;

contains
  uADPhysTDBXBase,
{$IFNDEF AnyDAC_ProSKU}
  uADPhysDataSnap,
  uADPhysDataSnapMeta,
  uADPhysDataSnapProxyDelphi,
  uADPhysDataSnapProxyCpp,
{$ENDIF}
  uADPhysTDBX,
  uADPhysTDBXMeta;

end.
