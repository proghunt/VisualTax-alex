package AnyDAC_Dcl_D7;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Embarcadero FireDAC Components'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

{$I uAD.inc}

requires
  designide,
  rtl,
  vcl,
  dbrtl,
  vclactnband,
  vclx,
  dcldb,
  vcldesigner,
  designdgm,
  dclstd,
  vcldb,
  AnyDAC_Comp_D7,
  AnyDAC_ComI_D7,
  AnyDAC_GUIxForms_D7,
  AnyDAC_Phys_D7,
  AnyDAC_PhysODBC_D7,
  AnyDAC_PhysMSAcc_D7,
  AnyDAC_PhysMSSQL_D7,
  AnyDAC_PhysDB2_D7,
  AnyDAC_PhysMySQL_D7,
  AnyDAC_PhysOracle_D7,
  AnyDAC_PhysASA_D7,
{$IFDEF AnyDAC_DBX}
  AnyDAC_PhysDBExp_D7,
{$ENDIF}
  AnyDAC_PhysADS_D7,
  AnyDAC_PhysIB_D7,
  AnyDAC_PhysPG_D7,
  AnyDAC_PhysSQLite_D7;

contains
  uADCompReg;

end.
