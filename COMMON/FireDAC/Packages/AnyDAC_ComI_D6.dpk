package AnyDAC_ComI_D6;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'da-soft AnyDAC Common Package for Delphi 6'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  dbrtl,
  xmlrtl;

contains
  uADStanIntf,
  uADGUIxIntf,
  uADPhysIntf,
  uADDAptIntf,
  uADStanFactory,
  uADStanError,
  uADStanConst,
  uADStanOption,
  uADStanParam,
  uADStanUtil,
  uADStanCipher,
  uADDatSManager,
  uADDAptColumn,
  uADStanResStrs,
  uADStanAsync,
  uADStanDef,
  uADStanExpr,
  uADStanExprFuncs,
  uADStanPool,
  uADStanStorage,
  uADStanSQLTimeInt;

end.
