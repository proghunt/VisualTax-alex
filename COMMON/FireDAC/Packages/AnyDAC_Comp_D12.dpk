package AnyDAC_Comp_D12;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'da-soft AnyDAC Components Package for Delphi 2009'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  dbrtl,
  AnyDAC_ComI_D12,
  AnyDAC_Phys_D12,
  AnyDAC_PhysSQLite_D12;

contains
  uADCompDataMove,
  uADCompDataSet,
  uADCompClient,
  uADCompGUIx,
  uADCompScript,
  uADCompScriptCommands,
  uADCompADOUDLImport,
  uADPhysSQLiteVDataSet;

end.
