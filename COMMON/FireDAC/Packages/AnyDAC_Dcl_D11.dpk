package AnyDAC_Dcl_D11;
{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Embarcadero FireDAC Components'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  designide,
  rtl,
  vcl,
  dbrtl,
  vclactnband,
  vclx,
  dcldb,
  vcldesigner,
  dclstd,
  vcldb,
  AnyDAC_Comp_D11,
  AnyDAC_ComI_D11,
  AnyDAC_GUIxForms_D11,
  AnyDAC_Phys_D11,
  AnyDAC_PhysODBC_D11,
  AnyDAC_PhysMSAcc_D11,
  AnyDAC_PhysMSSQL_D11,
  AnyDAC_PhysDB2_D11,
  AnyDAC_PhysMySQL_D11,
  AnyDAC_PhysOracle_D11,
  AnyDAC_PhysASA_D11,
  AnyDAC_PhysADS_D11,
  AnyDAC_PhysIB_D11,
  AnyDAC_PhysPG_D11,
  AnyDAC_PhysSQLite_D11,
  DbxCommonDriver,
  DataSnapClient,
  DataSnapCommon,
  DbxClientDriver,
  CustomIPTransport,
  dbexpress,
  DBXMySQLDriver,
  DBXInterBaseDriver,
  DBXFirebirdDriver,
  DBXSybaseASEDriver,
  DBXSybaseASADriver,
  DBXOracleDriver,
  DBXMSSQLDriver,
  DBXInformixDriver,
  DBXDb2Driver;

contains
  uADCompReg;

end.
