package AnyDAC_Dcl_D5;

{$R *.RES}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Embarcadero FireDAC Components'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  vcl50,
  Vcldb50,
  AnyDAC_Comp_D5,
  AnyDAC_ComI_D5,
  AnyDAC_Phys_D5,
  AnyDAC_PhysODBC_D5,
  AnyDAC_PhysMSAcc_D5,
  AnyDAC_PhysMSSQL_D5,
  AnyDAC_PhysDB2_D5,
  AnyDAC_PhysMySQL_D5,
  AnyDAC_PhysOracle_D5,
  AnyDAC_PhysASA_D5,
  AnyDAC_PhysADS_D5,
  AnyDAC_PhysIB_D5,
  AnyDAC_PhysPg_D5,
  AnyDAC_PhysSQLITE_D5;

contains
  uADCompReg;

end.
