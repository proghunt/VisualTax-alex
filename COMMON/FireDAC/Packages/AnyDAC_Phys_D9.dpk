package AnyDAC_Phys_D9;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'da-soft AnyDAC Phys Package for Delphi 2005'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

{$I uAD.inc}

requires
  rtl,
  dbrtl,
  AnyDAC_ComI_D9;

contains
  uADPhysManager,
  uADPhysStatic,
  uADPhysCmdPreprocessor,
  uADPhysCmdGenerator,
  uADPhysConnMeta,
  uADPhysDB2Meta,
  uADPhysMSSQLMeta,
  uADPhysMSAccMeta,
  uADPhysMySQLMeta,
  uADPhysOracleMeta,
  uADPhysASAMeta,
  uADPhysADSMeta,
  uADPhysIBMeta,
  uADPhysPGMeta,
  uADPhysSQLiteMeta,
  uADPhysNexusMeta,
  uADDAptManager
{$IFDEF AnyDAC_MONITOR}
  , uADMoniBase,
  uADMoniRemoteBase,
  uADMoniRemoteClient,
  uADMoniRemoteServer,
  uADMoniCustom,
  uADStanTracer,
  uADMoniFlatFile
{$ENDIF}
  ;

end.
