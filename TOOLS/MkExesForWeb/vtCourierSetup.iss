; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "vtCourier"
#define MyAppVersion "1.0"
#define MyAppPublisher "Virtual Office Tower"
#define MyAppURL "https://virtualofficetower.com"
#define MyAppExeName "vtCourier.exe"
#define data "C:\vtClient"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{3327D913-015A-4C14-80B4-B41BC7B9E16A}
UsePreviousAppDir=no
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName=C:\vtClient
DefaultGroupName={#MyAppPublisher}
DisableProgramGroupPage=no
AllowNoIcons=yes
OutputDir=..\ReadyForWeb
OutputBaseFilename=vtCourierSetup
Compression=lzma
SolidCompression=yes
AppendDefaultDirName=no
UninstallDisplayIcon={app}\{#MyAppExeName}
PrivilegesRequired=admin 
SignTool=MsSign $f

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; 
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked; OnlyBelowVersion: 0,6.1

[Files]
Source: "..\BIN\vtCourier.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\BIN\libeay32.dll"; DestDir: "{app}"; Flags: onlyifdoesntexist
Source: "..\BIN\ssleay32.dll"; DestDir: "{app}"; Flags: onlyifdoesntexist

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Flags: createonlyiffileexists
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: quicklaunchicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""vtCourier Out"" program=""{app}\{#MyAppExeName}"" dir=out action=allow enable=yes"; Flags: runhidden;
Filename: "certutil.exe"; Parameters: "-addstore -f Root {app}\VisualTax.cer"; StatusMsg: "Adding trusted publisher..."; 

[Dirs]
Name: "C:\VT\T1-2020\ClientDocs"

[Code]

#expr Exec(AddBackslash(SourcePath) + "Certificate\_SignAll.bat")
