SHOW.RESULTS:
 CLOSE #2:OPEN "SCRN:" FOR OUTPUT AS #2
 WIDTH #2, 65
 ''FL$=LEFT$(RTUNUMBER$,8)+".RTU"
 SPEC$=EFILEDIR$+"\"+FL$
 OPEN SPEC$ FOR INPUT AS #1
 PRINT #2, SPACE$(15)+"CONTENTS OF RTU FILE: "+FL$
 LINCNT=1
 DO UNTIL EOF(1)
 INPUT #1, a$
 FOR j = 1 TO 40
  k = j - 1
  j1 = k * 65 + 1
  B$ = MID$(a$, j1, 65)
  IF B$ = "" THEN EXIT FOR
  PRINT #2, B$:LINCNT=LINCNT+1
  IF LINCNT>20 THEN
    LOCATE 24,10:COLOR 0,7:PRINT "Hit Enter to continue, C to cancel ";:COLOR 7,0
    WHILE INKEY$="":WEND
    A$=INKEY$:IF UCASE$(A$)="C" THEN CLOSE #2:RETURN
    LINCNT=1
  END IF
 NEXT
 LOOP
 CLOSE #1:CLOSE #2
RETURN

