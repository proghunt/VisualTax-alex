CHECK.EXIST:
 IF SPEC$ = "" THEN              'Make sure Spec$ isn't nul
    EXIST% = 0
    RETURN
 END IF
 FilName$ = SPACE$(13)           'Initialize for call to MhFind
 CALL MhFind(SPEC$ + CHR$(0), 63, FilName$, 1, ECODE)
 FilName$ = ""                   ' No longer needed
 IF ECODE THEN
    EXIST% = 0                   '0=DOES NOT EXIST
 ELSE
    EXIST% = -1                  '<>0  Exist to true
 END IF
RETURN

