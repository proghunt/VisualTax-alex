GET.AMOUNT:
 IF LEFT$(RULE$,1)="" THEN
    IF TSCRNO=1 THEN
      LAMOUNT! = V(LLINE)
    ELSE
      TBEG=SBEG(TSCRNO):GOSUB SDO.MFETCH:LAMOUNT!=VAL(LIN$):ORIGLIN$=LIN$
    END IF
 ELSE
    IF LEFT$(RULE$,1)="R" THEN GOSUB DO.RULES 'RETURNS LAMOUNT
 END IF

 IF LLINE=550 AND V(546)=0 THEN LAMOUNT!=0
 GOSUB CHECK.OVERRIDES
 'PRINT "LLINE,AMOUNT->",LLINE$,LAMOUNT!
 IF LAMOUNT! = 0 THEN RETURN

 IF UCASE$(LTYPE$) = "$" OR UCASE$(LTYPE$)="N" THEN LAMOUNT# = INT(LAMOUNT!)
 IF UCASE$(LTYPE$) = "C" THEN LAMOUNT# = INT(LAMOUNT! * 100) 'CENTS
 LAMOUNT$ = LTRIM$(STR$(ABS(LAMOUNT#))): IF LAMOUNT# < 0 THEN LAMOUNT$ = "&" + LAMOUNT$
 IF LLINE$="985" THEN LAMOUNT$=L985$
 IF LLINE$="003" THEN
   IF LEN(LAMOUNT$)=5 THEN LAMOUNT$="0"+LAMOUNT$
 END IF
 IF LLINE$="003" OR LLINE$="702" OR LLINE$="703" OR LLINE$="704" OR LLINE$="705" OR LLINE$="706" OR LLINE$="707" THEN
   LAMOUNT$=ORIGLIN$
 END IF
 LNAMT$ = LLINE$ + LAMOUNT$ + "-"
 FREEREC$ = FREEREC$ + LNAMT$
RETURN

CHECK.OVERRIDES:
 TBEG=SBEG(258)
 FOR J=6 TO 16 STEP 2
    ELM=J:GOSUB SDO.MFETCH
    IF LLINE=VAL(LIN$) THEN
      ELM=J+1:GOSUB SDO.MFETCH:LAMOUNT!=VAL(LIN$)
    END IF
 NEXT
RETURN

