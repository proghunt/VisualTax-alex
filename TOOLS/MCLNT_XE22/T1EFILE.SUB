 ' 'GOSUB CALC.CONDITION
 ' 'IF TOTCOND!>40000 AND LAMOUNT!=0 THEN LAMOUNT!=1

 'CASE 694   'FROM AMT
 '  TBEG = SBEG(67): ELM% = 3: GOSUB SDO.MFETCH:IF VAL(LIN$)>0 THEN LAMOUNT!=VAL(LIN$) ELSE LAMOUNT!=0
 ' 'LAST YEAR
 ' 'X!=0
 ' 'FOR J=101 TO 104 'T4A LUMP SUM
 ' ' TBEG = SBEG(J): ELM% = 3: GOSUB SDO.MFETCH: X! = X!+VAL(LIN$)
 ' 'NEXT
 ' 'LAMOUNT!=V(207)+V(208)-X!
 ' 'IF LAMOUNT!<0 THEN LAMOUNT!=1

  CASE 914   'LTD LOSS/T5013
    TBEG = SBEG(211): ELM% =15: GOSUB SDO.MFETCH: X! = VAL(LIN$)
    TBEG = SBEG(212): ELM% =15: GOSUB SDO.MFETCH: Y! = VAL(LIN$)
    TBEG = SBEG(213): ELM% =15: GOSUB SDO.MFETCH: Z! = VAL(LIN$)
    LAMOUNT!=X!+Y!+Z!
  CASE 160   'RENT GROSS
    LAMOUNT!=V(160)
    IF V(126) >< 0 THEN
      IF V(160) <= 0 THEN LAMOUNT!=1
    END IF
  CASE 952   'RRSP ANNUITies
    LAMOUNT!=0
    FOR J=106 TO 109
     TBEG = SBEG(J): ELM% = 2: GOSUB SDO.MFETCH: LAMOUNT!=LAMOUNT!+VAL(LIN$)
    NEXT
  ' TBEG = SBEG(257): ELM% = 1: GOSUB SDO.MFETCH:X!=VAL(LIN$):'FIELD 780/HOME BYERS
    TBEG = SBEG(257): ELM% = 6: GOSUB SDO.MFETCH:Y!=VAL(LIN$):'FIELD 781/NON ELIGBLE AMT
    LAMOUNT!=LAMOUNT!-Y!
    IF LAMOUNT!<0 THEN LAMOUNT!=0
  CASE 162   'BUSI GROSS
    LAMOUNT!=V(162)
    IF V(135) >< 0 THEN
      IF V(162) <= 0 THEN LAMOUNT!=1
    END IF
  CASE 164   'PROF GROSS
    LAMOUNT!=V(164)
    IF V(137) >< 0 THEN
      IF V(164) <= 0 THEN LAMOUNT!=1
    END IF
  CASE 166   'COMM GROSS
    LAMOUNT!=V(166)
    IF V(139) >< 0 THEN
      IF V(166) <= 0 THEN LAMOUNT!=1
    END IF
  CASE 168   'GROSS FARM
    LAMOUNT!=V(168)
    IF V(141) >< 0 THEN
      IF V(168) <= 0 THEN LAMOUNT!=1
    END IF
  CASE 170   'GROSS FISH
    LAMOUNT!=V(170)
    IF V(170) >< 0 THEN
      IF V(170) <= 0 THEN LAMOUNT!=1
    END IF
  CASE 658   'MANIT T5007
    TBEG = SBEG(100): ELM% = 19: GOSUB SDO.MFETCH
    IF PROVINCE$="M" THEN LAMOUNT!=VAL(LIN$) ELSE LAMOUNT!=0

