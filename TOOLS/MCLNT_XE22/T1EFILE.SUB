'              T1EFILE.SUB
SUB T1EFILE (OPER$, V() AS SINGLE,TS$(), TV() AS SINGLE, SELEM%(), SBEG%(), SUPD%(), ARRAYNUMBER%,TSCRNO%, PRV$, PRVSHORTNM$,AUTHNM$,CPLSW%,CURRENTSPOUSE%,OTHERSPOUSE%,AGE%,EFILEDIR$,RTUNUMBER$) STATIC

'???? CHANGE 32200 OF CPP EARN/DONE IN 93 AS 33400
 TXYR$="1995"
 MXUILIM52!=42380:
 MXUILIM53!=43195:
 MXUILIM54!=44010:
 MXCPPLIM!=34900
 CRLF$=""    '''CHR$(13)+CHR$(10)
 DEFINT A-Z
'' REM $DYNAMIC
 IF FIRSTSW=0 THEN
 ' HDR
  DIM HDR.RECLEN         AS STRING * 4
  DIM HDR.RECTYPE        AS STRING * 2
  DIM HDR.TRANSMTYPE     AS STRING * 2
  DIM HDR.TRANSMITTERNO  AS STRING * 5
  DIM HDR.PREPARERID     AS STRING * 5
  DIM HDR.INDRES1        AS STRING * 10
  DIM HDR.INDRES2        AS STRING * 10
  DIM HDR.DATE           AS STRING * 8
  DIM HDR.TIME           AS STRING * 6
  DIM HDR.TRANSFLNO      AS STRING * 8
  DIM HDR.FILLER1        AS STRING * 40

 ' T1REC FIXED PART
  DIM FX.RECLEN          AS STRING * 4
  DIM FX.RECTYPE         AS STRING * 2
  DIM FX.PREPARERNO      AS STRING * 5
  DIM FX.SEQNO           AS STRING * 8
  DIM FX.PREPPSWD        AS STRING * 7
  DIM FX.DISCNUMBER      AS STRING * 8
  DIM FX.SIN             AS STRING * 9
  DIM FX.BIRTHDD         AS STRING * 2
  DIM FX.BIRTHMM         AS STRING * 2
  DIM FX.BIRTHYYYY       AS STRING * 4
  DIM FX.PRVOFRES        AS STRING * 2
  DIM FX.PRVOFTAX        AS STRING * 2
  DIM FX.MARSTATUS       AS STRING * 1
  DIM FX.SPOUSESIN       AS STRING * 9
  DIM FX.SPOUSENAME      AS STRING * 4
  DIM FX.FIRSTNAME       AS STRING * 30
  DIM FX.LASTNAME        AS STRING * 30
  DIM FX.CAREOFNAME      AS STRING * 26
  DIM FX.STREET          AS STRING * 30
  DIM FX.CITY            AS STRING * 28
  DIM FX.PROVINCE        AS STRING * 2
  DIM FX.POSTAL          AS STRING * 6
  DIM FX.CLAREA          AS STRING * 3
  DIM FX.CLPHONE         AS STRING * 7
  DIM FX.NAMECHANGE      AS STRING * 1
  DIM FX.ALTADDR         AS STRING * 2
  DIM FX.LANGUAGE        AS STRING * 1
  DIM FX.GSTYESNO        AS STRING * 1
  DIM FX.KIDSUNDER19     AS STRING * 2
  DIM FX.SPOUSENETINC    AS STRING * 9
  DIM FX.SFDRECS         AS STRING * 2
  DIM FX.DEVELOPER       AS STRING * 3
  DIM FX.SOFTCODE        AS STRING * 1
  DIM FX.SOFTRELEASE     AS STRING * 6
  DIM FX.FILLER1         AS STRING * 9
  DIM FX.FDEADLINE       AS STRING * 1

 'SFD FIXEDTYPE -----------
  DIM SFD.RECLEN         AS STRING * 4
  DIM SFD.RECTYPE        AS STRING * 2
  DIM SFD.PREPARERNO     AS STRING * 5
  DIM SFD.SEQNO          AS STRING * 8
  DIM SFD.SFDREC         AS STRING * 2
  DIM SFD.BUSTYPE        AS STRING * 1
  DIM SFD.SIC            AS STRING * 4
  DIM SFD.BUSNAME        AS STRING * 30
  DIM SFD.BUSADDRESS     AS STRING * 30
  DIM SFD.BUSPOSTAL      AS STRING * 6
  DIM SFD.BUSFISCSTART   AS STRING * 8
  DIM SFD.BUSFISCEND     AS STRING * 8

  DIM SFD.ACROWNED       AS STRING * 9
  DIM SFD.ACRFARMED      AS STRING * 9
  DIM SFD.ACCMETHOD      AS STRING * 1

  DIM SFD.BUSPARTNID     AS STRING * 9
  DIM SFD.BUSPERCENT     AS STRING * 2
  DIM SFD.BUSTAXSHELTNO  AS STRING * 8
  DIM SFD.BUSFINALYR     AS STRING * 1
  DIM SFD.GSTACCNO       AS STRING * 15

 'SEND
  DIM SEND.RECLEN        AS STRING * 4
  DIM SEND.RECTYPE       AS STRING * 2
  DIM SEND.PREPARERNO    AS STRING * 5
  DIM SEND.SEQNO         AS STRING * 8
  DIM SEND.PREPPSWD      AS STRING * 7
  DIM SEND.DISCNUMBER    AS STRING * 8
  DIM SEND.SIN           AS STRING * 9
  DIM SEND.BIRTHDD       AS STRING * 2
  DIM SEND.BIRTHMM       AS STRING * 2
  DIM SEND.BIRTHYYYY     AS STRING * 4
  DIM SEND.FIRSTNAME     AS STRING * 30
  DIM SEND.LASTNAME      AS STRING * 30
  DIM SEND.NAMECHANGE    AS STRING * 1
  DIM SEND.DEVELOPER     AS STRING * 3
  DIM SEND.SOFTCODE      AS STRING * 1
  DIM SEND.SOFTRELEASE   AS STRING * 6
  DIM SEND.FILLER1       AS STRING * 9
  DIM SEND.FILLER2       AS STRING * 6

 ' TRL
  DIM TRL.RECLEN         AS STRING * 4
  DIM TRL.RECTYPE        AS STRING * 2
  DIM TRL.RETURNS        AS STRING * 4
  DIM TRL.SFDRECS        AS STRING * 4
  DIM TRL.TRANSMRECS     AS STRING * 4

ELSE
  FIRSTSW=1
END IF
'------------------------------------
 SOFTRELEASE$="123095"
 DEVELOPER$="030"
IF PRINTSW$="" THEN
END IF
IF LEFT$(OPER$,1)="H" THEN
  TOTSFDRECS=0:TOTT1RECS=0
  GOSUB GET.PREPARER
  GOSUB GET.EFILEPARMS
  IF OPER$="HR" THEN FL$=LEFT$(RTUNUMBER$,8)+".RTU" ELSE FL$=LEFT$(RTUNUMBER$,8)+".RTS"
  OPEN EFILEDIR$+"\"+FL$ FOR OUTPUT AS #3
  GOSUB PREPARE.HDR
  CLOSE #3
END IF
IF OPER$="AR" THEN GOSUB BUILD.T1RECORDS
IF OPER$="AS" THEN GOSUB PREPARE.SEND:GOSUB APPEND.SEND
IF LEFT$(OPER$,1)="T" THEN
  GOSUB PREPARE.TRL


  IF RIGHT$(FL$,3)="RTU" THEN
    CLS
    INPUT "SHOW RTU DATA? (Y/N) ",SHOWSW$
    IF UCASE$(SHOWSW$)="Y" THEN
      FL$=LEFT$(RTUNUMBER$,8)+".RTU"
      GOSUB SHOW.RESULTS
    END IF
    SHOWSW$="":PRINTSW$=""
    PRINT "--------------------------------------------"
    SHOWSW$="":PRINTSW$=""
  END IF
END IF
CLOSE #3
 HDRREC$=""
 FXREC$=""
 FREEREC$=""
 TRLREC$=""
 SFDREC$=""
 SENDREC$=""
EXIT SUB


NODECIMAL:
'INPUT : LIN$  RESULT: LIN$ ROUNDED WITH NO DECIMALS
X!=VAL(LIN$)
X! = X! * 100 + 50
X! = X! / 100
X! = INT(X!):LIN$=STR$(X!)
RETURN

ENCRYPT.RTU:
 PRINT " "
 FL$=LEFT$(RTUNUMBER$,8)+".RTU"
 EFILEDIR$=LTRIM$(RTRIM$(EFILEDIR$))
 FROMFL$=EFILEDIR$+"\"+FL$
 TOFL$=EFILEDIR$+"\"+LEFT$(RTUNUMBER$,8)+".ENC"
 COMMANDSTRING$=MOBIUSDIR$+"\ENC /n "+FROMFL$+" "+TOFL$
 PRINT "Encrypting file... "+FROMFL$
 SHELL(COMMANDSTRING$)
 PRINT " ":PRINT "Encryption of RTU ended"
RETURN

ENCRYPT.SEND:
 PRINT " "
 FL$=LEFT$(RTUNUMBER$,8)+".RTS"
 EFILEDIR$=LTRIM$(RTRIM$(EFILEDIR$))
 FROMFL$=EFILEDIR$+"\"+FL$
 TOFL$=EFILEDIR$+"\"+LEFT$(RTUNUMBER$,8)+".SEN"
 COMMANDSTRING$=MOBIUSDIR$+"\ENC /n "+FROMFL$+" "+TOFL$
 PRINT "Encrypting file... "+FROMFL$
 SHELL(COMMANDSTRING$)
 PRINT " ":PRINT "Encryption of SEND ended"
RETURN

PREPARE.HDR:
 HDRREC$=""
 HDR.RECLEN="0100":HDR.RECTYPE="01"
 IF OPER$="HR" THEN HDR.TRANSMTYPE=T1TRANSMTYPE$ ELSE HDR.TRANSMTYPE=SENDTRANSMTYPE$
 HDR.TRANSMITTERNO=TRANSMITTERNO$
 HDR.PREPARERID=PREPARERNO$
 HDR.INDRES1=RTUNUMBER$+"0000000000"
 ''HDR.INDRES1="0000000000"
 HDR.INDRES2="0000000000"
 HDR.DATE="00000000"
 HDR.TIME="000000"
 HDR.TRANSFLNO="00000000"
 HDR.FILLER1="00000000000000000000000000000000000000000"

 HDRREC$=HDR.RECLEN+HDR.RECTYPE+HDR.TRANSMTYPE+HDR.TRANSMITTERNO+HDR.PREPARERID
 HDRREC$=HDRREC$+HDR.INDRES1+HDR.INDRES2+HDR.DATE+HDR.TIME+HDR.TRANSFLNO+HDR.FILLER1
 PRINT #3, HDRREC$+CRLF$
 IF PRINTSW$="S" THEN PRINT HDRREC$
 IF PRINTSW$="P" THEN LPRINT HDRREC$
 HDRREC$=""
RETURN

PREPARE.T1REC:
 '----------------------
 'FIXED PART
 '----------------------
   FX.RECTYPE="02"
   FX.PREPARERNO=PREPARERNO$
   FX.PREPPSWD=PASSWORD$
   TBEG=SBEG(5):ELM=18:GOSUB SDO.MFETCH
   IF LIN$ = "3" THEN FX.DISCNUMBER=DISCNUMBER$ ELSE FX.DISCNUMBER="00000000"
   TBEG=SBEG(3): 'IDENT
     ELM=1:GOSUB SDO.MFETCH:FX.SIN=LIN$ 'IDENT
     FX.SEQNO=LEFT$(FX.SIN,8)
     ELM=10:GOSUB SDO.MFETCH:FX.BIRTHDD=LIN$
     ELM=11:GOSUB SDO.MFETCH:FX.BIRTHMM=LIN$
     ELM=12:GOSUB SDO.MFETCH:FX.BIRTHYYYY=LIN$
     ELM=6 :GOSUB SDO.MFETCH:GOSUB CONVERT.PROV:
     FX.PRVOFRES=PROV$
     FX.PRVOFTAX=PROV$
     ELM=5:GOSUB SDO.MFETCH:FX.MARSTATUS=LIN$
     ELM=8:GOSUB SDO.MFETCH:FX.SPOUSESIN=LIN$:IF LIN$="" THEN FX.SPOUSESIN="000000000"
     ELM=9:GOSUB SDO.MFETCH:FX.SPOUSENAME=LIN$
     ELM=3:GOSUB SDO.MFETCH:FIRST$=LIN$
     ELM=4:GOSUB SDO.MFETCH:LAST$=LEFT$(LIN$,30)
     FX.FIRSTNAME=FIRST$
     FX.LASTNAME=LAST$

   TBEG=SBEG(5): 'ADDRESS
   FX.CAREOFNAME=CAREOFNAME$
   ELM=1:GOSUB SDO.MFETCH:FX.STREET=LIN$
   ELM=2:GOSUB SDO.MFETCH:FX.CITY=LIN$
   ELM=3:GOSUB SDO.MFETCH:FX.PROVINCE=LIN$ ''NEED CURRENT LIVING PROVINCE
   ELM=4:GOSUB SDO.MFETCH:A$=LIN$
   ELM=5:GOSUB SDO.MFETCH:B$=LIN$:FX.POSTAL=A$+B$
   ELM=6:GOSUB SDO.MFETCH:A$=LIN$  'AREA
   ELM=7:GOSUB SDO.MFETCH:B$=LIN$  'PHONE
   IF VAL(A$)=0 THEN  A$="000"
   AA$ = MID$(B$, 4, 1)
   IF AA$ < "0" OR AA$ > "9" THEN
      B$ = LEFT$(B$, 3) + RIGHT$(B$, 4)
   END IF
   IF VAL(B$)=0 THEN B$="0000000":A$="000"
   IF B$="0000000" THEN A$="000"
   FX.CLAREA=A$
   FX.CLPHONE=B$
   ELM=8:GOSUB SDO.MFETCH:FX.NAMECHANGE=LIN$
 '  TBEG=SBEG(5):ELM=19:GOSUB SDO.MFETCH:IF LIN$="" THEN FX.RECTAXCENTRE=RECTAXCENTRE$ ELSE FX.RECTAXCENTRE=LIN$
 '  FX.RECTAXCENTRE=RECTAXCENTRE$
   TBEG=SBEG(5):ELM=9:GOSUB SDO.MFETCH:IF LIN$="Y" THEN LIN$="1" ELSE LIN$="2"
     FX.GSTYESNO=LIN$
     ELM=11:GOSUB SDO.MFETCH:FX.KIDSUNDER19=LIN$:LIN$=FX.KIDSUNDER19:GOSUB JUST.RIGHT:FX.KIDSUNDER19=LIN$

   TBEG = SBEG(5): ELM% =22: GOSUB SDO.MFETCH:FX.ALTADDR=LIN$
   TBEG = SBEG(5): ELM% =9: GOSUB SDO.MFETCH
   IF UCASE$(LIN$)="Y" THEN 'CLAIM GST
     TBEG = SBEG(17): ELM% =23: GOSUB SDO.MFETCH:GOSUB NODECIMAL:FX.SPOUSENETINC=LTRIM$(RTRIM$(LIN$))
     IF VAL(LIN$) <= 0 THEN FX.SPOUSENETINC="000000000"
   ELSE
     FX.SPOUSENETINC="000000000"
   END IF
 ' X!=INT(V(547)):FX.SPOUSENETINC=LTRIM$(STR$(X!)):IF V(547)<=0 THEN FX.SPOUSENETINC="000000000"
   LIN$=FX.SPOUSENETINC:GOSUB JUST.RIGHT:FX.SPOUSENETINC=LIN$
   GOSUB COUNT.SFDRECS
   IF OPSNUMBER>7 THEN OPSNUMBER=7
   LIN$=STR$(OPSNUMBER):FX.SFDRECS=LIN$:LIN$=FX.SFDRECS:GOSUB JUST.RIGHT:FX.SFDRECS=LIN$
   FX.DEVELOPER=DEVELOPER$
   FX.SOFTCODE=" "
   FX.SOFTRELEASE = SOFTRELEASE$
   FX.FILLER1 = "000000000"
   TBEG = SBEG(5): ELM% =23: GOSUB SDO.MFETCH
   FX.FDEADLINE = LIN$:IF LIN$ = "" THEN FX.FDEADLINE="0"

 '----------------------
 'FREE FORMAT PART
  FREEREC$=""
  OPEN "T1EFLINE.D" FOR INPUT AS #2
  DO WHILE NOT EOF(2)
   INPUT #2, LLINE$,LTYPE$,TSCRNO,ELM%,RULE$
   LLINE=VAL(LLINE$)
   GOSUB GET.AMOUNT
   GOSUB PRINT.LINES
  LOOP
  CLOSE #2
 ''FREEREC$ = FREEREC$ + "4691"  'ENGL LANG
 IF RIGHT$(FREEREC$,1)="-" THEN FREEREC$=LEFT$(FREEREC$,LEN(FREEREC$)-1)
RETURN

PRINT.LINES:
   IF UCASE$(PRINTSW$)="S" THEN PRINT STR$(LLINE)+" "+LAMOUNT$+" , ";
   IF UCASE$(PRINTSW$)="P" THEN LPRINT STR$(LLINE)+" "+LAMOUNT$+" , ";
RETURN

PREPARE.SEND:
   SEND.RECLEN = ␀"0137"
   SEND.RECTYPE = "04"
   SEND.PREPARERNO=PREPARERNO$
   TBEG=SBEG(3): ELM=1:GOSUB SDO.MFETCH:SEND.SIN=LIN$ 'IDENT
   SEND.SEQNO=LEFT$(SEND.SIN,8)
   SEND.PREPPSWD=PASSWORD$
   SEND.DISCNUMBER=DISCNUMBER$
   TBEG=SBEG(3)
   ELM=10:GOSUB SDO.MFETCH:SEND.BIRTHDD=LIN$
   ELM=11:GOSUB SDO.MFETCH:SEND.BIRTHMM=LIN$
   ELM=12:GOSUB SDO.MFETCH:SEND.BIRTHYYYY=LIN$
   ELM=3:GOSUB SDO.MFETCH:FIRST$=LIN$
   ELM=4:GOSUB SDO.MFETCH:LAST$=LEFT$(LIN$,26)
   SEND.FIRSTNAME=FIRST$   ''+"<"+LAST$
   SEND.LASTNAME=LAST$   ''+"<"+LAST$
   TBEG=SBEG(5):ELM=8:GOSUB SDO.MFETCH:SEND.NAMECHANGE=LIN$
   SEND.DEVELOPER =DEVELOPER$
   SEND.SOFTCODE =" "
   SEND.SOFTRELEASE = SOFTRELEASE$
   SEND.FILLER1 ="000000000"
   SEND.FILLER2 ="000000"
RETURN

ASSEMBLE.SENDREC:
   SENDREC$=SEND.RECLEN+SEND.RECTYPE+SEND.PREPARERNO+SEND.SEQNO+SEND.PREPPSWD
   SENDREC$=SENDREC$+SEND.DISCNUMBER+SEND.SIN+SEND.BIRTHDD+SEND.BIRTHMM+SEND.BIRTHYYYY
   SENDREC$=SENDREC$+SEND.FIRSTNAME+SEND.LASTNAME+SEND.NAMECHANGE+SEND.DEVELOPER+SEND.SOFTCODE+SEND.SOFTRELEASE
   SENDREC$=SENDREC$+SEND.FILLER1+SEND.FILLER2
RETURN

PREPARE.TRL:
 IF OPER$="TR" THEN FL$=LEFT$(RTUNUMBER$,8)+".RTU" ELSE FL$=LEFT$(RTUNUMBER$,8)+".RTS"
 OPEN EFILEDIR$+"\"+FL$ FOR APPEND AS #3
 TRLREC$=""
 TRL.RECLEN="0018"
 TRL.RECTYPE="99"

 LIN$=STR$(TOTT1RECS)
 TRL.RETURNS=LIN$:LIN$=TRL.RETURNS:GOSUB JUST.RIGHT:TRL.RETURNS=LIN$
 LIN$=STR$(TOTSFDRECS)
 TRL.SFDRECS=LIN$:LIN$=TRL.SFDRECS:GOSUB JUST.RIGHT:TRL.SFDRECS=LIN$
 IF OPER$="TS" THEN TRL.SFDRECS="0000"
 X=VAL(TRL.RETURNS)+VAL(TRL.SFDRECS):LIN$=STR$(X)
 TRL.TRANSMRECS=LIN$:LIN$=TRL.TRANSMRECS:GOSUB JUST.RIGHT:TRL.TRANSMRECS=LIN$

 TRLREC$=TRL.RECLEN+TRL.RECTYPE+TRL.RETURNS+TRL.SFDRECS+TRL.TRANSMRECS

 PRINT #3, TRLREC$+CRLF$
 IF PRINTSW$="S" THEN PRINT TRLREC$
 IF PRINTSW$="P" THEN LPRINT TRLREC$
 CLOSE #3:TRLREC$=""
RETURN

COUNT.SFDRECS:
 OPSNUMBER=0
  IF SUPD(81)>0 THEN OPSNUMBER=OPSNUMBER+1 'FIRST BUS STATEMENT
  IF SUPD(271)>0 THEN OPSNUMBER=OPSNUMBER+1 'SECOND BUS STATEMENT
  IF V(164)>0 OR (V(137)><0) THEN OPSNUMBER=OPSNUMBER+1
  IF V(168)>0 OR (V(141)><0) THEN OPSNUMBER=OPSNUMBER+1
  IF V(170)>0 OR (V(143)><0) THEN OPSNUMBER=OPSNUMBER+1

  IF V(160)>0 OR (V(126)><0) THEN
     FOR RENTNDX=241 TO 247:
       TBEG=SBEG(RENTNDX):ELM%=12:GOSUB SDO.MFETCH:X!=VAL(LIN$)
       ELM%=59:GOSUB SDO.MFETCH:Y!=VAL(LIN$)
       ELM%=58:GOSUB SDO.MFETCH:Z!=VAL(LIN$)
       IF (X!><0) OR (Y!><0) OR (Z!><0) THEN
           OPSNUMBER=OPSNUMBER+1:
           IF OPSNUMBER>7 THEN RETURN
       END IF
     NEXT
  END IF
RETURN

BUILD.T1RECORDS:
 FREEREC$ = ""
 TBEG=SBEG(3):ELM%=6:GOSUB SDO.MFETCH:PROVINCE$=LIN$
 GOSUB PREPARE.T1REC
 GOSUB APPEND.T1REC
 'SFD RECORDS
 OPSNUMBER=0
  IF V(162)+V(166) > 0 OR (V(135)+V(139) ><0 ) THEN
    IF SUPD(81)>0 THEN BUSTSCRNO=81:GOSUB PREPARE.BUSINESS:GOSUB APPEND.SFDREC
    IF SUPD(271)>0 THEN BUSTSCRNO=271:GOSUB PREPARE.BUSINESS:GOSUB APPEND.SFDREC
  END IF
  IF V(164)>0 OR (V(137)><0) THEN GOSUB PREPARE.PROFESSION:GOSUB APPEND.SFDREC
  IF V(168)>0 OR (V(141)><0) THEN GOSUB PREPARE.FARMING:GOSUB APPEND.SFDREC
  IF V(170)>0 OR (V(143)><0) THEN GOSUB PREPARE.FISHING:GOSUB APPEND.SFDREC

  IF V(160)>0 OR (V(126)><0) THEN
     FOR RENTNDX=241 TO 247:
       TBEG=SBEG(RENTNDX):ELM%=12:GOSUB SDO.MFETCH:X!=VAL(LIN$)
       ELM%=59:GOSUB SDO.MFETCH:Y!=VAL(LIN$)
       ELM%=58:GOSUB SDO.MFETCH:Z!=VAL(LIN$)
       IF (X!><0) OR (Y!><0) OR (Z!><0) THEN
           RENTEF=RENTNDX+20  'SO IT GIVES 261, ETC FOR EF RENT DATA SCRNO
           GOSUB PREPARE.RENTAL
           GOSUB APPEND.SFDREC
       END IF
     NEXT
  END IF
 FREEREC$ = ""
RETURN

ASSEMBLE.T1REC:
 X=269+LEN(FREEREC$):LIN$=STR$(X):GOSUB JUST.RIGHT:FX.RECLEN=LIN$
  FXREC$=FX.RECLEN+FX.RECTYPE+FX.PREPARERNO+FX.SEQNO+FX.PREPPSWD+FX.DISCNUMBER+FX.SIN
  FXREC$=FXREC$+FX.BIRTHDD+FX.BIRTHMM+FX.BIRTHYYYY+FX.PRVOFRES+FX.PRVOFTAX
  FXREC$=FXREC$+FX.MARSTATUS+FX.SPOUSESIN+FX.SPOUSENAME+FX.FIRSTNAME+FX.LASTNAME
  FXREC$=FXREC$+FX.CAREOFNAME+FX.STREET+FX.CITY+FX.PROVINCE+FX.POSTAL+FX.CLAREA+FX.CLPHONE
  FXREC$=FXREC$+FX.NAMECHANGE+FX.ALTADDR+"1"+FX.GSTYESNO+FX.KIDSUNDER19+FX.SPOUSENETINC
  FXREC$=FXREC$+FX.SFDRECS+FX.DEVELOPER+FX.SOFTCODE+FX.SOFTRELEASE+FX.FILLER1+FX.FDEADLINE
 RETURN

ASSEMBLE.SFDREC:
 X=162+LEN(FREEREC$):LIN$=STR$(X):GOSUB JUST.RIGHT:SFD.RECLEN=LIN$
'' X=212+LEN(FREEREC$):LIN$=STR$(X):GOSUB JUST.RIGHT:SFD.RECLEN=LIN$
  SFDREC$=SFD.RECLEN+SFD.RECTYPE+SFD.PREPARERNO+SFD.SEQNO+SFD.SFDREC
  SFDREC$=SFDREC$+SFD.BUSTYPE+SFD.SIC
  SFDREC$=SFDREC$+SFD.BUSNAME+SFD.BUSADDRESS+SFD.BUSPOSTAL
  SFDREC$=SFDREC$+SFD.BUSFISCSTART+SFD.BUSFISCEND+SFD.ACROWNED+SFD.ACRFARMED+SFD.ACCMETHOD+SFD.BUSPARTNID
  SFDREC$=SFDREC$+SFD.BUSPERCENT+SFD.BUSTAXSHELTNO+SFD.BUSFINALYR+SFD.GSTACCNO
 RETURN

APPEND.T1REC:

' LOCATE 24,50:PRINT "APPENDING T1REC ";:WHILE INKEY$="":WEND
  FL$=LEFT$(RTUNUMBER$,8)+".RTU"
  SPEC$=EFILEDIR$+"\"+FL$:GOSUB CHECK.EXIST
  IF EXIST% >< 0 THEN  'EXISTS
    OPEN SPEC$ FOR APPEND AS #3
     GOSUB ASSEMBLE.T1REC
     PRINT #3, FXREC$+FREEREC$+CRLF$
    CLOSE #3:FXREC$="":FREEREC$=""
    TOTT1RECS=TOTT1RECS+1
  END IF
RETURN

APPEND.SFDREC:
' LOCATE 24,50:PRINT "APPENDING SFDREC ";:WHILE INKEY$="":WEND
  IF OPSNUMBER>7 THEN RETURN
  FL$=LEFT$(RTUNUMBER$,8)+".RTU"
  SPEC$=EFILEDIR$+"\"+FL$:GOSUB CHECK.EXIST
  IF EXIST% >< 0 THEN  'EXISTS
    OPEN SPEC$ FOR APPEND AS #3
     GOSUB ASSEMBLE.SFDREC
     PRINT #3, SFDREC$+FREEREC$+CRLF$
    CLOSE #3:SFDREC$="":FREEREC$=""
    TOTSFDRECS=TOTSFDRECS+1
  END IF
RETURN

APPEND.SEND:
  FL$=LEFT$(RTUNUMBER$,8)+".RTS"
  SPEC$=EFILEDIR$+"\"+FL$:GOSUB CHECK.EXIST
  IF EXIST% >< 0 THEN  'EXISTS
    OPEN SPEC$ FOR APPEND AS #3
    GOSUB ASSEMBLE.SENDREC
    PRINT #3, SENDREC$+CRLF$
    CLOSE #3:SENDREC$=""
    TOTT1RECS=TOTT1RECS+1
  END IF
RETURN

JUST.RIGHT:
 LENLIN=LEN(LIN$)
 A$=LTRIM$(RTRIM$(LIN$)):LENA=LEN(A$)
 LIN$=STRING$(LENLIN-LENA,"0")+A$
RETURN

CONVERT.PROV:
    IF LIN$="1" THEN PROV$="ON"
    IF LIN$="2" THEN PROV$="AB"
    IF LIN$="3" THEN PROV$="BC"
    IF LIN$="4" THEN PROV$="NS"
    IF LIN$="5" THEN PROV$="NB"
    IF LIN$="6" THEN PROV$="SK"
    IF LIN$="7" THEN PROV$="NF"
    IF LIN$="8" THEN PROV$="YT"
    IF LIN$="9" THEN PROV$="NT"
    IF UCASE$(LIN$)="M" THEN PROV$="MB"
    IF UCASE$(LIN$)="P" THEN PROV$="PE"
    IF UCASE$(LIN$)="Q" THEN PROV$="QC"
RETURN

PREPARE.RENTAL:
  SFD.RECTYPE="03"
  SFD.PREPARERNO=FX.PREPARERNO
  SFD.SEQNO=FX.SEQNO
  OPSNUMBER=OPSNUMBER+1:
  IF OPSNUMBER>7 THEN RETURN
  LIN$=STR$(OPSNUMBER)
  GOSUB JUST.SFDREC
  'SFD.SIN=FX.SIN
  'SFD.FIRSTNAME=FX.FIRSTNAME
  'SFD.LASTNAME=FX.LASTNAME
  SFD.BUSTYPE = "1"
