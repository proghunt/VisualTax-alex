DO.RULES:
  SELECT CASE LLINE
  CASE 252   'LOSSES OTH YEARS
    TBEG = SBEG(200): ELM% =58: GOSUB SDO.MFETCH: LAMOUNT!=VAL(LIN$)

  CASE 406   'BASIC FED TAX/VS MIN TAX
    LAMOUNT!=V(406)
    TBEG = SBEG(20): ELM% =8: GOSUB SDO.MFETCH:
    IF VAL(LIN$)>0 THEN LAMOUNT!=VAL(LIN$)

  CASE 551    'SPOUSE'S NI
   LAMOUNT!=0
   'ONT, BC, NS, MAN
   IF PROVINCE$="1" OR PROVINCE$="3" OR PROVINCE$="4" OR PROVINCE$="M" THEN
     LAMOUNT!=V(551)
   ENDIF
   IF PROVINCE$="1" THEN
     TBEG = SBEG(3): ELM% =28: GOSUB SDO.MFETCH:SPINDIC$=LIN$
     IF V(479)>0 AND SPINDIC$="1" THEN LAMOUNT!=0 'ONT
   END IF
   IF PROVINCE$="M" THEN
     TBEG = SBEG(3): ELM% =28: GOSUB SDO.MFETCH:SPINDIC$=LIN$
     TBEG = SBEG(185): ELM% =20: GOSUB SDO.MFETCH:X!=VAL(LIN$)
     IF X!>0 AND SPINDIC$="1" THEN LAMOUNT!=0 'ONT
   END IF
 ' TBEG = SBEG(5): ELM% =9: GOSUB SDO.MFETCH:IF UCASE$(LIN$)="Y" THEN LAMOUNT!=V(551)
   TBEG = SBEG(3): ELM% =5: GOSUB SDO.MFETCH:IF VAL(LIN$)>2 THEN LAMOUNT!=0  'MARSTAT

  CASE 978    'SPOUSE'S NI=0
    LAMOUNT!=0
    IF PROVINCE$="1" OR PROVINCE$="3" OR PROVINCE$="4" OR PROVINCE$="M" THEN
      IF V(551)=0 THEN LAMOUNT!=7 ELSE LAMOUNT!=0
    ENDIF
   IF PROVINCE$="1" THEN
     TBEG = SBEG(3): ELM% =28: GOSUB SDO.MFETCH:SPINDIC$=LIN$
     IF SPINDIC$="1" THEN LAMOUNT!=0 'ONT
   END IF
   IF PROVINCE$="M" THEN
     TBEG = SBEG(3): ELM% =28: GOSUB SDO.MFETCH:SPINDIC$=LIN$
     TBEG = SBEG(185): ELM% =13: GOSUB SDO.MFETCH:X!=VAL(LIN$)
     IF X!>0 AND SPINDIC$="1" THEN LAMOUNT!=0 'ONT
   END IF
   TBEG = SBEG(3): ELM% =5: GOSUB SDO.MFETCH:IF VAL(LIN$)>2 THEN LAMOUNT!=0  'MARSTAT

   'ORIGINAL
   'IF V(551)=0 THEN LAMOUNT!=7 ELSE LAMOUNT!=0
   ''ON
   'TBEG = SBEG(3): ELM% =28: GOSUB SDO.MFETCH:SPINDIC$=LIN$
   'IF PROVINCE$="1" AND SPINDIC$="1" THEN LAMOUNT!=0 'ONT
   ''MAN
   'TBEG = SBEG(185): ELM% =20: GOSUB SDO.MFETCH
   'IF PROVINCE$="M" AND VAL(LIN$)>0 AND SPINDIC$="1" THEN LAMOUNT!=0 'MANIT
   ''BC
   'TBEG = SBEG(40): ELM% =1: GOSUB SDO.MFETCH
   'IF PROVINCE$="3" AND VAL(LIN$)>0 AND SPINDIC$="1" THEN LAMOUNT!=0 'BC
   'IF PROVINCE$="2" OR PROVINCE$= "5" OR PROVINCE$="6" OR PROVINCE$="7" OR PROVINCE$="8" OR PROVINCE$="9" OR PROVINCE$="P" THEN LAMOUNT!=0
   'IF V(479)=0 THEN LAMOUNT!=0
   'TBEG = SBEG(3): ELM% =5: GOSUB SDO.MFETCH:IF VAL(LIN$)>2 THEN LAMOUNT!=0  'MARSTAT

  CASE 566    'KIDS BORN LESS THAN 18
    IF PROVINCE$="1" OR PROVINCE$="3" OR PROVINCE$="4" OR PROVINCE$="6" OR PROVINCE$="M" THEN  'ONT,BC, NS,SASK,MAN
      LAMOUNT!=V(566)
    ELSE
      LAMOUNT!=0
    END IF

  CASE 664    'RESTRICTED FARM LOSS CLAIMED
   LAMOUNT!=0
   TBEG = SBEG(138): ELM% =26: GOSUB SDO.MFETCH: X! = VAL(LIN$)
   TBEG = SBEG(138): ELM% =27: GOSUB SDO.MFETCH: Y! = VAL(LIN$)
   IF Y!><0 AND X!<0 THEN LAMOUNT!=ABS(X!) 'IF RESTR PRESENT AND THERE IS LOSS
   'OLD 1993
   'TBEG = SBEG(192): ELM% =16: GOSUB SDO.MFETCH: X! = VAL(LIN$)
   'TBEG = SBEG(193): ELM% =28: GOSUB SDO.MFETCH: Y! = VAL(LIN$) 'PRTN
   'LAMOUNT!=X!:IF LAMOUNT!=0 THEN LAMOUNT!=Y!  'ONE OF THE TWO
   'TBEG = SBEG(135): ELM% =23: GOSUB SDO.MFETCH: IF UCASE$(LIN$)><"Y" THEN LAMOUNT!=0

  CASE 683    'RETIRMT BENEFTS RECEIVED
    LAMOUNT!=0
    TBEG = SBEG(100): ELM% = 9: GOSUB SDO.MFETCH: X! = VAL(LIN$) 'BENF MONTH
    ELM% = 10: GOSUB SDO.MFETCH: 'RETRM OR DISABIL CODE
    IF VAL(LIN$)=1 OR VAL(LIN$)=3 THEN  'RETRM OR DISAB
      IF X! > 0 AND V(114)>0 THEN LAMOUNT!=12-X!+1 ELSE LAMOUNT!=0 'CPP BENEFITS STARTD MONTH X!
    END IF
 'CASE 692   'LOSS BY FILM CCA
 '  TBEG = SBEG(67): ELM% = 9: GOSUB SDO.MFETCH: X! = VAL(LIN$)
 '  IF X!>0 THEN LAMOUNT!=X! ELSE LAMOUNT!=0
