<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
Description: CRA Frrms Web Services - T2 forms
Type (Request or Response): Request
Version: 1-0-0
Date created:
Contact:
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:t2nrq="http://www.cra-arc.gc.ca/xmlns/t2nrq/t2frrmsrequest/1-0-0"
    xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
    xmlns:t1135="http://www.cra-arc.gc.ca/xmlns/t1135/2021/1-0-0"
    xmlns:cbc="http://www.cra-arc.gc.ca/xmlns/cbc/2019/1-0-0"
    xmlns:t1134="http://www.cra-arc.gc.ca/xmlns/t1134/2021/1-0-0"
    xmlns:t106="http://www.cra-arc.gc.ca/xmlns/t106/2025/1-0-0"
    targetNamespace="http://www.cra-arc.gc.ca/xmlns/t2nrq/t2frrmsrequest/1-0-0"
    elementFormDefault="qualified" attributeFormDefault="unqualified" version="t2nrq/1-0-0">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t1135/2021/1-0-0" schemaLocation="ForeignIncomeVerificationStatement.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/cbc/2019/1-0-0" schemaLocation="CountryByCountryReport2019.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t1134/2021/1-0-0" schemaLocation="ControlledAndNotControlledForeignAffiliateReturn2021.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t106/2025/1-0-0" schemaLocation="NonArmsLengthTransactionWithNonResidentInformationReturn.xsd"/>

	<xsd:element name="TermsAndConditionsRequest" type="t2nrq:TermsAndConditionsRequestType"/>
    <xsd:element name="RefileTermsAndConditionsRequest" type="t2nrq:TermsAndConditionsRequestType"/>
    <xsd:simpleType name="TermsAndConditionsRequestType">
        <xsd:restriction base="sdt:SimpleTextType"/>
    </xsd:simpleType>	

	<xsd:element name="T2NetfileReturnRequest" type="t2nrq:T2NetfileReturnRequestType"/>
    <xsd:complexType name="T2NetfileReturnRequestType">
        <xsd:sequence>
            <xsd:element ref="t2nrq:BusinessNumber"/>
			<xsd:element ref="t2nrq:WACNumber"/>
			<xsd:element ref="t2nrq:AgreementIndicator"/>
            <xsd:element ref="t2nrq:TaxYear"/>
            <xsd:element ref="t2nrq:SoftwareID"/>
            <xsd:element ref="t2nrq:TaxForm"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="TaxForm" type="t2nrq:TaxFormType"/>
    <xsd:complexType name="TaxFormType">
        <xsd:choice>
            <!-- There will be multiple forms in future -->
            <xsd:element ref="t1134:ControlledAndNotControlledForeignAffiliateReturn"/>
            <xsd:element ref="t106:NonArmsLengthTransactionWithNonResidentInformationReturn"/>
            <xsd:element ref="cbc:CountryByCountryReport"/>
            <xsd:element ref="t1135:ForeignIncomeVerificationStatement"/>
        </xsd:choice>
    </xsd:complexType>
	
	<xsd:element name="BusinessNumber" type="t2nrq:BNRCType" />
    <xsd:simpleType name="BNRCType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([0-9]{9}RC[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>
	
	<xsd:element name="WACNumber" type="t2nrq:WACType" />
    <xsd:simpleType name="WACType">
    	<xsd:restriction base="sdt:CodeType">
        	<xsd:pattern value="([0-9]{8})"/>
        </xsd:restriction>
    </xsd:simpleType>
	
	<xsd:element name="AgreementIndicator"> 
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Values are 1 for "Yes", 2 for "No", and 0 for "Question not answered"</xsd:documentation>
            <xsd:documentation xml:lang="fr">Les valeurs sont 1 pour "Oui", 2 pour "Non", et 0 pour "questions non répondue"</xsd:documentation>
        </xsd:annotation>
		<xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:enumeration value="0"/>
                <xsd:enumeration value="1"/>
                <xsd:enumeration value="2"/>
            </xsd:restriction>
    	</xsd:simpleType>
	</xsd:element>

    <xsd:element name="TaxYear" type="sdt:YearType"/>

    <xsd:element name="SoftwareID">
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
                <xsd:length value="4"/>
                <xsd:pattern value="[A-Za-z]{2}[0-9]{2}"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>


</xsd:schema>
