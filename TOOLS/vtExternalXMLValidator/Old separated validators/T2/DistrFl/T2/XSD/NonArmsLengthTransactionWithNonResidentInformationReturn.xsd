            <xsd:restriction base="sdt:CodeType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="20"/>
                <xsd:pattern value="([A-Za-z0-9\-])*"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <xsd:complexType name="NameDescription">
        <xsd:simpleContent>
            <xsd:restriction base="sdt:NameType">
                <xsd:maxLength value="255"/>
                <xsd:whiteSpace value="collapse"/>
            </xsd:restriction>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:element name="SoldToNonResidentAmount"       type="t106:PositiveThousandTrillionAmountType"/>
    <xsd:element name="PurchaseFromNonResidentAmount" type="t106:PositiveThousandTrillionAmountType"/>
    <xsd:element name="BeginningBalanceAmount"        type="t106:PositiveThousandTrillionAmountType"/>
    <xsd:element name="IncreaseAmount"                type="t106:PositiveThousandTrillionAmountType"/>
    <xsd:element name="DecreaseAmount"                type="t106:PositiveThousandTrillionAmountType"/>
    <xsd:element name="EndingBalanceAmount"           type="t106:PositiveThousandTrillionAmountType"/>

    <xsd:element name="ContractCount">
        <xsd:simpleType>
            <xsd:restriction base="sdt:CountType">
                <xsd:totalDigits value="9"/>
				<xsd:minInclusive value="0"/>
				<xsd:maxInclusive value="999999999"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:element name="NotionalAmount"                 type="t106:PositiveThousandTrillionAmountType"/>
    <xsd:element name="RevenueFromNonResidentAmount"   type="t106:PositiveThousandTrillionAmountType"/>
    <xsd:element name="ExpenditureToNonResidentAmount" type="t106:PositiveThousandTrillionAmountType"/>
	<xsd:element name="DerivativeRevenueFromNonResidentAmount"   type="t106:PositiveThousandTrillionAmountType"/>
    <xsd:element name="DerivativeExpenditureToNonResidentAmount" type="t106:PositiveThousandTrillionAmountType"/>

    <xsd:simpleType name="ThousandTrillionAmountType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">The field is used to capture the dollar amount (no decimals).  The dollar value cannot exceed +/- $99,999,999,999,999. </xsd:documentation>
            <xsd:documentation xml:lang="fr">Le champ est utilisé pour capturer le montant en dollar (pas de décimales). La valeur en dollar ne peut pas dépasser +/- 99.999.999.999.999 $.</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:AmountDollarsOnlyType">
            <xsd:totalDigits value="15"/>
        </xsd:restriction>
    </xsd:simpleType>
	
	<xsd:simpleType name="PositiveThousandTrillionAmountType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">The field is used to capture the dollar amount (no decimals).  The dollar value cannot exceed +/- $999,999,999,999,999. </xsd:documentation>
            <xsd:documentation xml:lang="fr">Le champ est utilisé pour capturer le montant en dollar (pas de décimales). La valeur en dollar ne peut pas dépasser +/- 999.999.999.999.999 $.</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:AmountDollarsOnlyType">
            <xsd:minInclusive value="0"/>
            <xsd:maxInclusive value="999999999999999"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="OtherTangiblePropertyDescription" type="t106:NameDescription"/>
    <xsd:element name="FinancialOtherDescription"        type="t106:NameDescription"/>
    <xsd:element name="OtherTransactionDescription"      type="t106:NameDescription"/>

    <xsd:element name="SoldToNonResidentTransferPricingMethodologyCode"        type="t106:TransferPricingMethodologyCodeType"/>
    <xsd:element name="PurchaseFromNonResidentTransferPricingMethodologyCode"  type="t106:TransferPricingMethodologyCodeType"/>
    <xsd:element name="RevenueFromNonResidentTransferPricingMethodologyCode"   type="t106:TransferPricingMethodologyCodeType"/>
    <xsd:element name="ExpenditureToNonResidentTransferPricingMethodologyCode" type="t106:TransferPricingMethodologyCodeType"/>

    <xsd:simpleType name="TransferPricingMethodologyCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Transfer pricing methodology codes:
                01 - Comparable Uncontrolled Prince
                02 - Cost-Plus
                03 - Resale
                04 - Profile Split
                05 - Transactional Net Margin
                06 - Qualifying Cost Contribution Arrangement
				07 - Advanced Pricing Arrangement
                08 - Other
            </xsd:documentation>
            <xsd:documentation xml:lang="fr">Les valeurs valides sont les suivantes :
                01 – Méthode du prix comparable sur le marché libre
                02 – Méthode du prix de revient majoré
                03 – Méthode du prix de revente
                04 – Méthode du partage des bénéfices
                05 – Méthode transactionnelle de la marge nette
                06 – Arrangement admissible de participation au coût
				07 – Arrangement tarifaire avancé
                08 – Autre
            </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:CodeType">
                <xsd:length value="2"/>
                <xsd:enumeration value="01"/>
                <xsd:enumeration value="02"/>
                <xsd:enumeration value="03"/>
                <xsd:enumeration value="04"/>
                <xsd:enumeration value="05"/>
                <xsd:enumeration value="06"/>
                <xsd:enumeration value="07"/>
				<xsd:enumeration value="08"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="PhoneNumberType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">To capture any North American or International phone number with (possible) extension.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Pour capturer tout numéro de téléphone nord-américain ou international avec (possible) l'extension.</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:token">
            <xsd:pattern value="([0-9xX\(\)\-\.])*"/>
            <xsd:maxLength value="20"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="BusinessNumber" type="t106:BNRCType"/>
    <xsd:simpleType name="BNRCType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([0-9]{9}RC[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="PartnershipNumber" type="t106:BNRZType"/>
    <xsd:simpleType name="BNRZType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([0-9]{9}RZ[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>
	
	<xsd:element name="TaxpayerName" type="t106:CompleteIndividualNameType"/>
    <xsd:complexType name="CompleteIndividualNameType">
        <xsd:sequence>
            <xsd:element ref="t106:GivenName"/>
            <xsd:element ref="t106:FamilyName"/>
        </xsd:sequence>
    </xsd:complexType>
	
	<xsd:element name="GivenName" type="ccms:Name60CharacterType"/>
	<xsd:element name="FamilyName" type="ccms:Name60CharacterType"/>
	
	<xsd:element name="AddressStreetText">
        <xsd:annotation>
            <xsd:documentation xml:lang="en"> Valid characters include Alpha/numeric, space*, hyphen, apostrophe, slash, ampersand, diacritic, pound symbol (#), brackets ( ) and period*.  A period or space is a valid character at any position except at the first position. The bracket can be in the last position.  It must not contain "A/S: ", "C/O: ", "A/S ", "C/O ", "A/S:", "C/O:", "A/S", "C/O".  The following characters are not allowed in the first or last position:  hyphen, apostrophe, slash, ampersand, brackets, pound symbol.</xsd:documentation>
            <xsd:documentation xml:lang="fr"> Les caractères valides comprennent Alphabétique/numérique, espace *, trait d'union, apostrophe, barre oblique, esperluette, signe accentué, symbole dièse (#), parenthèses () et le point *. Un point ou espace est un caractère valide à n'importe quelle position sauf au niveau de la première position. La parenthèse peut être à la dernière position. Il ne doit pas contenir «A / S: », «C / O: », «A / S », «C / O », «A / S:», «C / O:», «A / S», «C / O». Les caractères suivants ne sont pas autorisés dans la première ou dernière position: trait d'union, apostrophe, barre oblique, esperluette, parenthèses, symbole dièse.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
            <xsd:simpleContent>
                <xsd:restriction base="sdt:TextType">
                    <xsd:maxLength value="60"/>
                </xsd:restriction>
            </xsd:simpleContent>
        </xsd:complexType>
    </xsd:element>
	
	<xsd:element name="AddressMunicipalityName">
        <xsd:complexType>
            <xsd:simpleContent>
                <xsd:restriction base="sdt:NameType">
                    <xsd:maxLength value="50"/>
                </xsd:restriction>
            </xsd:simpleContent>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>