    <!-- COMMON TYPES USED IN THIS SCHEMA FILE -->

    <xsd:simpleType name="CbCRCountryCodeType">
        <xsd:restriction base="sdt:CodeType">
            <xsd:length value="3"/>
            <xsd:pattern value="[A-Za-z0-9]{3}"/>
        </xsd:restriction>
    </xsd:simpleType>
	
	<xsd:simpleType name="PrimaryNRAccountCode">
        <xsd:restriction base="sdt:CodeType">
            <xsd:length value="9"/>
            <xsd:pattern value="(NR[A-Za-z][0-9]{6})"/>
        </xsd:restriction>
    </xsd:simpleType>
	
	<xsd:simpleType name="PrimaryRPAccountCode">
        <xsd:restriction base="sdt:CodeType">
            <xsd:length value="15"/>
            <xsd:pattern value="([0-9]{9}RP[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="SlipSequenceIdentifierType">
        <xsd:restriction base="sdt:IDType">
            <xsd:pattern value="[1-9]([0-9])*"/>
            <xsd:minLength value="1"/>
            <xsd:maxLength value="4"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="ActionCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Valid Codes are: 1=new; 2=unmodified; 3=amended; 4=delete</xsd:documentation>
            <xsd:documentation xml:lang="fr">Les codes valides sont: 1=nouveau; 2=non modifié; 3=modifié; 4=détruit  </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:CodeType">
            <xsd:enumeration value="1"/>
            <xsd:enumeration value="2"/>
            <xsd:enumeration value="3"/>
            <xsd:enumeration value="4"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="SlipDeleteReasonCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Valid Codes are: 1=duplicate; 2=filed in error; 3=other</xsd:documentation>
            <xsd:documentation xml:lang="fr">  </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:CodeType">
            <xsd:enumeration value="1"/>
            <xsd:enumeration value="2"/>
            <xsd:enumeration value="3"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="NorthAmericanIndustryClassificationSystem" type="t106:NorthAmericanIndustryClassificationSystemType"/>
    <xsd:complexType name="NorthAmericanIndustryClassificationSystemType">
        <xsd:sequence>
            <xsd:element ref="t106:NorthAmericanIndustryClassificationSystemCode" maxOccurs="4"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="NorthAmericanIndustryClassificationSystemCode" type="t106:NorthAmericanIndustryClassificationSystemCodeType"/>
    <xsd:simpleType name="NorthAmericanIndustryClassificationSystemCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Must be valid North American Industry Classification System (NAICS) Code from list provided</xsd:documentation>
            <xsd:documentation xml:lang="fr">Doit être un code valide du Système de Classification des Industries de l'Amérique du Nord (SCIAN) de la liste fournie.</xsd:documentation>
        </xsd:annotation>
            <xsd:restriction base="sdt:CodeType">
                <xsd:maxLength value="6"/>
                <xsd:pattern value="[0-9][0-9]([0-9])*"/>
            </xsd:restriction>
    </xsd:simpleType>


    <xsd:element name="GlobalProvinceTerritoryStateCode">
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="100"/>
                <xsd:pattern value="([A-Za-z])*"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <xsd:element name="CountryCode" type="ccms:CountryCodeType"/>

    <xsd:element name="GlobalAddress" type="t106:NameDescription"/>
	
	<xsd:element name="DerivativeOtherPaymentDescription" type="t106:NameDescription"/> 

