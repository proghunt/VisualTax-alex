<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:t1ersp="http://www.cra-arc.gc.ca/xmlns/t1ersp/efileresponse/1-1-0"
    xmlns:t1rsp="http://www.cra-arc.gc.ca/xmlns/t1rsp/response/1-0-0"
    xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
    targetNamespace="http://www.cra-arc.gc.ca/xmlns/t1ersp/efileresponse/1-1-0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="t1ersp/1-1-0">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t1rsp/response/1-0-0" schemaLocation="t1wsresponse.xsd"/>
    
    <xsd:element name="EfileReturnResponse" type="t1ersp:EfileReturnResponseType"/>
    <xsd:complexType name="EfileReturnResponseType">
        <xsd:sequence>
            <xsd:element ref="t1ersp:ResultCode" minOccurs="0"/>
            <xsd:element ref="t1ersp:TransmissionNumber" minOccurs="0"/>
            <xsd:element ref="t1ersp:DocumentControlNumber" minOccurs="0"/>
            <xsd:element ref="t1ersp:FamilyName" minOccurs="0"/>
            <xsd:element ref="t1ersp:GivenName" minOccurs="0"/>
            <xsd:element ref="t1rsp:FileReturnResponse"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ResultCode" type="t1ersp:ResultCodeType" />
    <xsd:simpleType name="ResultCodeType" >
        <xsd:restriction base="xsd:string">
            <xsd:length value="6"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="TransmissionNumber" type="sdt:CodeType"/>
	
	<xsd:element name="DocumentControlNumber" type="t1ersp:DocumentControlNumberType" />
    <xsd:complexType name="DocumentControlNumberType">
        <xsd:sequence>
            <xsd:element ref="t1ersp:TaxPreparerEfilerNumber"/>
            <xsd:element ref="t1ersp:TaxPreparerReturnControlNumber"/>
        </xsd:sequence>
    </xsd:complexType>
	
	<xsd:element name="TaxPreparerEfilerNumber">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Number used to ID a tax preparer</xsd:documentation>
            <xsd:documentation xml:lang="fr">Numéro utilisé pour identifier un  préparateur d'impôt</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
            <xsd:length value="5"/>
            <xsd:pattern value="[A-Za-z][0-9]{4}|[A-Za-z]{2}[0-9]{3}"/>
        </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:element name="TaxPreparerReturnControlNumber">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Unique number used by taxpreparer to identify a return (This field and the one immediately preceeding make up the "DCN")</xsd:documentation>
            <xsd:documentation xml:lang="fr">Numéro unique utilisé par le préparateur d'impôt pour identifier une déclaration (Ce champ et celui qui le précède compose le "NCD")</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
                <xsd:length value="8"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
	
	<xsd:element name="FamilyName">
        <xsd:complexType>
            <xsd:simpleContent>
                <xsd:restriction base="sdt:NameType">
					<xsd:maxLength value="30"/>
				</xsd:restriction>
            </xsd:simpleContent>
        </xsd:complexType>
    </xsd:element>
	
	<xsd:element name="GivenName">
        <xsd:complexType>
            <xsd:simpleContent>
                <xsd:restriction base="sdt:NameType">
					<xsd:maxLength value="30"/>
				</xsd:restriction>
            </xsd:simpleContent>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
