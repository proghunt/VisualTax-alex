                    <xsd:documentation>Afghanistan</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="ALA">
                <xsd:annotation>
                    <xsd:documentation>Aland Islands</xsd:documentation>
