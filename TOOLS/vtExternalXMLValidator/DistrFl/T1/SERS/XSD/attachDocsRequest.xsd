<?xml version="1.0" encoding="ISO-8859-1"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
	xmlns:sres="http://www.cra-arc.gc.ca/xmlns/sres/1-0-0"
	xmlns:srescommon="http://www.cra-arc.gc.ca/xmlns/srescommon/1-0-0"
	xmlns:xmime="http://www.w3.org/2005/05/xmlmime"
	targetNamespace="http://www.cra-arc.gc.ca/xmlns/sres/1-0-0"
	elementFormDefault="qualified" attributeFormDefault="unqualified"
	version="sres/1-0-0">
	<xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/srescommon/1-0-0" schemaLocation="sresCommonTypes.xsd" />
	
	<xsd:element name="AttachDocsRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="srescommon:SoftwareCode" minOccurs="1" maxOccurs="1" />
				<xsd:element ref="srescommon:TaxYear" minOccurs="1" maxOccurs="1" />
				<xsd:element ref="srescommon:ClientId" minOccurs="1" maxOccurs="1"/>
				<xsd:element ref="srescommon:ConfirmationNumber" minOccurs="1" maxOccurs="1" />
				<xsd:element name="AttachmentList" type="sres:AttachmentListType" minOccurs="1" maxOccurs="1" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
		
	<xsd:complexType name="AttachmentListType">
    	<xsd:sequence>
        	<xsd:element name="File" type="sres:FileDetails" maxOccurs="unbounded"/>
    	</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="FileDetails">
    	<xsd:sequence>
			<xsd:element ref="srescommon:FileName" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="srescommon:TaxYear" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="sres:MimeType" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="srescommon:FormNumber" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="sres:DocumentType" minOccurs="1" maxOccurs="1" />
    	</xsd:sequence>
	</xsd:complexType>
	
	<xsd:element name="MimeType">
		<xsd:simpleType>
			<xsd:restriction base="xsd:string" />
		</xsd:simpleType>
	</xsd:element>
	
	<xsd:element name="DocumentType">
		<xsd:simpleType>
			<xsd:restriction base="xsd:string" />
		</xsd:simpleType>
	</xsd:element>
</xsd:schema>