<?xml version="1.0" encoding="ISO-8859-1"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
	xmlns:sres="http://www.cra-arc.gc.ca/xmlns/sres/1-0-0"
	xmlns:srescommon="http://www.cra-arc.gc.ca/xmlns/srescommon/1-0-0"
	xmlns:xmime="http://www.w3.org/2005/05/xmlmime"
	targetNamespace="http://www.cra-arc.gc.ca/xmlns/sres/1-0-0"
	elementFormDefault="qualified" attributeFormDefault="unqualified"
	version="sres/1-0-0">

	<xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd" />
	<xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/srescommon/1-0-0" schemaLocation="sresCommonTypes.xsd" />

	<xsd:element name="FileReturnRequest"> 
		<xsd:complexType> 
			<xsd:sequence>
				<xsd:element ref="srescommon:SoftwareCode" minOccurs="1" maxOccurs="1" />
				<xsd:element ref="srescommon:TaxYear" minOccurs="0" maxOccurs="1" />
				<xsd:element ref="srescommon:ClientId" minOccurs="1" maxOccurs="1" />	
				<xsd:element name="Form" type="sres:FormType" minOccurs="1" maxOccurs="unbounded" />
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="uniqueId">
			<xsd:selector xpath="sres:Form" />
			<xsd:field xpath="sres:FormSequenceNumber" />
		</xsd:unique>
	</xsd:element>

	<xsd:complexType name="FormType">
		<xsd:sequence>
			<xsd:element ref="srescommon:FormSequenceNumber" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="srescommon:FormNumber" minOccurs="1" maxOccurs="1" />
			<xsd:element name="FieldCode" type="sres:FieldCodeType" minOccurs="1" maxOccurs="unbounded" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="FieldCodeType">
		<xsd:sequence>
			<xsd:element ref="sres:Line" maxOccurs="1" />
			<xsd:element ref="sres:Row" minOccurs="0" maxOccurs="1" />
			<xsd:element ref="sres:Value" maxOccurs="1" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:element name="Line">
		<xsd:simpleType>
			<xsd:restriction base="sdt:CountType">
				<xsd:pattern value="[0-9]{1,4}" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>

	<xsd:element name="Row">
		<xsd:simpleType>
			<xsd:restriction base="sdt:CountType">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>

	<xsd:element name="Value">
		<xsd:simpleType>
			<xsd:restriction base="sdt:SimpleTextType">
				<xsd:maxLength value="256" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
</xsd:schema>