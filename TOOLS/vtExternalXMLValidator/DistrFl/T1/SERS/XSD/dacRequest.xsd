<?xml version="1.0" encoding="ISO-8859-1"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
	xmlns:sres="http://www.cra-arc.gc.ca/xmlns/sres/1-0-0"
	xmlns:srescommon="http://www.cra-arc.gc.ca/xmlns/srescommon/1-0-0"
	xmlns:xmime="http://www.w3.org/2005/05/xmlmime"
	targetNamespace="http://www.cra-arc.gc.ca/xmlns/sres/1-0-0"
	elementFormDefault="qualified" attributeFormDefault="unqualified"
	version="sres/1-0-0">

	<xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd" />
	<xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/srescommon/1-0-0" schemaLocation="sresCommonTypes.xsd" />

	<xsd:element name="DacRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="srescommon:SoftwareCode" minOccurs="1" maxOccurs="1" />
				<xsd:element ref="srescommon:TaxYear" minOccurs="0" maxOccurs="1" />
				<xsd:element ref="srescommon:ClientId" minOccurs="1" maxOccurs="1" />
				<xsd:element name="SharedSecrets" type="sres:SharedSecretsType" minOccurs="1" maxOccurs="1" />
				<xsd:element ref="sres:Year" minOccurs="0" maxOccurs="1" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:complexType name="SharedSecretsType">
		<xsd:sequence>	
			<xsd:choice>		
				<xsd:element name="CorporateEntity" type="sres:CorporateEntityType"/>
				<xsd:element name="PartnershipEntity" type="sres:PartnershipEntityType"/>
				<xsd:element name="SinEntity" type="sres:SinEntityType"/>
				<xsd:element name="TrustEntity" type="sres:TrustEntityType"/>
				<xsd:element name="UhtEntity" type="sres:UhtEntityType"/>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>	
	
	<xsd:complexType name="CorporateEntityType">
		<xsd:sequence>
			<xsd:element ref="sres:IncorporationDate" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="sres:PostalCode" minOccurs="1" maxOccurs="1" />
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="PartnershipEntityType">
		<xsd:sequence>
			<xsd:element ref="sres:RegistrationDate" minOccurs="1" maxOccurs="1" />
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="SinEntityType">
		<xsd:sequence>
			<xsd:element ref="sres:FirstName" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="sres:LastName" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="sres:DateOfBirth" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="sres:PostalCode" minOccurs="1" maxOccurs="1" />
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="TrustEntityType">
		<xsd:sequence>
			<xsd:element ref="sres:RegistrationDate" minOccurs="0" maxOccurs="1" />
			<xsd:element ref="sres:DateOfDeath" minOccurs="0" maxOccurs="1" />
			<xsd:element ref="sres:PostalCode" minOccurs="1" maxOccurs="1" />
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="UhtEntityType">
		<xsd:sequence>
			<xsd:element ref="sres:RegistrationDate" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="sres:PostalCode" minOccurs="1" maxOccurs="1" />
			<xsd:element ref="sres:Name" minOccurs="1" maxOccurs="1" />
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:element name="Name">
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>

	<xsd:element name="PostalCode">
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	
	<xsd:element name="FirstName">
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	
	<xsd:element name="LastName">
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	
		<xsd:element name="DateOfBirth">
		<xsd:simpleType>
			<xsd:restriction base="sdt:DateType">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	
	<xsd:element name="Year">
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	
	<xsd:element name="IncorporationDate">
		<xsd:simpleType>
			<xsd:restriction base="sdt:DateType">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	
	<xsd:element name="RegistrationDate">
		<xsd:simpleType>
			<xsd:restriction base="sdt:DateType">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	
	<xsd:element name="DateOfDeath">
		<xsd:simpleType>
			<xsd:restriction base="sdt:DateType">
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>	
</xsd:schema>