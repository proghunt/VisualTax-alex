<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:t1nfrsp="http://www.cra-arc.gc.ca/xmlns/t1nfrsp/t1netfilefrrmsresponse/1-0-0"
	xmlns:t1rsp="http://www.cra-arc.gc.ca/xmlns/t1rsp/response/1-0-0"
	xmlns:t1efrsp="http://www.cra-arc.gc.ca/xmlns/t1efrsp/t1efilefrrmsresponse/1-1-0"
	xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
	targetNamespace="http://www.cra-arc.gc.ca/xmlns/t1nfrsp/t1netfilefrrmsresponse/1-0-0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="t1nfrsp/1-0-0">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t1rsp/response/1-0-0" schemaLocation="t1wsresponse.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t1efrsp/t1efilefrrmsresponse/1-1-0" schemaLocation="t1efrrmsresponse.xsd"/>

    <xsd:element name="T1TermsAndConditionsResponse" type="t1rsp:TermsAndConditionsResponseType"/>
     
    <xsd:element name="FrrmsNetfileReturnResponse" type="t1nfrsp:FrrmsNetfileReturnResponseType"/>
    <xsd:complexType name="FrrmsNetfileReturnResponseType">
        <xsd:sequence>
            <xsd:element ref="t1rsp:ResultCode" minOccurs="0"/>
            <xsd:element ref="t1rsp:FileReturnResponse"/>
            <xsd:element ref="t1nfrsp:T1NTimeStamp" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
	
	<xsd:element name="T1NTimeStamp" type="sdt:DateTimeType"/>
       <xsd:annotation>
            <xsd:documentation xml:lang="en">Format is YYYY-MM-DDThh:mm:ss.sm</xsd:documentation>
            <xsd:documentation xml:lang="fr">Le format est AAAA-MM-JJThh:mm:ss.sm</xsd:documentation>
        </xsd:annotation>
 		
</xsd:schema>
