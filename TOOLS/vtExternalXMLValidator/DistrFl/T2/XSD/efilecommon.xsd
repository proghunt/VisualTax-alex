<?xml version="1.0" encoding="ISO-8859-1"?>
<xsd:schema xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" 
			xmlns:ef="http://www.cra-arc.gc.ca/xmlns/ef/2025/1-0-0" 
			xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
			xmlns:comm="http://www.cra-arc.gc.ca/xmlns/comm/2025/1-0-0" 
			targetNamespace="http://www.cra-arc.gc.ca/xmlns/ef/2025/1-0-0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1-0-0">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/comm/2025/1-0-0" schemaLocation="electronicfilingcommon.xsd"/>
    <xsd:element name="EfileData" type="ef:EfileDataType"/>
    <xsd:complexType name="EfileDataType">
        <xsd:sequence>
            <xsd:element ref="ef:PasswordID"/>
            <xsd:element ref="ef:DocumentControlNumber"/>
            <xsd:element ref="ef:DiscounterRegistrationNumber" minOccurs="0"/>
            <xsd:element ref="ef:TaxPreparerAuthorizationIndicator" minOccurs="0"/>
            <xsd:element ref="ef:TaxPreparerAuthorizationExpiryDate" minOccurs="0"/>
            <xsd:element ref="ef:EfilerNOARetrievalAuthorizationIndicator"/>
            <xsd:element ref="ef:TaxPreparerPreAssessmentReviewContactCode"/>
            <xsd:element ref="ef:TaxPreparerPostAssessmentReviewContactCode"/>
            <xsd:element ref="ef:T183ElectronicSignatureData"/>
            <xsd:element ref="ef:RC71ElectronicSignatureData" minOccurs="0"/>
            <xsd:element ref="ef:CVITPOrganizationIdentificationNumber" minOccurs="0"/>
            <xsd:element ref="ef:RepresentativeID" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="PasswordID">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">assigned by CRA to the Tax Preparer to establish a communication session</xsd:documentation>
            <xsd:documentation xml:lang="fr">Assigné par l'ARC au préparateur d'impôt pour établir la communication d'une session</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:element name="DocumentControlNumber" type="ef:DocumentControlNumberType"/>
    <xsd:complexType name="DocumentControlNumberType">
        <xsd:sequence>
            <xsd:element ref="ef:TaxPreparerEfilerNumber"/>
            <xsd:element ref="ef:TaxPreparerReturnControlNumber"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="TaxPreparerEfilerNumber">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Number used to ID a tax preparer</xsd:documentation>
            <xsd:documentation xml:lang="fr">Numéro utilisé pour identifier un  préparateur d'impôt</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="ef:EfilerNumberType">
                <xsd:length value="5"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:element name="TaxPreparerReturnControlNumber">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Unique number used by taxpreparer to identify a return (This field and the one immediately preceeding make up the "DCN")</xsd:documentation>
            <xsd:documentation xml:lang="fr">Numéro unique utilisé par le préparateur d'impôt pour identifier une déclaration (Ce champ et celui qui le précède compose le "NCD")</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
                <xsd:length value="8"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:element name="DiscounterRegistrationNumber">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Optional. Initialized to zeros if not a discounted return. Must pass MOD-10 check</xsd:documentation>
            <xsd:documentation xml:lang="fr">Optionnel. Initialisé avec des zéros si ce n'est pas une déclaration escomptée. Doit passer le contrôle MOD-10</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:NumberType">
                <xsd:length value="8"/>
                <xsd:pattern value="[0-9]{8}"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:element name="TaxPreparerAuthorizationIndicator" type="sdt:IndicatorType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">0 = Not Authorized to contact tax preparer, 1 = Authorized to contact tax preparer for current year ONLY</xsd:documentation>
            <xsd:documentation xml:lang="fr">0 = Pas autorisé à communiquer avec le préparateur d'impôt, 1 = Autorisé à communiquer avec le préparateur d'impôt pour l'année d'imposition courante SEULEMENT</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:element name="TaxPreparerAuthorizationExpiryDate" type="sdt:DateType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Optional if TaxPreparerContactIndicator is 0 or omitted. Format is YYYY-MM-DD</xsd:documentation>
            <xsd:documentation xml:lang="fr">Optionnel si TaxPreparerContactIndicator est 0 ou omis. Format est AAAA-MM-JJ</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:element name="EfilerNOARetrievalAuthorizationIndicator" type="sdt:IndicatorType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Optional if Efiler is authorized to view taxpayer's Express T1 Notice.  Valid values: 1=YES; 0=NO (default)</xsd:documentation>
            <xsd:documentation xml:lang="fr">Optionnel si le déclarant électronique est autorisé à visualiser l'avis de cotisation Express T1 du contribuable. Valeurs valides: 1 = OUI; 0 = NON (par défaut)</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:element name="TaxPreparerPreAssessmentReviewContactCode">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">1 = not applicable as of 2013 tax year; 2 = Contact with Efiler by mail; 3 = Contact with client</xsd:documentation>
            <xsd:documentation xml:lang="fr">1 = pas applicable à compter de l'année d'imposition 2013; 2 = Communication avec le déclarant par la poste; 3 = Communication avec le client</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:length value="1"/>
                <xsd:enumeration value="1"/>
                <xsd:enumeration value="2"/>
                <xsd:enumeration value="3"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:element name="TaxPreparerPostAssessmentReviewContactCode">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">1 = not applicable as of 2013 tax year; 2 = Contact with Efiler by mail; 3 = Contact with client</xsd:documentation>
            <xsd:documentation xml:lang="fr">1 = pas applicable à compter de l'année d'imposition 2013; 2 = Communication avec le déclarant par la poste; 3 = Communication avec le client</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:length value="1"/>
                <xsd:enumeration value="1"/>
                <xsd:enumeration value="2"/>
                <xsd:enumeration value="3"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:element name="TaxPreparerTransmissionID">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Unique code used by Efiler to identify the file. Provided by tax preparer/transmitter.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Numéro unique utilisé par le déclarant pour identifier une déclaration. Fourni par le préparateur/transmetteur.</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="ef:TransmissionIDType">
                <xsd:length value="10"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:simpleType name="TransmissionIDType">
        <xsd:restriction base="sdt:IDType"/>
    </xsd:simpleType>
    <xsd:element name="TransmitterEfilerNumber">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Number used to ID a transmitter</xsd:documentation>
            <xsd:documentation xml:lang="fr">Numéro utilisé pour identifier un transmetteur</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="ef:EfilerNumberType">
                <xsd:length value="5"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    <xsd:simpleType name="EfilerNumberType">
        <xsd:restriction base="sdt:IDType">
            <xsd:length value="5"/>
            <xsd:pattern value="[A-Za-z][0-9]{4}|[A-Za-z]{2}[0-9]{3}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="T183ElectronicSignatureData" type="ef:T183ElectronicSignatureDataType"/>
    <xsd:complexType name="T183ElectronicSignatureDataType">
        <xsd:sequence>
            <xsd:element ref="ef:T183ElectronicSignatureIndicator"/>
            <xsd:element ref="ef:T183ElectronicSignatureDate" minOccurs="0"/>
            <xsd:element ref="ef:T183ElectronicSignatureTime" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="T183ElectronicSignatureIndicator" type="sdt:IndicatorType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Mandatory indicator to represent that the T183 form was electronically signed . Valid values: 1 = YES; 0 = NO </xsd:documentation>
            <xsd:documentation xml:lang="fr">Indicateur obligatoire pour représenter que le formulaire T183 a été signé électroniquement. Valeurs valides : 1=OUI; 0=NON </xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:element name="T183ElectronicSignatureDate" type="sdt:DateType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Must be entered if T183ElectronicSignatureIndicator is set to Yes (1). Can be omitted if T183ElectronicSignatureIndicator is set to No (0). Format is YYYY-MM-DD</xsd:documentation>
            <xsd:documentation xml:lang="fr">Doit être inscrit si l'indicateur de T183 signé électroniquement « T183ElectronicSignatureIndicator » est réglé à Oui (1). Peut être omis si T183ElectronicSignatureIndicator est réglé à Non (0). Le format est AAAA-MM-JJ.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:element name="T183ElectronicSignatureTime" type="sdt:TimeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Must be entered if T183ElectronicSignatureDate has a valid entry. Format is HH:MM:SS</xsd:documentation>
            <xsd:documentation xml:lang="fr">Doit être inscrit si une entrée valide est inscrite pour la date de signature électronique du T183 « T183ElectronicSignatureDate ». Le format est HH:MM:SS </xsd:documentation>
        </xsd:annotation>
    </xsd:element>

    <xsd:element name="RC71ElectronicSignatureData" type="ef:RC71ElectronicSignatureDataType"/>
    <xsd:complexType name="RC71ElectronicSignatureDataType">
        <xsd:sequence>
            <xsd:element ref="ef:RC71ElectronicSignatureIndicator"/>
            <xsd:element ref="ef:RC71ElectronicSignatureDate" minOccurs="0"/>
            <xsd:element ref="ef:RC71ElectronicSignatureTime" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="RC71ElectronicSignatureIndicator" type="sdt:IndicatorType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Must be built when DiscounterRegistrationNumber element is present.  Valid values: 1 = YES; 0 = NO </xsd:documentation>
            <xsd:documentation xml:lang="fr">Doit-être construit quand l'élément « DiscounterRegistrationNumber » est présent. Valeurs valides : 1=OUI; 0=NON </xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:element name="RC71ElectronicSignatureDate" type="sdt:DateType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Must be entered if RC71ElectronicSignatureIndicator is set to Yes (1). Can be omitted if RC71ElectronicSignatureIndicator is set to No (0). Format is YYYY-MM-DD</xsd:documentation>
            <xsd:documentation xml:lang="fr">Doit être inscrit si l'indicateur de RC71 signé électroniquement « RC71ElectronicSignatureIndicator » est réglé à Oui (1). Peut être omis si RC71ElectronicSignatureIndicator est réglé à Non (0). Le format est AAAA-MM-JJ.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:element name="RC71ElectronicSignatureTime" type="sdt:TimeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Must be entered if RC71ElectronicSignatureDate has a valid entry. Format is HH:MM:SS</xsd:documentation>
            <xsd:documentation xml:lang="fr">Doit être inscrit si une entrée valide est inscrite pour la date de signature électronique du RC71 « RC71ElectronicSignatureDate ». Le format est HH:MM:SS </xsd:documentation>
        </xsd:annotation>
    </xsd:element>

    <xsd:element name="CVITPOrganizationIdentificationNumber">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Optional. The CVITP Organization Identification Number is a unique and permanent ID that will be assigned to an organization during the CVITP program registration approval process.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Optionnel. Le Numéro d'identification de l'organisme du PCBMI est un pièce d'identité unique et permanent qui sera attribué à une organisation pendant le processus d'approbation du programme PCBMI.</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
                <xsd:length value="8"/>
            <xsd:pattern value="[C|c][A-Za-z][A|B|C|L|M|N|O|P|Q|S|T|U|X|Y|a|b|c|l|m|n|o|p|q|s|t|u|x|y][0-9]{5}"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
	
	<xsd:element name="RepresentativeID">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Representative Identification Field</xsd:documentation>
            <xsd:documentation xml:lang="fr">Champ d'identification du représentant</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
                <xsd:length value="7"/>
                <xsd:pattern value="[A-Za-z0-9]{7}"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

</xsd:schema>
