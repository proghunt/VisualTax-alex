<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
Description: CRA Frrms Web Services - T2 forms
Type (Request or Response): Response
Version: 1-0-0
Date created:
Contact:
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:t2ersp="http://www.cra-arc.gc.ca/xmlns/t2ersp/t2efilefrrmsresponse/1-0-0"
    xmlns:t1rsp="http://www.cra-arc.gc.ca/xmlns/t1rsp/response/1-0-0"
    xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
    targetNamespace="http://www.cra-arc.gc.ca/xmlns/t2ersp/t2efilefrrmsresponse/1-0-0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="t2ersp/1-0-1">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/t1rsp/response/1-0-0" schemaLocation="t1wsresponse.xsd"/>

    <xsd:element name="T2EfileReturnResponse" type="t2ersp:T2EfileReturnResponseType"/>
    <xsd:complexType name="T2EfileReturnResponseType">
        <xsd:sequence>
            <xsd:element ref="t2ersp:T2ResultCode" minOccurs="0"/>
            <xsd:element ref="t2ersp:T2TransmissionNumber" minOccurs="0"/>
            <xsd:element ref="t2ersp:CorporationName" minOccurs="0"/>
            <xsd:element ref="t2ersp:BusinessNumber" minOccurs="0"/>
            <xsd:element ref="t2ersp:TaxYear" minOccurs="0"/>
            <xsd:element ref="t1rsp:FileReturnResponse"/>
            <xsd:element ref="t2ersp:TimeStamp" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="T2ResultCode" type="t2ersp:T2ResultCodeType" />
    <xsd:simpleType name="T2ResultCodeType" >
        <xsd:restriction base="xsd:string">
            <xsd:length value="6"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="T2TransmissionNumber" type="sdt:CodeType"/>

    <xsd:element name="CorporationName" type="t2ersp:NameDescription"/>
    <xsd:simpleType name="NameDescription" >
        <xsd:restriction base="xsd:string">
            <xsd:length value="255"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="BusinessNumber" type="t2ersp:BNRCType" />
    <xsd:simpleType name="BNRCType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([0-9]{9}RC[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="TaxYear" type="t2ersp:YearType"/>
    <xsd:simpleType name="YearType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([2][0][1-9]{2})"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="TimeStamp" type="sdt:DateTimeType"/>
       <xsd:annotation>
            <xsd:documentation xml:lang="en">Format is YYYY-MM-DDThh:mm:ss.sm</xsd:documentation>
            <xsd:documentation xml:lang="fr">Le format est AAAA-MM-JJThh:mm:ss.sm</xsd:documentation>
        </xsd:annotation>

</xsd:schema>
