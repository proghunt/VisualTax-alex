            <xsd:restriction base="sdt:TextType">
                <xsd:minLength value="9"/>
                <xsd:maxLength value="15"/>
                <xsd:whiteSpace value="collapse"/>
            </xsd:restriction>
        </xsd:simpleContent>
    </xsd:complexType>

	<xsd:complexType name="TextTwentyType">
