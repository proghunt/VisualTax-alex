<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
Description: T1134 Schema - Information Return Relating To Controlled And Not Controlled Foreign Affiliates
Contact: CRA, ITB, Solutions, IRBD, Assessment Processing Division, Electronic Filing
Date revised: June 2020
-->
<xsd:schema xmlns:t1134="http://www.cra-arc.gc.ca/xmlns/t1134/2021/1-0-0"
    xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
    xmlns:ccms="http://www.cra-arc.gc.ca/xmlns/ccms/1-1-0"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://www.cra-arc.gc.ca/xmlns/t1134/2021/1-0-0"
    elementFormDefault="qualified" attributeFormDefault="unqualified" version="t1134/2021/1-1-0">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/ccms/1-1-0" schemaLocation="cracommonstructures.xsd"/>

    <!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++ Schema  element ++++++++++++++++++++++++++++++++++++++++++++ -->

    <xsd:element name="ControlledAndNotControlledForeignAffiliateReturn" type="t1134:ControlledAndNotControlledForeignAffiliateReturnType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">There can be only one t1134 return in a file</xsd:documentation>
            <xsd:documentation xml:lang="fr">Il ne peut y avoir qu?un formulaire t1134 dans un fichier</xsd:documentation>
        </xsd:annotation>
		<xsd:key name="GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:GroupList"/>
			<xsd:field xpath="t1134:ReportingEntitySequenceNumber"/>
		</xsd:key>
		<xsd:keyref name="ReportingTaxpayerFirstSequenceNumberKeyRef"	refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:ReportingTaxpayerIdentification"/>
			<xsd:field xpath="t1134:ReportingTaxpayerFirstSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="IndividualReportingEntityKeyRef"	refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:GroupReportingRelatedEntities/t1134:IndividualGroup"/>
			<xsd:field xpath="t1134:IndividualReportingEntitySequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="CorporationReportingEntityKeyRef"	refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:GroupReportingRelatedEntities/t1134:CorporationGroup"/>
			<xsd:field xpath="t1134:CorporationReportingEntitySequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="TrustReportingEntityKeyRef"	refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:GroupReportingRelatedEntities/t1134:TrustGroup"/>
			<xsd:field xpath="t1134:TrustReportingEntitySequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="PartnershipReportingEntityKeyRef"	refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:GroupReportingRelatedEntities/t1134:PartnershipGroup"/>
			<xsd:field xpath="t1134:PartnershipReportingEntitySequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="OtherInformationReportingEntityKeyRef"	refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:EachEntityOtherInformation"/>
			<xsd:field xpath="t1134:OtherInformationReportingEntitySequenceNumber"/>
		</xsd:keyref>
		<xsd:key name="ForeignAffiliateKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:ForeignAffiliateList"/>
			<xsd:field xpath="t1134:ForeignAffiliateSequenceNumber"/>
		</xsd:key>
		<xsd:keyref name="CorporationForeignAffiliateKeyRef" refer="t1134:ForeignAffiliateKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:RelatedCorporation"/>
			<xsd:field xpath="t1134:ForeignAffiliateCorporationSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="RelatedForeignAffiliateKeyRef" refer="t1134:ForeignAffiliateKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:RelatedForeignAffiliate"/>
			<xsd:field xpath="t1134:RelatedForeignAffiliateSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="OtherForeignAffiliateKeyRef" refer="t1134:ForeignAffiliateKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:RelatedForeignAffiliate"/>
			<xsd:field xpath="t1134:OtherForeignAffiliateSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="PartnershipForeignAffiliateKeyRef" refer="t1134:ForeignAffiliateKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:PartnershipForeignAffiliate"/>
			<xsd:field xpath="t1134:PartnershipForeignAffiliateSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="DormantForeignAffiliateKeyRef" refer="t1134:ForeignAffiliateKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:DormantForeignAffiliate"/>
			<xsd:field xpath="t1134:DormantForeignAffiliateSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="NonControlledForeignAffiliateKeyRef" refer="t1134:ForeignAffiliateKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSummary/t1134:NonControlledForeignAffiliate"/>
			<xsd:field xpath="t1134:NonControlledForeignAffiliateSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="ForeignAffiliateIdentificationKeyRef" refer="t1134:ForeignAffiliateKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateIdentification"/>
			<xsd:field xpath="t1134:ForeignAffiliateIdentificationSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="DirectShareholdersKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateCapitalStock/t1134:DirectShareholders"/>
			<xsd:field xpath="t1134:DirectShareholdersSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="CommonShareholdersKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateCapitalStock/t1134:CommonSharesInformation"/>
			<xsd:field xpath="t1134:CommonShareHolderSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="PreferredShareholdersKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateCapitalStock/t1134:PreferredSharesInformation"/>
			<xsd:field xpath="t1134:PreferredShareHolderSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="LowestTierCanadianShareholderKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateCapitalStock/t1134:LowestTierCanadianShareholder"/>
			<xsd:field xpath="t1134:LowestTierCanadianShareholderSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="ForeignAffiliateOtherInformationKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateOtherInformation"/>
			<xsd:field xpath="t1134:ForeignAffiliateOtherInformationAccountSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="ForeignAffiliateDumpingRulesKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateDumpingRules"/>
			<xsd:field xpath="t1134:ForeignAffiliateDumpingRulesAccountSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="ExemptSurplusKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateSurplusAccount/t1134:ExemptSurplus"/>
			<xsd:field xpath="t1134:ExemptSurplusAccountSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="HybridSurplusKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateSurplusAccount/t1134:HybridSurplus"/>
			<xsd:field xpath="t1134:HybridSurplusAccountSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="TaxableSurplusKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateSurplusAccount/t1134:TaxableSurplus"/>
			<xsd:field xpath="t1134:TaxableSurplusAccountSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="PreAcquisitionSurplusKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateSurplusAccount/t1134:PreAcquisitionSurplus"/>
			<xsd:field xpath="t1134:PreAcquisitionSurplusAccountSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="UpstreamLoanRulesKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAffiliateSurplusAccount/t1134:UpstreamLoanRules"/>
			<xsd:field xpath="t1134:SurplusAccountSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="TransactionInvolvedEntityKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ControlledForeignAffiliateSurplusAccountShareTransaction/t1134:ReportingEntityTransaction/t1134:TransactionInvolvedEntity"/>
			<xsd:field xpath="t1134:InvolvedEntitySequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="ForeignAffiliateTransactionInvolvedEntityKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ControlledForeignAffiliateSurplusAccountShareTransaction/t1134:ForeignAffiliateTransaction/t1134:ForeignAffiliateTransactionInvolvedEntity"/>
			<xsd:field xpath="t1134:ReportingEntitySequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="EquityAndSurplusEntitlementChangeKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ControlledForeignAffiliateSurplusAccountShareTransaction/t1134:EquityAndSurplusEntitlementChange"/>
			<xsd:field xpath="t1134:EquityAndSurplusEntitlementChangeAccountSequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="OtherTransactionInvolvedEntityListKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ControlledForeignAffiliateSurplusAccountShareTransaction/t1134:OtherTransactionInvolvedEntityList"/>
			<xsd:field xpath="t1134:ReportingEntitySequenceNumber"/>
		</xsd:keyref>
		<xsd:keyref name="ParticipatingEntityKeyRef" refer="t1134:GroupMemberKey">
			<xsd:selector xpath="t1134:ControlledAndNotControlledForeignAffiliateSupplement/t1134:ForeignAccrualPropertyIncome/t1134:ReportingEntityParticipatingPercentage"/>
			<xsd:field xpath="t1134:ParticipatingEntitySequenceNumber"/>
		</xsd:keyref>
		
	</xsd:element>

    <!-- t1134 Form structure  -->
    <xsd:complexType name="ControlledAndNotControlledForeignAffiliateReturnType">
        <xsd:sequence>
            <xsd:element ref="t1134:SoftwareID" minOccurs="0"/>
            <xsd:element ref="t1134:SoftwareRevisionDate" minOccurs="0"/>
            <xsd:element ref="t1134:ControlledAndNotControlledForeignAffiliateSummary"/>
			<xsd:element ref="t1134:ControlledAndNotControlledForeignAffiliateSupplement" maxOccurs="unbounded" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ControlledAndNotControlledForeignAffiliateSummary" type="t1134:ControlledAndNotControlledForeignAffiliateSummaryType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Schema for T1134 Information Return Relating To Controlled and Not-Controlled Foreign Affiliate</xsd:documentation>
            <xsd:documentation xml:lang="fr">Schéma pour T1134 Déclaration de renseignements sur les sociétés étrangères affiliées qui sont contrôlées et non contrôlées.</xsd:documentation>
        </xsd:annotation>
		<xsd:unique name="ReportingEntityBusinessAccountNumberUnique">
			<xsd:selector xpath="t1134:GroupList/t1134:ReportingEntityAccountNumber/t1134:AccountBusinessNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="ReportingEntityIndividualAccountNumberUnique">
			<xsd:selector xpath="t1134:GroupList/t1134:ReportingEntityAccountNumber/t1134:AccountSocialInsuranceNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="ReportingEntityTrustAccountNumberUnique">
			<xsd:selector xpath="t1134:GroupList/t1134:ReportingEntityAccountNumber/t1134:AccountTrustNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="ReportingEntityPartnershipAccountNumberUnique">
			<xsd:selector xpath="t1134:GroupList/t1134:ReportingEntityAccountNumber/t1134:AccountPartnershipNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
<!--		<xsd:unique name="ForeignAffiliateNameUnique">
			<xsd:selector xpath="t1134:ForeignAffiliateList/t1134:ForeignAffiliateListName"/>
			<xsd:field xpath="."/>
		</xsd:unique>-->
		<xsd:unique name="ForeignAffiliateNameUnique">
			<xsd:selector xpath="t1134:ForeignAffiliateList/t1134:ForeignAffiliateListName"/>
			<xsd:field xpath="t1134:ForeignAffiliateListName"/>
		</xsd:unique>
		<xsd:unique name="AccountNumberUnique">
			<xsd:selector xpath="t1134:EachEntityOtherInformation/t1134:AccountNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="DormantForeignAffiliateNameUnique">
			<xsd:selector xpath="t1134:DormantForeignAffiliate/t1134:DormantForeignAffiliateName"/>
			<xsd:field xpath="t1134:DormantForeignAffiliateName"/>
		</xsd:unique>
		<xsd:unique name="NonControlledForeignAffiliateNameUnique">
			<xsd:selector xpath="t1134:NonControlledForeignAffiliate/t1134:NonControlledForeignAffiliateName"/>
			<xsd:field xpath="t1134:NonControlledForeignAffiliateName"/>
		</xsd:unique>
	</xsd:element>

    <xsd:element name="ControlledAndNotControlledForeignAffiliateSupplement" type="t1134:ControlledAndNotControlledForeignAffiliateSupplementType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Each foreign affiliate and/or controlled foreign affiliate that does not meet the criteria to be considered as a dormant affiliate should complete a separate supplement.</xsd:documentation>
            <xsd:documentation xml:lang="fr"></xsd:documentation>
        </xsd:annotation>
		<xsd:unique name="ForeignAffiliateOtherInformationAccountNumberUnique">
			<xsd:selector xpath="t1134:ForeignAffiliateOtherInformation/t1134:ForeignAffiliateOtherInformationAccountNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="ForeignAffiliateDumpingRulesAccountNumberUnique">
			<xsd:selector xpath="t1134:ForeignAffiliateDumpingRules/t1134:ForeignAffiliateDumpingRulesAccountNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
    </xsd:element>

    <!-- t1134 Summary Form structure  -->
    <xsd:complexType name="ControlledAndNotControlledForeignAffiliateSummaryType">
        <xsd:sequence>
            <xsd:element ref="t1134:SummaryActionCode"/>
			<xsd:element ref="t1134:GroupList"	maxOccurs="1500"/>
			<xsd:element ref="t1134:ForeignAffiliateList"	maxOccurs="unbounded"/>
            
            <!-- Top of Form Identification -->
            <xsd:element ref="t1134:FunctionalCurrencyCode" minOccurs="0"/>
            <xsd:element ref="t1134:AmendedReturnIndicator" minOccurs="0"/>
            <xsd:element ref="t1134:GroupReportingIndicator"/>

            <!-- Part I, Section 1 - Reporting entity identification -->
            <xsd:element ref="t1134:ReportingTaxpayerIdentification"/>
            <xsd:element ref="t1134:ReportingTaxpayerAddress"/>
            <xsd:element ref="t1134:ReportingTaxpayerNorthAmericanIndustryClassificationSystem"/>
            <xsd:element ref="t1134:TaxationYear"/>
            <xsd:element ref="t1134:ShortTaxationYearIndicator"/>
            <xsd:element ref="t1134:DeclaredSlipCount"/>

            <!-- Part I, Section 2 - Certification -->
            <xsd:element ref="t1134:CertificationDetail"/>

            <!-- Part I, Section 3.A - Related entities for a group Reporting -->
            <xsd:element ref="t1134:GroupReportingRelatedEntities"  minOccurs="0"/>

            <!-- Part I, Section 3.B - Other information for all entities -->
            <xsd:element ref="t1134:EachEntityOtherInformation"       maxOccurs="1500"/>

            <!-- Part I, Section 3.C - Organizational Chart -->
            <xsd:element ref="t1134:OrganizationalChartSubmittedIndicator"/>
			<xsd:element ref="t1134:RelatedCorporation"                 minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:RelatedForeignAffiliate"            minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:Partner"                            minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:PartnershipForeignAffiliate"        minOccurs="0" maxOccurs="1500"/>

            <!-- Part I, Section 3.D - Dormant Foreign Affiliates -->
            <xsd:element ref="t1134:DormantForeignAffiliate"            minOccurs="0" maxOccurs="1500"/>

            <!-- Part I, Section 3.E - Lower-tier Non-controlled Foreign Affiliates -->
            <xsd:element ref="t1134:NonControlledForeignAffiliate"      minOccurs="0" maxOccurs="1500"/>

        </xsd:sequence>
    </xsd:complexType>

    <!-- t1134 Supplement structure  -->
    <xsd:complexType name="ControlledAndNotControlledForeignAffiliateSupplementType">
        <xsd:sequence>
            <xsd:element ref="t1134:SupplementSequenceIdentifier"/>
            <xsd:element ref="t1134:SupplementActionCode"/>
            <xsd:element ref="t1134:SupplementDeleteReasonCode" minOccurs="0"/>

            <!-- Part II, Section 1.A - Identification of foreign affiliate -->
            <xsd:element ref="t1134:ForeignAffiliateIdentification"/>

            <!-- Part II, Section 1.B - Capital stock of foreign affiliate -->
            <xsd:element ref="t1134:ForeignAffiliateCapitalStock"/>

            <!-- Part II, Section 1.C - Other information of foreign affiliate -->
            <xsd:element ref="t1134:ForeignAffiliateOtherInformation" maxOccurs="1500"/>

            <!-- Part II, Section 1.D - Foreign affiliate dumping rules -->
            <xsd:element ref="t1134:ForeignAffiliateDumpingRules" minOccurs="0"	maxOccurs="1500"/>

            <!-- Part II, Section 2 - Financial formation of foreign affiliate -->
            <xsd:element ref="t1134:ForeignAffiliateFinancialInformation"/>

            <!-- Part II, Section 3.A - Surplus accounts of foreign affiliates -->
            <xsd:element ref="t1134:ForeignAffiliateSurplusAccount"/>

            <!-- Part II, Section 3.B - Surplus accounts and share transactions of controlled foreign affiliates -->
            <xsd:element ref="t1134:ControlledForeignAffiliateSurplusAccountShareTransaction" minOccurs="0"/>

            <!-- Part III, Section 1 - Employees -->
            <xsd:element ref="t1134:Employees" minOccurs="0"/>

            <!-- Part III, Section 2 - Composition of revenue -->
            <xsd:element ref="t1134:ControlledForeignAffiliateRevenueComposition" minOccurs="0"/>

            <!-- Part III, Section 3 - Foreign accrual property income or Foreign accrual property loss or Foreign accrual capital losses  -->
            <xsd:element ref="t1134:ForeignAccrualPropertyIncome" minOccurs="0"/>

            <!-- Part III, Section 4 - Income included in income from an active business  -->
            <xsd:element ref="t1134:OtherActiveBusinessIncome" minOccurs="0"/>

            <!-- Part IV - Disclosure -->
            <xsd:element ref="t1134:InformationRequestedNotAvailableIndicator" minOccurs="0"/>
            <xsd:element ref="t1134:InformationRequestedNotAvailableSummaryDescription" minOccurs="0"/>

        </xsd:sequence>
    </xsd:complexType>


    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Top of Form Identification -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->

    <xsd:element name="SummaryActionCode" type="t1134:ActionCodeType"/>

	<!-- Ghost table for all reposting entities-->
	<xsd:element name="GroupList" type="t1134:GroupListType"/>
	<xsd:complexType name="GroupListType">
		<xsd:sequence>
			<xsd:element name="ReportingEntitySequenceNumber" 	type="xsd:int"/>
			<xsd:element name="ReportingEntityAccountNumber" 	type="t1134:SelectAccountType"/>
		</xsd:sequence>
	</xsd:complexType>
	
	<!-- Ghost Table for Foreign Affiliate-->
	<xsd:element name="ForeignAffiliateList" type="t1134:ForeignAffiliateListType"/>
	<xsd:complexType name="ForeignAffiliateListType">
		<xsd:sequence>
			<xsd:element name="ForeignAffiliateSequenceNumber"	type="xsd:int"/>
			<xsd:element name="ForeignAffiliateListName"		type="t1134:NameDescription"/>
		</xsd:sequence>
	</xsd:complexType>

	
    <xsd:element name="FunctionalCurrencyCode">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Acceptable currency codes include the following: USD-U.S. dollar; AUD-Australian dollar; GBP-U.K. dollar; EUR-the Euro; JPY-Japanese Yen; OR leave blank.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Codes des monnaies acceptables sont les suivants: USD-dollar américain; AUD-dollar australien; GBP-pour la livre sterling du Royaume-Uni; EUR-pour l'euro; JPY-Yen japonais OU laisser en blanc</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:length value="3"/>
                <xsd:enumeration value="USD"/>
                <xsd:enumeration value="usd"/>
                <xsd:enumeration value="AUD"/>
                <xsd:enumeration value="aud"/>
                <xsd:enumeration value="GBP"/>
                <xsd:enumeration value="gbp"/>
                <xsd:enumeration value="EUR"/>
                <xsd:enumeration value="eur"/>
				<xsd:enumeration value="JPY"/>
                <xsd:enumeration value="jpy"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <xsd:element name="AmendedReturnIndicator" type="t1134:BooleanIndicatorType"/>

    <xsd:element name="GroupReportingIndicator" type="t1134:BooleanIndicatorType"/>
    <xsd:annotation>
            <xsd:documentation xml:lang="en">Must specify whether the Reporting is for one single entity or for a group of Reporting entities. Mandatory. Default value: blank</xsd:documentation>
            <xsd:documentation xml:lang="fr"></xsd:documentation>
    </xsd:annotation>

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part I, Section 1 - Reporting entity identification -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->

    <xsd:element name="ReportingTaxpayerIdentification" type="t1134:ReportingTaxpayerIdentificationType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">A t1134 form can be transmitted for Individual, Corporation, Trust, or Partnership taxpayers.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Un formulaire t1134 peut être transmis pour Particulier, Société, Fiducie, ou Société de personnes.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>

    <xsd:complexType name="ReportingTaxpayerIdentificationType">
    	<xsd:sequence>
    		<xsd:element name="ReportingTaxpayerIDCode"	type="t1134:OrganizationalStructureClientCodeType"/>
			<xsd:element name="ReportingTaxpayerFirstSequenceNumber"		type="xsd:int"	fixed="1"/>
			<xsd:choice>
	                <xsd:element name="Corporation" 	type="t1134:CorporationType"/>
					<xsd:element name="Individual"  	type="t1134:IndividualType"/>
					<xsd:element name="Trust"       	type="t1134:TrustType"/>
					<xsd:element name="Partnership" 	type="t1134:PartnershipType"/>
	        </xsd:choice>
	    </xsd:sequence>
    </xsd:complexType>
	
	<!-- CORPORATION -->
    <xsd:complexType name="CorporationType">
        <xsd:sequence>
            <xsd:element ref="t1134:CorporationName"/>
            <xsd:element ref="t1134:BusinessNumber"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="CorporationName" type="t1134:NameDescription"/>

    <!-- INDIVIDUAL -->
    <xsd:complexType name="IndividualType">
        <xsd:sequence>
            <xsd:element ref="t1134:IndividualFirstName"/>
            <xsd:element ref="t1134:IndividualLastName"/>
            <xsd:element ref="t1134:IndividualInitial"	minOccurs="0" />
            <xsd:element ref="t1134:IndividualSIN"/>
         </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="IndividualFirstName"	type="t1134:TextSixtyType"/>
    <xsd:element name="IndividualLastName"	type="t1134:TextSixtyType"/>
    <xsd:element name="IndividualInitial" 	type="t1134:TextTwoType"/>
    <xsd:element name="IndividualSIN" 		type="ccms:SINType"/>

    <!-- TRUST -->
    <xsd:complexType name="TrustType">
        <xsd:sequence>
            <xsd:element ref="t1134:TrustName"/>
            <xsd:element ref="ccms:TrustNumber"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="TrustName" 	type="t1134:NameDescription"/>
    
    <!-- PARTNERSHIP -->
    <xsd:complexType name="PartnershipType">
        <xsd:sequence>
            <xsd:element ref="t1134:PartnershipName"/>
            <xsd:element ref="t1134:PartnershipNumber"/>
            <xsd:element ref="t1134:PartnershipCode"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="PartnershipName" type="t1134:NameDescription"/>
    <xsd:element name="PartnershipCode"	type="t1134:PartnershipCodeType"/>

    <xsd:simpleType name="PartnershipCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Valid codes are 1, 2 or 3.  1=Individuals or Trusts. 2=Corporations. 3=Combination of Individuals, Trusts or Corporations</xsd:documentation>
            <xsd:documentation xml:lang="fr">Les codes valides sont 1, 2 ou 3. 1=Particuliers ou Fiducies. 2=Sociétés. 3=Combinaison de Particuliers, Fiducies ou Sociétés</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:CodeType">
            <xsd:enumeration value="1"/>
            <xsd:enumeration value="2"/>
            <xsd:enumeration value="3"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Reporting Entity Address -->
    <xsd:element name="ReportingTaxpayerAddress" type="t1134:ReportingTaxpayerAddressType"/>
    <xsd:complexType name="ReportingTaxpayerAddressType">
        <xsd:sequence>
            <xsd:element ref="t1134:AddressNumber"/>
            <xsd:element ref="t1134:AddressStreetText"/>
            <xsd:element ref="t1134:AddressMunicipalityName"/>
            <xsd:element ref="t1134:GlobalProvinceTerritoryStateCode"   minOccurs="0"/>     <!-- Mandatory for CAN/UAS -->
            <xsd:element ref="t1134:GlobalPostalZipCode"    minOccurs="0"/>     <!-- Mandatory for CAN/UAS -->
            <xsd:element ref="t1134:CountryCode"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="AddressNumber"						type="t1134:TextTwentyType"/>
    <xsd:element name="AddressStreetText"					type="t1134:TextTwentyType"/>
    <xsd:element name="AddressMunicipalityName"				type="t1134:TextFiftyType"/>
    <xsd:element name="CountryCode" 						type="ccms:CountryCodeType"/>

    <!-- Reporting Entity NorthAmericanIndustryClassificationSystem -->						   
    <xsd:element name="ReportingTaxpayerNorthAmericanIndustryClassificationSystem" type="t1134:NorthAmericanIndustryClassificationSystemType"/>

    <!-- Taxation Year Start End Dates -->
    <xsd:element name="TaxationYear" type="t1134:TaxationYearType"/>
    <xsd:complexType name="TaxationYearType">
        <xsd:sequence>
            <xsd:element ref="t1134:TaxationYearStartDate"/>
            <xsd:element ref="t1134:TaxationYearEndDate"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="TaxationYearStartDate"   type="sdt:DateType"/>
    <xsd:element name="TaxationYearEndDate"     type="sdt:DateType"/>

    <xsd:element name="ShortTaxationYearIndicator"  type="t1134:BooleanIndicatorType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Indication that the t1134 includes 2 or more short taxation years - Value "1" (Yes); Value "0" (No)</xsd:documentation>
            <xsd:documentation xml:lang="fr">Indication que le t1134 inclue 2 ou plus années d'imposition - Valeur "1" (Oui); Valeur "0" (Non)</xsd:documentation>
        </xsd:annotation>
    </xsd:element>

    <xsd:element name="DeclaredSlipCount">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Number of slips associated with this form.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Nombre de feuillets associés à ce formulaire </xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:CountType">
                <xsd:minInclusive value="00001"/>
                <xsd:totalDigits value="5"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part I, Section 2 - Certification -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <xsd:element name="CertificationDetail" type="t1134:CertificationDetailType"/>
    <xsd:complexType name="CertificationDetailType">
        <xsd:sequence>
            <xsd:element ref="t1134:ContactPersonFirstName"/>
            <xsd:element ref="t1134:ContactPersonLastName"/>
            <xsd:element ref="t1134:ContactPersonPhoneNumber"/>
            <xsd:element ref="t1134:CertifierName"/>
            <xsd:element ref="t1134:CertificationDate"/>
            <xsd:element ref="t1134:CertifierPositionTitle"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ContactPersonFirstName"      type="t1134:TextSixtyType"/>
    <xsd:element name="ContactPersonLastName"       type="t1134:TextSixtyType"/>
    <xsd:element name="ContactPersonPhoneNumber"    type="t1134:PhoneNumberType"/>
    <xsd:element name="CertifierName"               type="t1134:TextSixtyType"/>
    <xsd:element name="CertificationDate"           type="sdt:DateType"/>
    <xsd:element name="CertifierPositionTitle"      type="t1134:TextSixtyType"/>

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part I, Section 3 - Organizational Structure -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->

    <!-- Part I, Section 3.A - Related entities for a group Reporting -->
    <xsd:element name="GroupReportingRelatedEntities"   type="t1134:GroupReportingRelatedEntitiesType">
		<xsd:unique name="IndividualGroupMemberSINUnique">
			<xsd:selector xpath="t1134:IndividualGroup/t1134:IndividualGroupMemberSIN"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="CorporationGroupMemberBusinessNumberUnique">
			<xsd:selector xpath="t1134:CorporationGroup/t1134:CorporationGroupMemberBusinessNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="TrustGroupMemberNumberUnique">
			<xsd:selector xpath="t1134:TrustGroup/t1134:TrustGroupMemberNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="PartnershipGroupMemberNumberUnique">
			<xsd:selector xpath="t1134:PartnershipGroup/t1134:PartnershipGroupMemberNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
	</xsd:element>
    <xsd:complexType name="GroupReportingRelatedEntitiesType">
        <xsd:sequence>
            <xsd:element ref="t1134:IndividualGroup"                    minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:CorporationGroup"                   minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:TrustGroup"                         minOccurs="0" maxOccurs="1500"/>
			<xsd:element ref="t1134:PartnershipGroup"                   minOccurs="0" maxOccurs="1500"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="IndividualGroup"         type="t1134:IndividualGroupType"/>
	<xsd:complexType name="IndividualGroupType">
        <xsd:sequence>
			<xsd:element ref="t1134:IndividualReportingEntitySequenceNumber"/>
            <xsd:element ref="t1134:IndividualGroupMemberFirstName"/>
			<xsd:element ref="t1134:IndividualGroupMemberLastName"/>
			<xsd:element ref="t1134:IndividualGroupMemberInitial"	minOccurs="0"/>
            <xsd:element ref="t1134:IndividualGroupMemberAddress"/>
            <xsd:element ref="t1134:IndividualGroupMemberSIN"/>
        </xsd:sequence>
    </xsd:complexType>
	<xsd:element name="IndividualReportingEntitySequenceNumber"		type="t1134:GroupReportingEntitySequenceNumberType"/>
    <xsd:element name="IndividualGroupMemberFirstName"				type="t1134:TextSixtyType"/>
	<xsd:element name="IndividualGroupMemberLastName"				type="t1134:TextSixtyType"/>
	<xsd:element name="IndividualGroupMemberInitial"				type="t1134:TextTwoType"/>
    <xsd:element name="IndividualGroupMemberAddress"    			type="t1134:ReportingTaxpayerAddressType"/>
    <xsd:element name="IndividualGroupMemberSIN"					type="ccms:SINType"/>
    
    <xsd:element name="CorporationGroup"        type="t1134:CorporationGroupType"/>
    <xsd:complexType name="CorporationGroupType">
        <xsd:sequence>
			<xsd:element ref="t1134:CorporationReportingEntitySequenceNumber"/>
            <xsd:element ref="t1134:CorporationGroupMemberName"/>
			<xsd:element ref="t1134:CorporationGroupMemberBusinessNumber"/>
            <xsd:element ref="t1134:CorporationGroupMemberAddress"/>
            <xsd:element ref="t1134:CorporationGroupMemberNorthAmericanIndustryClassificationSystem"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="CorporationReportingEntitySequenceNumber"	type="t1134:GroupReportingEntitySequenceNumberType"/>
	<xsd:element name="CorporationGroupMemberName"          		type="t1134:NameDescription"/>
	<xsd:element name="CorporationGroupMemberBusinessNumber"		type="t1134:BNRCType"/>
    <xsd:element name="CorporationGroupMemberAddress"   			type="t1134:ReportingTaxpayerAddressType"/>
    <xsd:element name="CorporationGroupMemberNorthAmericanIndustryClassificationSystem"     type="t1134:NorthAmericanIndustryClassificationSystemType"/>

    <xsd:element name="TrustGroup"              type="t1134:TrustGroupType"/>
	<xsd:complexType name="TrustGroupType">
        <xsd:sequence>
			<xsd:element ref="t1134:TrustReportingEntitySequenceNumber"/>
            <xsd:element ref="t1134:TrustGroupMemberName"/>
			<xsd:element ref="t1134:TrustGroupMemberNumber"/>
            <xsd:element ref="t1134:TrustGroupMemberAddress"/>
            <xsd:element ref="t1134:TrustGroupMemberNorthAmericanIndustryClassificationSystem"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="TrustReportingEntitySequenceNumber"	type="t1134:GroupReportingEntitySequenceNumberType"/>
	<xsd:element name="TrustGroupMemberName"            	type="t1134:NameDescription"/>
	<xsd:element name="TrustGroupMemberNumber"				type="ccms:TrustNumberType"/>
    <xsd:element name="TrustGroupMemberAddress"     		type="t1134:ReportingTaxpayerAddressType"/>
    <xsd:element name="TrustGroupMemberNorthAmericanIndustryClassificationSystem"       type="t1134:NorthAmericanIndustryClassificationSystemType"/>

    <xsd:element name="PartnershipGroup"        type="t1134:PartnershipGroupType"/>
	<xsd:complexType name="PartnershipGroupType">
        <xsd:sequence>
            <xsd:element ref="t1134:PartnershipReportingEntitySequenceNumber"/>
			<xsd:element ref="t1134:PartnershipGroupMemberName"/>
			<xsd:element ref="t1134:PartnershipGroupMemberNumber"/>
			<xsd:element ref="t1134:PartnershipGroupMemberCode"/>
            <xsd:element ref="t1134:PartnershipGroupMemberAddress"/>
            <xsd:element ref="t1134:PartnershipGroupMemberNorthAmericanIndustryClassificationSystem"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="PartnershipReportingEntitySequenceNumber"	type="t1134:GroupReportingEntitySequenceNumberType"/>
	<xsd:element name="PartnershipGroupMemberName"          		type="t1134:NameDescription"/>
	<xsd:element name="PartnershipGroupMemberNumber"				type="t1134:BNRZType"/>
	<xsd:element name="PartnershipGroupMemberCode"					type="t1134:PartnershipCodeType"/>
    <xsd:element name="PartnershipGroupMemberAddress"   			type="t1134:ReportingTaxpayerAddressType"/>
    <xsd:element name="PartnershipGroupMemberNorthAmericanIndustryClassificationSystem"     type="t1134:NorthAmericanIndustryClassificationSystemType"/>

    <!-- Part I, Section 3.B - Other information for all entities -->
    <xsd:element name="EachEntityOtherInformation" type="t1134:EachEntityOtherInformationType"/>
	<xsd:complexType name="EachEntityOtherInformationType">
        <xsd:sequence>
            <xsd:element ref="t1134:OtherInformationReportingEntitySequenceNumber"/>
			<xsd:element ref="t1134:AccountNumber"/>
            <xsd:element ref="t1134:Section85_Indicator"/>
            <xsd:element ref="t1134:Section85_1_3_Indicator"/>
            <xsd:element ref="t1134:Section86_1_Indicator"/>
            <xsd:element ref="t1134:Section87_Indicator"/>
            <xsd:element ref="t1134:Section88_1_Indicator"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="OtherInformationReportingEntitySequenceNumber"	type="xsd:int"/>
	<xsd:element name="AccountNumber"               type="t1134:AccountNumberType"/>
    <xsd:element name="Section85_Indicator"         type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section85_1_3_Indicator"     type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section86_1_Indicator"       type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section87_Indicator"         type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section88_1_Indicator"       type="t1134:BooleanIndicatorType"/>

    <!-- Part I, Section 3.C - Organizational Chart-->
    <xsd:element name="OrganizationalChartSubmittedIndicator"   type="t1134:BooleanIndicatorType"/>
	
	<!-- Part I, Section 3.C - Table i) -->
    <xsd:element name="RelatedCorporation" type="t1134:RelatedCorporationType"/>
	<xsd:complexType name="RelatedCorporationType">
        <xsd:sequence>
            <xsd:element ref="t1134:RelatedCorporationName"/>
            <xsd:element ref="t1134:CorporationResidenceCountryCode"/>
			<xsd:element ref="t1134:ForeignAffiliateCorporationSequenceNumber"/>
            <xsd:element ref="t1134:ForeignAffiliateCorporationName"/>
            <xsd:element ref="t1134:TaxpayerIdentificationNumberforNonResident" minOccurs="0"/>
            <xsd:element ref="t1134:ForeignAffiliateCorporationResidenceCountryCode"/>
            <xsd:element ref="t1134:ForeignAffiliateCorporationEquityPercentage"/>
            <xsd:element ref="t1134:ForeignAffiliateCorporationDirectEquityPercentage"/>
            <xsd:element ref="t1134:SupplementNotFiledDueToDormancyCorporation"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="RelatedCorporationName"                            type="t1134:NameDescription"/>
    <xsd:element name="CorporationResidenceCountryCode"                   type="ccms:CountryCodeType"/>
	<xsd:element name="ForeignAffiliateCorporationSequenceNumber"		  type="xsd:int"/>
    <xsd:element name="ForeignAffiliateCorporationName"                   type="t1134:NameDescription"/>
    <xsd:element name="TaxpayerIdentificationNumberforNonResident"        type="ccms:Name50CharacterType"/>
    <xsd:element name="ForeignAffiliateCorporationResidenceCountryCode"   type="ccms:CountryCodeType"/>
    <xsd:element name="ForeignAffiliateCorporationEquityPercentage"       type="t1134:PercentageType"/>
    <xsd:element name="ForeignAffiliateCorporationDirectEquityPercentage" type="t1134:PercentageType"/>
    <xsd:element name="SupplementNotFiledDueToDormancyCorporation"        type="t1134:BooleanIndicatorType"/>

    <!-- Part I, Section 3.C - Table ii) -->
    <xsd:element name="RelatedForeignAffiliate" type="t1134:RelatedForeignAffiliateType"/>
	<xsd:complexType name="RelatedForeignAffiliateType">
        <xsd:sequence>
            <xsd:element ref="t1134:RelatedForeignAffiliateSequenceNumber"/>
			<xsd:element ref="t1134:RelatedForeignAffiliateName"/>
            <xsd:element ref="t1134:ForeignAffiliateShareholderTaxpayerIdentificationNumber" minOccurs="0"/>
            <xsd:element ref="t1134:ForeignAffiliateResidenceCountryCode"/>
			<xsd:element ref="t1134:OtherForeignAffiliateSequenceNumber"/>
            <xsd:element ref="t1134:OtherForeignAffiliateName"/>
            <xsd:element ref="t1134:OtherForeignAffiliateTaxpayerIdentificationNumber" minOccurs="0"/>
            <xsd:element ref="t1134:OtherForeignAffiliateResidenceCountryCode"/>
            <xsd:element ref="t1134:OtherForeignAffiliateEquityPercentage"/>
            <xsd:element ref="t1134:OtherForeignAffiliateDirectEquityPercentage"/>
            <xsd:element ref="t1134:SupplementNotFiledDueToDormancyForeignAffiliate"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="RelatedForeignAffiliateSequenceNumber"					type="xsd:int"/>
	<xsd:element name="RelatedForeignAffiliateName"                             type="t1134:NameDescription"/>
    <xsd:element name="ForeignAffiliateShareholderTaxpayerIdentificationNumber" type="ccms:Name50CharacterType"/>
    <xsd:element name="ForeignAffiliateResidenceCountryCode"                    type="ccms:CountryCodeType"/>
    <xsd:element name="OtherForeignAffiliateSequenceNumber"						type="xsd:int"/>
	<xsd:element name="OtherForeignAffiliateName"                               type="t1134:NameDescription"/>
    <xsd:element name="OtherForeignAffiliateTaxpayerIdentificationNumber"       type="ccms:Name50CharacterType"/>
    <xsd:element name="OtherForeignAffiliateResidenceCountryCode"               type="ccms:CountryCodeType"/>
    <xsd:element name="OtherForeignAffiliateEquityPercentage"                   type="t1134:PercentageType"/>
    <xsd:element name="OtherForeignAffiliateDirectEquityPercentage"             type="t1134:PercentageType"/>
    <xsd:element name="SupplementNotFiledDueToDormancyForeignAffiliate"         type="t1134:BooleanIndicatorType"/>

    <!-- Part I, Section 3.C - Table iii) -->
    <xsd:element name="Partner" type="t1134:PartnerType"/>
	<xsd:complexType name="PartnerType">
        <xsd:sequence>
            <xsd:element ref="t1134:PartnerName"/>
            <xsd:element ref="t1134:PartnerAddress"/>
            <xsd:element ref="t1134:ResidencePartnerCountryCode"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="PartnerName"                 type="t1134:NameDescription"/>
    <xsd:element name="PartnerAddress"              type="t1134:TextTwoHundredType"/>
    <xsd:element name="ResidencePartnerCountryCode" type="ccms:CountryCodeType"/>

    <!-- Part I, Section 3.C - Table iv) -->
    <xsd:element name="PartnershipForeignAffiliate" type="t1134:PartnershipForeignAffiliateType"/>
	<xsd:complexType name="PartnershipForeignAffiliateType">
        <xsd:sequence>
            <xsd:element ref="t1134:ForeignAffiliateMemberPartnershipName"/>
            <xsd:element ref="t1134:PartnershipAddress"/>
            <xsd:element ref="t1134:LocationPartnershipCountryCode"/>
			<xsd:element ref="t1134:PartnershipForeignAffiliateSequenceNumber"/>
            <xsd:element ref="t1134:PartnershipForeignAffiliateName"/>
            <xsd:element ref="t1134:ForeignAffiliatePartnershipInterestPercentage"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ForeignAffiliateMemberPartnershipName"         type="t1134:NameDescription"/>
    <xsd:element name="PartnershipAddress"                            type="t1134:TextTwoHundredType"/>
    <xsd:element name="LocationPartnershipCountryCode"                type="ccms:CountryCodeType"/>
	<xsd:element name="PartnershipForeignAffiliateSequenceNumber"	  type="xsd:int"/>
    <xsd:element name="PartnershipForeignAffiliateName"               type="t1134:NameDescription"/>
    <xsd:element name="ForeignAffiliatePartnershipInterestPercentage" type="t1134:PercentageType"/>

    <!-- Part I, Section 3.D - Dormant Foreign Affiliates -->
    <xsd:element name="DormantForeignAffiliate" type="t1134:DormantForeignAffiliateType"/>
	<xsd:complexType name="DormantForeignAffiliateType">
        <xsd:sequence>
            <xsd:element ref="t1134:DormantForeignAffiliateSequenceNumber"/>
			<xsd:element ref="t1134:DormantForeignAffiliateName"/>
            <xsd:element ref="t1134:DormantForeignAffiliateCost"/>
            <xsd:element ref="t1134:DormantForeignAffiliateReceipt"/>
            <xsd:element ref="t1134:DormantForeignAffiliateGrossRevenue"/>
            <xsd:element ref="t1134:DormantForeignAffiliateHoldingAsset"    minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="DormantForeignAffiliateSequenceNumber"	type="xsd:int"/>
	<xsd:element name="DormantForeignAffiliateName"             type="t1134:NameDescription"/>
    <xsd:element name="DormantForeignAffiliateCost"             type="t1134:ThousandTrillionAmountType"/>
    <xsd:element name="DormantForeignAffiliateReceipt"          type="t1134:ThousandTrillionAmountType"/>
    <xsd:element name="DormantForeignAffiliateGrossRevenue"     type="t1134:ThousandTrillionAmountType"/>
    <xsd:element name="DormantForeignAffiliateHoldingAsset"     type="t1134:DormantForeignAffiliateHoldingAssetType"/>
    <xsd:complexType name="DormantForeignAffiliateHoldingAssetType">
        <xsd:all>
            <xsd:element name="Funds"                                   type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="Shares"                                  type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="IndebtednessOwedByNonResident"           type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="InterestInNonResidentTrust"              type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="RealPropertyOutsideCanada"               type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="OtherPropertyOutsideCanada"              type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="PropertyHeldInAccountWithCanadianDealer" type="t1134:BooleanIndicatorType"   minOccurs="0"/>
        </xsd:all>
    </xsd:complexType>

    <!-- Part I, Section 3.E - Lower-tier Non-controlled Foreign Affiliates -->
    <xsd:element name="NonControlledForeignAffiliate"       type="t1134:NonControlledForeignAffiliateType"/>
	<xsd:complexType name="NonControlledForeignAffiliateType">
        <xsd:sequence>
            <xsd:element ref="t1134:NonControlledForeignAffiliateSequenceNumber"/>
			<xsd:element ref="t1134:NonControlledForeignAffiliateName"/>
            <xsd:element ref="t1134:NonControlledForeignAffiliateTaxpayerIdentificationNumber"/>
            <xsd:element ref="t1134:NonControlledForeignAffiliateCountry"/>
            <xsd:element ref="t1134:NonControlledForeignAffiliateYear"/>
            <xsd:element ref="t1134:CeasedForeignAffiliateIndicator"/>
            <xsd:element ref="t1134:SurplusAccountImpactedIndicator"/>
            <xsd:element ref="t1134:ReportingEntityEquityChangeIndicator"/>
            <xsd:element ref="t1134:Paragraph95_2_2_a_Indicator"/>
            <xsd:element ref="t1134:IndebtedForeignAffiliateIndicator"/>
            <xsd:element ref="t1134:IndebtedReportingEntityIndicator"/>
            <xsd:element ref="t1134:Subsection212_3_2_ApplyIndicator"/>
            <xsd:element ref="t1134:DividendDistributionIssuedIndicator"/>
            <xsd:element ref="t1134:BypassElectionMadeIndicator"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="NonControlledForeignAffiliateSequenceNumber"	type="xsd:int"/>
	<xsd:element name="NonControlledForeignAffiliateName"           type="t1134:NameDescription"/>
    <xsd:element name="NonControlledForeignAffiliateTaxpayerIdentificationNumber"   type="ccms:Name50CharacterType"/>
    <xsd:element name="NonControlledForeignAffiliateCountry"        type="ccms:CountryCodeType"/>
    <xsd:element name="NonControlledForeignAffiliateYear"           type="sdt:YearType"/>
    <xsd:element name="CeasedForeignAffiliateIndicator"             type="t1134:BooleanIndicatorType"/>
    <xsd:element name="SurplusAccountImpactedIndicator"             type="t1134:BooleanIndicatorType"/>
    <xsd:element name="ReportingEntityEquityChangeIndicator"        type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Paragraph95_2_2_a_Indicator"                 type="t1134:BooleanIndicatorType"/>
    <xsd:element name="IndebtedForeignAffiliateIndicator"           type="t1134:BooleanIndicatorType"/>
    <xsd:element name="IndebtedReportingEntityIndicator"            type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Subsection212_3_2_ApplyIndicator"            type="t1134:BooleanIndicatorType"/>
    <xsd:element name="DividendDistributionIssuedIndicator"         type="t1134:BooleanIndicatorType"/>
    <xsd:element name="BypassElectionMadeIndicator"                 type="t1134:BooleanIndicatorType"/>


    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part II, Supplement -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->

    <xsd:element name="SupplementSequenceIdentifier" type="t1134:SupplementSequenceIdentifierType"/>
    <xsd:element name="SupplementActionCode"         type="t1134:ActionCodeType"/>
    <xsd:element name="SupplementDeleteReasonCode"   type="t1134:SupplementDeleteReasonCodeType"/>

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part II, Section 1.A - Identification of foreign affiliate -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->

    <xsd:element name="ForeignAffiliateIdentification" type="t1134:ForeignAffiliateIdentificationType"/>
    <xsd:complexType name="ForeignAffiliateIdentificationType">
        <xsd:sequence>
            <xsd:element ref="t1134:ForeignAffiliateIdentificationSequenceNumber"/>
			<xsd:element ref="t1134:ForeignAffiliateIdentificationName"/>
            <xsd:element ref="t1134:HeadOfficeAddress"/>
            <xsd:element ref="t1134:ForeignAffiliateTaxpayerIdentificationNumber"   minOccurs="0"/>
            <xsd:element ref="t1134:NorthAmericanIndustryClassificationSystem"/>
            <xsd:element ref="t1134:BusinessIncomeEarningCountry"/>
            <xsd:element ref="t1134:TaxPayableCountry"/>
            <xsd:element ref="t1134:ForeignAffiliateJurisdictionResidenceCountryCode"/>
            <xsd:element ref="t1134:ReportingEntityFirstTimeFilerIndicator"/>
            <xsd:element ref="t1134:ControlledForeignAffiliateIndicator"/>
            <xsd:element ref="t1134:MultiTaxYearEndingIndicator"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ForeignAffiliateIdentificationSequenceNumber" type="xsd:int"/>
	<xsd:element name="ForeignAffiliateIdentificationName"                type="t1134:NameDescription"/>
    <xsd:element name="HeadOfficeAddress"                                 type="t1134:TextTwoHundredType"/>
    <xsd:element name="ForeignAffiliateTaxpayerIdentificationNumber"      type="ccms:Name50CharacterType"/>
    <xsd:element name="NorthAmericanIndustryClassificationSystem"         type="t1134:NorthAmericanIndustryClassificationSystemType"/>
    <xsd:element name="BusinessIncomeEarningCountry"                      type="t1134:CountryType"/>
    <xsd:element name="TaxPayableCountry"                                 type="t1134:CountryType"/>
    <xsd:element name="ForeignAffiliateJurisdictionResidenceCountryCode"  type="ccms:CountryCodeType"/>
    <xsd:element name="ReportingEntityFirstTimeFilerIndicator"            type="t1134:BooleanIndicatorType"/>
    <xsd:element name="ControlledForeignAffiliateIndicator"               type="t1134:BooleanIndicatorType"/>
    <xsd:element name="MultiTaxYearEndingIndicator"                       type="t1134:BooleanIndicatorType"/>

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part II, Section 1.B - Capital stock of foreign affiliate -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <xsd:element name="ForeignAffiliateCapitalStock"        type="t1134:ForeignAffiliateCapitalStockType">
		<xsd:unique name="DirectShareholdersBusinessAccountNumberUnique">
			<xsd:selector xpath="t1134:DirectShareholders/t1134:DirectShareholdersAccountNumber/t1134:AccountBusinessNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="DirectShareholdersIndividualAccountNumberUnique">
			<xsd:selector xpath="t1134:DirectShareholders/t1134:DirectShareholdersAccountNumber/t1134:AccountSocialInsuranceNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="DirectShareholdersTrustAccountNumberUnique">
			<xsd:selector xpath="t1134:DirectShareholders/t1134:DirectShareholdersAccountNumber/t1134:AccountTrustNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="DirectShareholdersPartnershipAccountNumberUnique">
			<xsd:selector xpath="t1134:DirectShareholders/t1134:DirectShareholdersAccountNumber/t1134:AccountPartnershipNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="CommonShareHolderAccountNumberUnique">
			<xsd:selector xpath="t1134:CommonSharesInformation/t1134:CommonShareHolderAccountNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="PreferredShareHolderAccountNumberUnique">
			<xsd:selector xpath="t1134:PreferredSharesInformation/t1134:PreferredShareHolderAccountNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="LowestTierCanadianShareholderBusinessAccountNumberUnique">
			<xsd:selector xpath="t1134:LowestTierCanadianShareholder/t1134:LowestTierCanadianShareholderAccountNumber/t1134:AccountBusinessNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="LowestTierCanadianShareholderIndividualAccountNumberUnique">
			<xsd:selector xpath="t1134:LowestTierCanadianShareholder/t1134:LowestTierCanadianShareholderAccountNumber/t1134:AccountSocialInsuranceNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="LowestTierCanadianShareholderTrustAccountNumberUnique">
			<xsd:selector xpath="t1134:LowestTierCanadianShareholder/t1134:LowestTierCanadianShareholderAccountNumber/t1134:AccountTrustNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="LowestTierCanadianShareholderPartnershipAccountNumberUnique">
			<xsd:selector xpath="t1134:LowestTierCanadianShareholder/t1134:LowestTierCanadianShareholderAccountNumber/t1134:AccountPartnershipNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
	</xsd:element>
    <xsd:complexType name="ForeignAffiliateCapitalStockType">
        <xsd:sequence>
            <xsd:element ref="t1134:DirectShareholders"             minOccurs="0"   maxOccurs="1500"/>
            <xsd:element ref="t1134:CommonSharesInformation"        minOccurs="0"   maxOccurs="1500"/>
            <xsd:element ref="t1134:PreferredSharesInformation"     minOccurs="0"   maxOccurs="1500"/>
            <xsd:element ref="t1134:LowestTierCanadianShareholder"  minOccurs="0"   maxOccurs="1500"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- Part II, Section 1.B - Table i) -->
    <xsd:element name="DirectShareholders"              type="t1134:DirectShareholdersType"/>
	<xsd:complexType name="DirectShareholdersType">
        <xsd:sequence>
            <xsd:element ref="t1134:DirectShareholdersName"/>
			<xsd:element ref="t1134:DirectShareholdersSequenceNumber"/>
            <xsd:element ref="t1134:DirectShareholdersAccountNumber"/>
            <xsd:element ref="t1134:ForeignAffiliateStartYear"/>
            <xsd:element ref="t1134:CeaseToBeForeignAffiliateIndicator"/>
            <xsd:element ref="t1134:Subsection93_1_ElectionIndicator"	minOccurs="0"/>
            <xsd:element ref="t1134:Subsection93_1_ElectionAmount"	minOccurs="0"/>
            <xsd:element ref="t1134:Subsection93_1_ElectionCurrencyCode"	minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="DirectShareholdersName"                  type="t1134:NameDescription"/>
	<xsd:element name="DirectShareholdersSequenceNumber"		type="xsd:int"/>
    <xsd:element name="DirectShareholdersAccountNumber"         type="t1134:SelectAccountType"/>
    <xsd:element name="ForeignAffiliateStartYear"               type="sdt:YearType"/>
    <xsd:element name="CeaseToBeForeignAffiliateIndicator"      type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Subsection93_1_ElectionIndicator"        type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Subsection93_1_ElectionAmount"           type="t1134:ThousandTrillionAmountType"/>
    <xsd:element name="Subsection93_1_ElectionCurrencyCode"     type="t1134:GlobalCurrencyCodeType"/>
    
    <!-- Part II, Section 1.B - Table ii) -->
    <xsd:element name="CommonSharesInformation"         type="t1134:CommonSharesInformationType"/>
	<xsd:complexType name="CommonSharesInformationType">
        <xsd:sequence>
            <xsd:element ref="t1134:CommonShareHolderSequenceNumber"/>
			<xsd:element ref="t1134:CommonShareHolderAccountNumber"/>
            <xsd:element ref="t1134:CommonShareOwnershipPercentage"/>
            <xsd:element ref="t1134:CommonShareAdjustedCostBase"/>
            <xsd:element ref="t1134:CommonShareAdjustedCostBaseIncreaseIndicator"/>
            <xsd:element ref="t1134:CommonShareAdjustedCostBaseDecreaseIndicator"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="CommonShareHolderSequenceNumber"					type="xsd:int"/>
	<xsd:element name="CommonShareHolderAccountNumber"                  type="t1134:AccountNumberType"/>
    <xsd:element name="CommonShareOwnershipPercentage"                  type="t1134:PercentageType"/>
    <xsd:element name="CommonShareAdjustedCostBase"                     type="t1134:ThousandTrillionAmountType"/>
    <xsd:element name="CommonShareAdjustedCostBaseIncreaseIndicator"    type="t1134:BooleanIndicatorType"/>
    <xsd:element name="CommonShareAdjustedCostBaseDecreaseIndicator"    type="t1134:BooleanIndicatorType"/>

    <!-- Part II, Section 1.B - Table iii) -->
    <xsd:element name="PreferredSharesInformation"      type="t1134:PreferredSharesInformationType"/>
	<xsd:complexType name="PreferredSharesInformationType">
        <xsd:sequence>
			<xsd:element ref="t1134:PreferredShareHolderSequenceNumber"/>
            <xsd:element ref="t1134:PreferredShareHolderAccountNumber"/>
            <xsd:element ref="t1134:PreferredShareOwnershipPercentage"/>
            <xsd:element ref="t1134:PreferredShareAdjustedCostBase"/>
            <xsd:element ref="t1134:PreferredShareAdjustedCostBaseIncreaseIndicator"/>
            <xsd:element ref="t1134:PreferredShareAdjustedCostBaseDecreaseIndicator"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="PreferredShareHolderSequenceNumber"				type="xsd:int"/>
	<xsd:element name="PreferredShareHolderAccountNumber"               type="t1134:AccountNumberType"/>
    <xsd:element name="PreferredShareOwnershipPercentage"               type="t1134:PercentageType"/>
    <xsd:element name="PreferredShareAdjustedCostBase"                  type="t1134:ThousandTrillionAmountType"/>
    <xsd:element name="PreferredShareAdjustedCostBaseIncreaseIndicator" type="t1134:BooleanIndicatorType"/>
    <xsd:element name="PreferredShareAdjustedCostBaseDecreaseIndicator" type="t1134:BooleanIndicatorType"/>

    <!-- Part II, Section 1.B - Table iv) -->
    <xsd:element name="LowestTierCanadianShareholder"       type="t1134:LowestTierCanadianShareholderType"/>
	<xsd:complexType name="LowestTierCanadianShareholderType">
        <xsd:sequence>
            <xsd:element ref="t1134:LowestTierCanadianShareholderName"/>
            <xsd:element ref="t1134:LowestTierCanadianShareholderSequenceNumber"/>
            <xsd:element ref="t1134:LowestTierCanadianShareholderAccountNumber"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="LowestTierCanadianShareholderName"               type="t1134:NameDescription"/>
    <xsd:element name="LowestTierCanadianShareholderSequenceNumber"		type="xsd:int"/>
    <xsd:element name="LowestTierCanadianShareholderAccountNumber"      type="t1134:SelectAccountType"/>

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part II, Section 1.C - Other information of foreign affiliate -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <xsd:element name="ForeignAffiliateOtherInformation" type="t1134:ForeignAffiliateOtherInformationType"/>
	<xsd:complexType name="ForeignAffiliateOtherInformationType">
        <xsd:sequence>
            <xsd:element ref="t1134:ForeignAffiliateOtherInformationAccountSequenceNumber"/>
			<xsd:element ref="t1134:ForeignAffiliateOtherInformationAccountNumber"/>
            <xsd:element ref="t1134:ReportingEntityEquityTaxationYearStartPercentage"/>
            <xsd:element ref="t1134:ReportingEntityEquityTaxationYearEndPercentage"/>
            <xsd:element ref="t1134:QualifyingInterestTaxationYearStartindicator"/>
            <xsd:element ref="t1134:QualifyingInterestTaxationYearEndIndicator"/>
            <xsd:element ref="t1134:GrossDebtReportingEntityOwedToForeignAffiliateIndicator"/>
            <xsd:element ref="t1134:GrossDebtReportingEntityOwedToForeignAffiliateAmount" minOccurs="0"/>
			<xsd:element ref="t1134:GrossDebtForeignAffiliateOwedToReportingEntityIndicator"/>
            <xsd:element ref="t1134:GrossDebtForeignAffiliateOwedToReportingEntityAmount" minOccurs="0"/>
            <xsd:element ref="t1134:GrossDebtForeignAffiliateOwedToReportingEntityElectionMadeIndicator" minOccurs="0"/>
            <xsd:element ref="t1134:ReportingEntityTrackingInterestExistIndicator"/>
            <xsd:element ref="t1134:ReportingEntityTrackingInterestDueTo_95_11_Indicator"/>
            <xsd:element ref="t1134:ReportingEntityTrackingInterestDueTo_95_12_Indicator"/>
            <xsd:element ref="t1134:ReportingEntityAsJointElectionPartyIndicator"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ForeignAffiliateOtherInformationAccountSequenceNumber"		type="xsd:int"/>
	<xsd:element name="ForeignAffiliateOtherInformationAccountNumber"               type="t1134:AccountNumberType"/>
    <xsd:element name="ReportingEntityEquityTaxationYearStartPercentage"            type="t1134:PercentageType"/>
    <xsd:element name="ReportingEntityEquityTaxationYearEndPercentage"              type="t1134:PercentageType"/>
    <xsd:element name="QualifyingInterestTaxationYearStartindicator"                type="t1134:BooleanIndicatorType"/>
    <xsd:element name="QualifyingInterestTaxationYearEndIndicator"                  type="t1134:BooleanIndicatorType"/>
    <xsd:element name="GrossDebtReportingEntityOwedToForeignAffiliateIndicator"     type="t1134:BooleanIndicatorType"/>
    <xsd:element name="GrossDebtReportingEntityOwedToForeignAffiliateAmount"        type="t1134:ThousandTrillionAmountType"/>
	<xsd:element name="GrossDebtForeignAffiliateOwedToReportingEntityIndicator"     type="t1134:BooleanIndicatorType"/>
    <xsd:element name="GrossDebtForeignAffiliateOwedToReportingEntityAmount"        type="t1134:ThousandTrillionAmountType"/>
    <xsd:element name="GrossDebtForeignAffiliateOwedToReportingEntityElectionMadeIndicator" type="t1134:BooleanIndicatorType"/>
    <xsd:element name="ReportingEntityTrackingInterestExistIndicator"               type="t1134:BooleanIndicatorType"/>
    <xsd:element name="ReportingEntityTrackingInterestDueTo_95_11_Indicator"        type="t1134:BooleanIndicatorType"/>
    <xsd:element name="ReportingEntityTrackingInterestDueTo_95_12_Indicator"        type="t1134:BooleanIndicatorType"/>
    <xsd:element name="ReportingEntityAsJointElectionPartyIndicator"                type="t1134:BooleanIndicatorType"/>

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part II, Section 1.D - Foreign affiliate dumping rules -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <xsd:element name="ForeignAffiliateDumpingRules" type="t1134:ForeignAffiliateDumpingRulesType"/>
	<xsd:complexType name="ForeignAffiliateDumpingRulesType">
        <xsd:sequence>
            <xsd:element ref="t1134:ForeignAffiliateDumpingRulesAccountSequenceNumber"/>
			<xsd:element ref="t1134:ForeignAffiliateDumpingRulesAccountNumber"/>
            <xsd:element ref="t1134:Section212_3_Indicator"/>
            <xsd:element ref="t1134:Section212_3_NotApplyDueTo_212_3_10"/>
            <xsd:element ref="t1134:Section212_3_NotApplyDueTo_212_3_16"/>
            <xsd:element ref="t1134:Section212_3_NotApplyDueTo_212_3_18"/>
            <xsd:element ref="t1134:Section212_3_7_d_i_Indicator"/>
            <xsd:element ref="t1134:Section212_3_7_d_ii_Indicator"/>
            <xsd:element ref="t1134:Section212_3_9_Indicator"/>
            <xsd:element ref="t1134:Section212_3_19_Indicator"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ForeignAffiliateDumpingRulesAccountSequenceNumber"	type="xsd:int"/>
	<xsd:element name="ForeignAffiliateDumpingRulesAccountNumber"   type="t1134:AccountNumberType"/>
    <xsd:element name="Section212_3_Indicator"                      type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section212_3_NotApplyDueTo_212_3_10"         type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section212_3_NotApplyDueTo_212_3_16"         type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section212_3_NotApplyDueTo_212_3_18"         type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section212_3_7_d_i_Indicator"                type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section212_3_7_d_ii_Indicator"               type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section212_3_9_Indicator"                    type="t1134:BooleanIndicatorType"/>
    <xsd:element name="Section212_3_19_Indicator"                   type="t1134:BooleanIndicatorType"/>


    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part II, Section 2 - Financial formation of foreign affiliate -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <xsd:element name="ForeignAffiliateFinancialInformation" type="t1134:ForeignAffiliateFinancialInformationType"/>
    <xsd:complexType name="ForeignAffiliateFinancialInformationType">
        <xsd:sequence>
            <xsd:element ref="t1134:ForeignAffiliateTaxationYear"/>
            <xsd:element ref="t1134:VotingShareOwedByReportingEntityIndicator"/>
            <xsd:element ref="t1134:UnconsolidatedFinancialStatementAvailableIndicator" minOccurs="0"/>
            <xsd:element ref="t1134:UnconsolidatedFinancialStatementAttachedIndicator"  minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ForeignAffiliateTaxationYear"                        type="t1134:ForeignAffiliateTaxationYearType"/>
    <xsd:element name="VotingShareOwedByReportingEntityIndicator"           type="t1134:BooleanIndicatorType"/>
    <xsd:element name="UnconsolidatedFinancialStatementAvailableIndicator"  type="t1134:BooleanIndicatorType"/>
    <xsd:element name="UnconsolidatedFinancialStatementAttachedIndicator"   type="t1134:BooleanIndicatorType"/>
    
    <!-- Foreign Affiliate Taxation Year Start End Dates -->
    <xsd:complexType name="ForeignAffiliateTaxationYearType">
        <xsd:sequence>
            <xsd:element ref="t1134:ForeignAffiliateTaxationYearStartDate"/>
            <xsd:element ref="t1134:ForeignAffiliateTaxationYearEndDate"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ForeignAffiliateTaxationYearStartDate"   type="sdt:DateType"/>
    <xsd:element name="ForeignAffiliateTaxationYearEndDate"     type="sdt:DateType"/>
    
    

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part II, Section 3.A - Surplus accounts of foreign affiliates -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <xsd:element name="ForeignAffiliateSurplusAccount" type="t1134:ForeignAffiliateSurplusAccountType">
		<xsd:unique name="ExemptSurplusAccountUnique">
			<xsd:selector xpath="t1134:ExemptSurplus/t1134:ExemptSurplusAccount"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="HybridSurplusAccountUnique">
			<xsd:selector xpath="t1134:HybridSurplus/t1134:HybridSurplusAccount"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="TaxableSurplusAccountUnique">
			<xsd:selector xpath="t1134:TaxableSurplus/t1134:TaxableSurplusAccount"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="PreAcquisitionSurplusAccountUnique">
			<xsd:selector xpath="t1134:PreAcquisitionSurplus/t1134:PreAcquisitionSurplusAccount"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="SurplusAccountNumbersUnique">
			<xsd:selector xpath="t1134:UpstreamLoanRules/t1134:SurplusAccountNumbers"/>
			<xsd:field xpath="."/>
		</xsd:unique>
	</xsd:element>
    <xsd:complexType name="ForeignAffiliateSurplusAccountType">
        <xsd:sequence>
            <xsd:element ref="t1134:ReportingEntityDividendReceivedIndicator"/>
            <xsd:element ref="t1134:ExemptSurplus"              minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:HybridSurplus"              minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:TaxableSurplus"             minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:PreAcquisitionSurplus"      minOccurs="0" maxOccurs="1500"/>
            <xsd:element ref="t1134:ForeignAffiliateDividendPaidAmount"       minOccurs="0"/>
            <xsd:element ref="t1134:TransactionRegardingSubsection93_1_Indicator"/>
            <xsd:element ref="t1134:UpstreamLoanRules"          maxOccurs="1500"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ReportingEntityDividendReceivedIndicator"        type="t1134:BooleanIndicatorType"/>
    <xsd:element name="ExemptSurplus"                                   type="t1134:ExemptSurplusType"/>
	<xsd:element name="HybridSurplus"                                   type="t1134:HybridSurplusType"/>
	<xsd:element name="TaxableSurplus"                                  type="t1134:TaxableSurplusType"/>
	<xsd:element name="PreAcquisitionSurplus"                           type="t1134:PreAcquisitionSurplusType"/>
	<xsd:element name="ForeignAffiliateDividendPaidAmount"              type="t1134:ForeignAffiliateDividendPaidAmountType"/>
	<xsd:element name="TransactionRegardingSubsection93_1_Indicator"    type="t1134:BooleanIndicatorType"/>
    <xsd:element name="UpstreamLoanRules"                               type="t1134:UpstreamLoanRulesType"/>
	
    <xsd:complexType name="ExemptSurplusType">
        <xsd:sequence>
            <xsd:element name="ExemptSurplusAmount"     				type="t1134:ThousandTrillionAmountType"/>
			<xsd:element name="ExemptSurplusAccountSequenceNumber"    	type="xsd:int"/>
            <xsd:element name="ExemptSurplusAccount"    				type="t1134:AccountNumberType"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="HybridSurplusType">
        <xsd:sequence>
            <xsd:element name="HybridSurplusAmount"     				type="t1134:ThousandTrillionAmountType"/>
			<xsd:element name="HybridSurplusAccountSequenceNumber"    	type="xsd:int"/>
            <xsd:element name="HybridSurplusAccount"    				type="t1134:AccountNumberType"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="TaxableSurplusType">
        <xsd:sequence>
            <xsd:element name="TaxableSurplusAmount"                                type="t1134:ThousandTrillionAmountType"/>
			<xsd:element name="TaxableSurplusAccountSequenceNumber"                 type="xsd:int"/>
            <xsd:element name="TaxableSurplusAccount"                               type="t1134:AccountNumberType"/>
            <xsd:element name="ElectionMadePursuantRegulation5900_2_Indicator"      type="t1134:BooleanIndicatorType"/>
            <xsd:element name="ElectionMadePursuantRegulation5901_1_1_Indicator"    type="t1134:BooleanIndicatorType"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="PreAcquisitionSurplusType">
        <xsd:sequence>
            <xsd:element name="PreAcquisitionSurplusAmount"                         type="t1134:ThousandTrillionAmountType"/>
			<xsd:element name="PreAcquisitionSurplusAccountSequenceNumber"          type="xsd:int"/>
            <xsd:element name="PreAcquisitionSurplusAccount"                        type="t1134:AccountNumberType"/>
            <xsd:element name="ElectionMadePursuantRegulation5901_2_b_Indicator"    type="t1134:BooleanIndicatorType"/>
            <xsd:element name="ElectionMadePursuantRegulation5901_2_1_Indicator"    type="t1134:BooleanIndicatorType"/>
            <xsd:element name="QROCElectionMadePursuantSubsection90_3_Indicator"    type="t1134:BooleanIndicatorType"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ForeignAffiliateDividendPaidAmountType">
        <xsd:sequence>
            <xsd:element name="DividendInCash"              type="t1134:ThousandTrillionAmountType"/>
            <xsd:element name="DividendInCashCurrencyCode"  type="t1134:GlobalCurrencyCodeType"/>
            <xsd:element name="DividendInStock"             type="t1134:ThousandTrillionAmountType"/>
            <xsd:element name="DividendInStockCurrencyCode" type="t1134:GlobalCurrencyCodeType"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="UpstreamLoanRulesType">
        <xsd:sequence>
            <xsd:element name="SurplusAccountSequenceNumber"        type="xsd:int"/>
			<xsd:element name="SurplusAccountNumbers"               type="t1134:AccountNumberType"/>
            <xsd:element name="SpecifiedDebtorIndicator"            type="t1134:BooleanIndicatorType"/>
            <xsd:element name="Subsection90_6_ApplyIndicator"       type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="Subsection90_8_ApplyIndicator"       type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="EligibleBankAffiliateIndicator"      type="t1134:BooleanIndicatorType"/>
            <xsd:element name="LoanToReportingEntityIndicator"      type="t1134:BooleanIndicatorType"   minOccurs="0"/>
            <xsd:element name="DeductionClaimedIndicator"           type="t1134:BooleanIndicatorType"/>
            <xsd:element name="IncomeInclusionRequiredIndicator"    type="t1134:BooleanIndicatorType"/>
        </xsd:sequence>
    </xsd:complexType>

    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Part II, Section 3.B - Surplus accounts and share transactions of controlled foreign affiliates -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <xsd:element name="ControlledForeignAffiliateSurplusAccountShareTransaction" type="t1134:ControlledForeignAffiliateSurplusAccountShareTransactionType">
		<xsd:unique name="InvolvedEntityNumberUnique">
			<xsd:selector xpath="t1134:ReportingEntityTransaction/t1134:TransactionInvolvedEntity/t1134:InvolvedEntityNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="ForeignAffiliateTransactionInvolvedEntityNumberUnique">
			<xsd:selector xpath="t1134:ForeignAffiliateTransaction/t1134:ForeignAffiliateTransactionInvolvedEntity/t1134:ReportingEntityNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="EquityAndSurplusEntitlementChangeAccountUnique">
			<xsd:selector xpath="t1134:EquityAndSurplusEntitlementChange/t1134:EquityAndSurplusEntitlementChangeAccount"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="OtherTransactionInvolvedEntityNumberUnique">
			<xsd:selector xpath="t1134:OtherTransactionInvolvedEntityList/t1134:ReportingEntityNumber"/>
			<xsd:field xpath="."/>
		</xsd:unique>
	</xsd:element>
	<xsd:complexType name="ControlledForeignAffiliateSurplusAccountShareTransactionType">
        <xsd:sequence>
            <xsd:element ref="t1134:ReportingEntityTransaction"/>
            <xsd:element ref="t1134:ForeignAffiliateTransaction"/>
            <xsd:element ref="t1134:EquityAndSurplusEntitlementChange"      maxOccurs="1500"/>
            <xsd:element ref="t1134:ExcludedPropertyIndicator"/>
            <xsd:element ref="t1134:NotExcludedPropertyIndicator"/>
            <xsd:element ref="t1134:OtherTransactionInvolvedIndicator"/>
            <xsd:element ref="t1134:OtherTransactionInvolvedEntityList"	minOccurs="0" maxOccurs="1500"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="ReportingEntityTransaction"          type="t1134:ReportingEntityTransactionType"/>
    <xsd:element name="ForeignAffiliateTransaction"         type="t1134:ForeignAffiliateTransactionType"/>
    <xsd:element name="EquityAndSurplusEntitlementChange"   type="t1134:EquityAndSurplusEntitlementChangeType"/>
	<xsd:element name="ExcludedPropertyIndicator"           type="t1134:BooleanIndicatorType"/>
    <xsd:element name="NotExcludedPropertyIndicator"        type="t1134:BooleanIndicatorType"/>
    <xsd:element name="OtherTransactionInvolvedIndicator"   type="t1134:BooleanIndicatorType"/>
    <xsd:element name="OtherTransactionInvolvedEntityList"  type="t1134:ReportingEntityAccountType"/>
	
    <xsd:complexType name="ReportingEntityTransactionType">
        <xsd:sequence>
            <xsd:element ref="t1134:InvolveSubsection88_3_TransactionIndicator"/>
            <xsd:element ref="t1134:Subsection88_3_ElectionMadeIndicator" minOccurs="0"/>
            <xsd:element ref="t1134:InvolveSection51_TransactionIndicator"/>
            <xsd:element ref="t1134:TransactionInvolvedEntity" minOccurs="0" maxOccurs="1500"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="InvolveSubsection88_3_TransactionIndicator"  type="t1134:BooleanIndicatorType"/>
