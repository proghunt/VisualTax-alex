    <xsd:complexType name="CountryType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en"/>
            <xsd:documentation xml:lang="fr"/>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="t1134:CountryCode" maxOccurs="4"/>
