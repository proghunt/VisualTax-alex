            <xsd:documentation xml:lang="en">Ends with "F"/"f" for T1 Efile; "G"/"g" for T1 Netfile; "K"/"k" for T1135 via Efile; "M"/"m" for T1135 via Netfile; "Y"/"y" for T1134 via Efile; "W"/"w" for T1134 via Netfile</xsd:documentation>
            <xsd:documentation xml:lang="fr">Se termine avec un (F) ou (f) pour TED T1; avec un (G) ou (g) pour Impôtnet; (K) ou (k) pour T1135 via TED; (M) ou (m) pour T1135 via Impôtnet; (Y) ou (y) pour T1134 via TED; (W) ou (w) pour T1134 via Impôtnet.</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
            <xsd:restriction base="sdt:IDType">
                <xsd:minLength value="4"/>
				<xsd:maxLength value="5"/>
	            <xsd:pattern value="[0-9]{3}[A-Za-z]|[0-9]{3}[A-Za-z]{2}"/>
			</xsd:restriction>
        </xsd:simpleType>
    </xsd:element>
    
    <xsd:element name="SoftwareRevisionDate" type="sdt:DateType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Format is YYYY-MM-DD</xsd:documentation>
            <xsd:documentation xml:lang="fr">Le format est AAAA-MM-JJ</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
	
	<xsd:simpleType name="AccountNumberType">
        <xsd:restriction base="sdt:NumberType">
                <xsd:minLength value="9"/>
                <xsd:maxLength value="15"/>
                <xsd:whiteSpace value="collapse"/>
        </xsd:restriction>
    </xsd:simpleType>
	
	<xsd:complexType name="SelectAccountType">
        <xsd:choice>
            <xsd:element name="AccountBusinessNumber"           type="t1134:BNRCType"/>
            <xsd:element name="AccountSocialInsuranceNumber"    type="ccms:SINType"/>
            <xsd:element name="AccountTrustNumber"              type="ccms:TrustNumberType"/>
            <xsd:element name="AccountPartnershipNumber"        type="t1134:BNRZType"/>
        </xsd:choice>
    </xsd:complexType>
	
	<xsd:simpleType name="GroupReportingEntitySequenceNumberType">
		<xsd:restriction base="xsd:int">
            <xsd:minInclusive value="2"/>
        </xsd:restriction>
	</xsd:simpleType>
	
    <xsd:simpleType name="SupplementSequenceIdentifierType">
        <xsd:restriction base="sdt:IDType">
            <xsd:pattern value="[1-9]([0-9])*"/>
            <xsd:minLength value="1"/>
            <xsd:maxLength value="4"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="ActionCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Valid Codes are: 1=new; 2=unmodified; 3=amended; 4=delete</xsd:documentation>
            <xsd:documentation xml:lang="fr">Les codes valides sont: 1=nouveau; 2=non modifié; 3=modifié; 4=détruit  </xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:CodeType">
            <xsd:enumeration value="1"/>
            <xsd:enumeration value="2"/>
            <xsd:enumeration value="3"/>
            <xsd:enumeration value="4"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="SupplementDeleteReasonCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Valid Codes are: 1=duplicate; 2=filed in error; 3=other</xsd:documentation>
            <xsd:documentation xml:lang="fr"/>
        </xsd:annotation>
        <xsd:restriction base="sdt:CodeType">
            <xsd:enumeration value="1"/>
            <xsd:enumeration value="2"/>
            <xsd:enumeration value="3"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="OrganizationalStructureClientCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Valid Codes are: 1=Corporation; 2=Individual; 3=Trust; 4=Partnership</xsd:documentation>
            <xsd:documentation xml:lang="fr"/>
        </xsd:annotation>
        <xsd:restriction base="sdt:CodeType">
            <xsd:enumeration value="1"/>
            <xsd:enumeration value="2"/>
            <xsd:enumeration value="3"/>
            <xsd:enumeration value="4"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType  name="BooleanIndicatorType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en"> Value "1" (Yes); Value "0" (No)</xsd:documentation>
            <xsd:documentation xml:lang="fr"> - Valeur "1" (Oui); Valeur "0" (Non)</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:IndicatorType"/>
    </xsd:simpleType>

    <xsd:simpleType name="EmployeeCountCodeType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Employee count code: 0-None; 1-One to five; 2-Six to fifteen; 3-Sixteen to twenty five; 4-twenty six to one hundred; 5-more than one hundred.</xsd:documentation>
            <xsd:documentation xml:lang="fr"></xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:CodeType">
                <xsd:length value="1"/>
                <xsd:enumeration value="0"/>
                <xsd:enumeration value="1"/>
                <xsd:enumeration value="2"/>
                <xsd:enumeration value="3"/>
                <xsd:enumeration value="4"/>
                <xsd:enumeration value="5"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="GlobalProvinceTerritoryStateCode">
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="20"/>
                <xsd:pattern value="([A-Za-z])*"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <xsd:element name="GlobalAddress" type="t1134:NameDescription"/>

    <xsd:element name="GlobalPostalZipCode">
        <xsd:simpleType>
            <xsd:restriction base="sdt:CodeType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="20"/>
                <xsd:pattern value="([A-Za-z0-9\-])*"/>
            </xsd:restriction>
        </xsd:simpleType>
    </xsd:element>

    <xsd:complexType name="NameThirtyCharacterType">
        <xsd:simpleContent>
            <xsd:restriction base="sdt:NameType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="30"/>
                <xsd:whiteSpace value="collapse"/>
            </xsd:restriction>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:complexType name="NameDescription">
        <xsd:simpleContent>
            <xsd:restriction base="sdt:NameType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="255"/>
                <xsd:whiteSpace value="collapse"/>
            </xsd:restriction>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:simpleType name="ThousandTrillionAmountType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">The field is used to capture the dollar amount (no decimals).  The dollar value cannot exceed +/- $999,999,999,999,999. </xsd:documentation>
            <xsd:documentation xml:lang="fr">Le champ est utilisé pour capturer le montant en dollar (pas de décimales). La valeur en dollar ne peut pas dépasser +/- 999.999.999.999.999 $.</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="sdt:AmountDollarsOnlyType">
            <xsd:minInclusive value="0"/>
            <xsd:maxInclusive value="999999999999999"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="PhoneNumberType">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">To capture any North American or International phone number with (possible) extension.</xsd:documentation>
            <xsd:documentation xml:lang="fr">Pour capturer tout numéro de téléphone nord-américain ou international avec (possible) l'extension.</xsd:documentation>
        </xsd:annotation>
        <xsd:restriction base="xsd:token">
            <xsd:pattern value="([0-9xX\(\)\-\.])*"/>
            <xsd:minLength value="1"/>
            <xsd:maxLength value="24"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="BusinessNumber" type="t1134:BNRCType"/>
    <xsd:simpleType name="BNRCType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([0-9]{9}RC[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="PartnershipNumber" type="t1134:BNRZType"/>
    <xsd:simpleType name="BNRZType">
        <xsd:restriction base="sdt:NumberType">
            <xsd:pattern value="([0-9]{9}RZ[0-9]{4})"/>
        </xsd:restriction>
    </xsd:simpleType>
    

    <xsd:simpleType name ="PercentageType">
        <xsd:restriction base="sdt:PercentType">
            <xsd:fractionDigits value="2"/>
            <xsd:minInclusive value="000.00"/>
            <xsd:maxInclusive value="100.00"/>
        </xsd:restriction>
    </xsd:simpleType>

	<xsd:complexType name="TextTwoType">
        <xsd:simpleContent>
            <xsd:restriction base="sdt:TextType">
                <xsd:minLength value="1"/>
                <xsd:maxLength value="2"/>
                <xsd:whiteSpace value="collapse"/>
            </xsd:restriction>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:complexType name="TextFifteenType">
