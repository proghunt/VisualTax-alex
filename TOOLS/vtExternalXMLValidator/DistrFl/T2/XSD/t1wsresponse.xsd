<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
Description: CRA T1 Web Services project
Type (Request or Response): Response
Version: 1-0-0
Date created:
Contact:
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
xmlns:t1rsp="http://www.cra-arc.gc.ca/xmlns/t1rsp/response/1-0-0"
xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0"
targetNamespace="http://www.cra-arc.gc.ca/xmlns/t1rsp/response/1-0-0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="t1rsp/1-0-0">
    <xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-2-0" schemaLocation="standarddatatypes.xsd"/>

    <xsd:element name="TermsAndConditionsResponse" type="t1rsp:TermsAndConditionsResponseType"/>
    <xsd:complexType name="TermsAndConditionsResponseType">
        <xsd:choice>
            <xsd:element ref="t1rsp:TermsAndConditions" minOccurs="0"/>
            <xsd:element ref="t1rsp:SystemError" minOccurs="0"/>
        </xsd:choice>
    </xsd:complexType>

    <xsd:element name="NetfileReturnResponse" type="t1rsp:NetfileReturnResponseType"/>
    <xsd:complexType name="NetfileReturnResponseType">
        <xsd:sequence>
            <xsd:element ref="t1rsp:ResultCode" minOccurs="0"/>
            <xsd:element ref="t1rsp:FileReturnResponse"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="FileReturnResponse" type="t1rsp:FileReturnResponseType"/>
    <xsd:complexType name="FileReturnResponseType">
        <xsd:choice>
            <xsd:element ref="t1rsp:Confirmation" minOccurs="0"/>
            <xsd:element ref="t1rsp:ProcessingError" minOccurs="0"/>
            <xsd:element ref="t1rsp:Rejection" minOccurs="0"/>
            <xsd:element ref="t1rsp:SystemError" minOccurs="0"/>
        </xsd:choice>
    </xsd:complexType>

	<xsd:element name="ResultCode" type="t1rsp:ResultCodeType" />
    <xsd:simpleType name="ResultCodeType" >
        <xsd:restriction base="xsd:string">
            <xsd:length value="6"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:element name="Confirmation" type="t1rsp:ConfirmationType"/>
    <xsd:complexType name="ConfirmationType">
        <xsd:sequence>
            <xsd:element ref="t1rsp:ConfirmationCode" minOccurs="0"/>
            <xsd:element ref="t1rsp:EnglishMessage" minOccurs="0"/>
            <xsd:element ref="t1rsp:FrenchMessage" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ProcessingError" type="t1rsp:ProcessingErrorType"/>
    <xsd:complexType name="ProcessingErrorType">
    	<xsd:sequence>
    		<xsd:element ref="t1rsp:EnglishMessage" minOccurs="0"/>
            <xsd:element ref="t1rsp:FrenchMessage" minOccurs="0"/>
        	<xsd:element ref="t1rsp:ErrorCodeDescription" minOccurs="0" maxOccurs="16"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="ErrorCodeDescription" type="t1rsp:ErrorCodeDescriptionType"/>
    <xsd:complexType name="ErrorCodeDescriptionType">
        <xsd:sequence>
            <xsd:element ref="t1rsp:ErrorCode" minOccurs="0" />
            <xsd:element ref="t1rsp:EnglishMessage" minOccurs="0"/>
            <xsd:element ref="t1rsp:FrenchMessage" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="TermsAndConditions" type="t1rsp:GenericResponseType"/>
    <xsd:element name="Rejection" type="t1rsp:GenericResponseType"/>
    <xsd:element name="SystemError" type="t1rsp:GenericResponseType"/>
    <xsd:complexType name="GenericResponseType">
        <xsd:sequence>
            <xsd:element ref="t1rsp:EnglishMessage" minOccurs="0"/>
            <xsd:element ref="t1rsp:FrenchMessage" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="MultiparagraphMessageType">
        <xsd:sequence>
            <xsd:element name="MessageText" type="sdt:TokenMessageType" maxOccurs="unbounded"/>
            <xsd:element name="Hyperlink" type="t1rsp:HyperlinkType" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="HyperlinkType">
    	<xsd:sequence>
      		<xsd:element ref="t1rsp:HyperlinkText" minOccurs="0"/>
        	<xsd:element ref="t1rsp:HyperlinkTarget" minOccurs="0"/>
   		</xsd:sequence>
   	</xsd:complexType>

    <xsd:element name="HyperlinkText" type="sdt:TokenMessageType"/>
	<xsd:element name="HyperlinkTarget" type="sdt:URIType"/>

	<xsd:element name="ConfirmationCode" type="sdt:CodeType"/>
	<xsd:element name="ErrorCode" type="sdt:CodeType" />
	<xsd:element name="EnglishMessage" type="t1rsp:MultiparagraphMessageType"/>
	<xsd:element name="FrenchMessage" type="t1rsp:MultiparagraphMessageType"/>

</xsd:schema>
